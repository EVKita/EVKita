# File ini hanya contoh. Jangan isi kredensial asli di sini — file .env yang
# sebenarnya dibuat otomatis oleh wizard di /install (dan tidak ikut ke Git).

# Diisi oleh wizard instalasi. Biarkan kosong.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=

# Port & host server. HOST=127.0.0.1 berarti aplikasi hanya bisa diakses
# lewat reverse proxy (disarankan). Isi 0.0.0.0 kalau memang ingin diakses
# langsung dari internet lewat port ini.
PORT=4321
HOST=127.0.0.1

# Repositori GitHub untuk halaman Pembaruan (format: owner/repo)
GITHUB_REPO=EVKita/EVKita
