# File ini hanya contoh. Jangan isi kredensial asli di sini — file .env yang
# sebenarnya dibuat otomatis oleh wizard di /install (dan tidak ikut ke Git).

# Akun admin TIDAK lagi disimpan di sini. Wizard di /install membuat akun
# pertama di data/users.json dengan kata sandi ter-hash, dan pengguna
# berikutnya ditambahkan lewat Admin -> Pengguna.
#
# ADMIN_USERNAME dan ADMIN_PASSWORD hanya masih dibaca sekali, untuk memindahkan
# pemasangan lama ke data/users.json. Setelah berkas itu ada, keduanya diabaikan.

# Diisi oleh wizard instalasi. Biarkan kosong.
SESSION_SECRET=

# Port & host server. HOST=127.0.0.1 berarti aplikasi hanya bisa diakses
# lewat reverse proxy (disarankan). Isi 0.0.0.0 kalau memang ingin diakses
# langsung dari internet lewat port ini.
PORT=4321
HOST=127.0.0.1

# Repositori GitHub untuk halaman Pembaruan (format: owner/repo)
GITHUB_REPO=EVKita/EVKita

# Kunci API DeepSeek untuk fitur riset AI. JANGAN diisi manual di sini —
# masukkan lewat panel: Admin -> AI. Panel mengujinya ke DeepSeek lebih dulu,
# baru menyimpannya, dan mengunci izin .env jadi 0600.
DEEPSEEK_API_KEY=

# Pengaturan SMTP untuk formulir kontak di footer. JANGAN diisi manual di sini —
# masukkan lewat panel: Admin -> Kontak. Kata sandi tidak pernah dikirim kembali
# ke panel. Port 587 untuk STARTTLS, 465 untuk SSL/TLS langsung.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=
