{
  "name": "evkita",
  "type": "module",
  "version": "1.0.144",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node tools/i18n-check.mjs && astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "i18n:check": "node tools/i18n-check.mjs",
    "test": "node --import ./tools/ts-resolver.mjs --test \"tests/**/*.test.ts\"",
    "check": "npm run i18n:check && npm test",
    "update:paksa": "node --import ./tools/ts-resolver.mjs tools/force-update.mjs",
    "update:berita": "node --import ./tools/ts-resolver.mjs tools/force-update.mjs berita",
    "update:artikel": "node --import ./tools/ts-resolver.mjs tools/force-update.mjs artikel",
    "update:katalog": "node --import ./tools/ts-resolver.mjs tools/force-update.mjs katalog"
  },
  "dependencies": {
    "@astrojs/node": "^9.1.0",
    "astro": "^5.7.0",
    "maxmind": "^5.0.7",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@types/node": "^26.3.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
