---
import "../styles/global.css";
import { alternateLangUrls, canonicalUrl } from "../lib/site-url";
import { themeAccentStyle, themeStyle, themeBodyClass, themeExtraCss, themeFontHref, themeMode } from "../lib/theme.js";
import { makePubT, cms, pubOgLocale } from "../lib/i18n/pub.js";
import TagGoogle from "../components/TagGoogle.astro";
import ContentGate from "../components/ContentGate.astro";
import MemberGate from "../components/MemberGate.astro";
import SiteSearch from "../components/SiteSearch.astro";

interface Props {
  title?: string;
  description?: string;
  /**
   * Objek `site` dari `content.json`, apa adanya. Seluruh setelan menu
   * Tampilan dibaca dari sini lewat `src/lib/theme.js`. Opsional: halaman
   * admin dan /install memakai layout ini tanpa tema sama sekali, jadi semua
   * nilainya harus punya bawaan yang aman.
   */
  site?: Record<string, any>;
  /** Halaman panel hanya butuh warna aksennya, bukan seluruh tampilan situs. */
  accentOnly?: boolean;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  bodyClass?: string;
  /** Kode bahasa untuk atribut <html lang>. Panel admin mengirim bahasa
      pilihan penggunanya; situs publik mengikuti pilihan bendera. */
  lang?: string;
  /**
   * Halaman yang tidak boleh masuk hasil pencarian: panel admin dan wizard
   * pemasangan. Selain tidak ada gunanya diindeks, keduanya justru mengundang
   * persis lalu lintas otomatis yang paling tidak diinginkan di halaman masuk.
   */
  noindex?: boolean;
}

/**
 * Kanonis dihitung dari permintaan yang sedang berjalan, bukan dari nilai yang
 * dipatok saat build: situs ini dipasang sendiri di domain mana pun.
 */

const {
  title = "EVKita",
  description = "Basis data mobil listrik yang dijual di Indonesia: spesifikasi, jarak tempuh, baterai, tenaga, dan harga.",
  site,
  accentOnly = false,
  keywords = "",
  ogImage = "",
  ogType = "website",
  bodyClass = "",
  lang = Astro.locals?.pubLang || "id",
  noindex = false,
} = Astro.props;

const canonical = canonicalUrl(Astro.url);

/**
 * URL tiap versi bahasa untuk tag `hreflang`. Indonesia adalah bawaan tanpa
 * parameter (`x-default` ikut menunjuk ke sana); Inggris dan Mandarin punya
 * `?lang=`-nya masing-masing supaya bisa dirayapi dan diindeks terpisah oleh
 * Google, Bing, dan Baidu.
 */
const alternates = alternateLangUrls(Astro.url);
const ogAlternate = lang === "en" ? ["id_ID", "zh_CN"] : lang === "zh" ? ["id_ID", "en_US"] : ["en_US", "zh_CN"];

/**
 * Deskripsi meta. Nilai yang dikirim pemanggil diterjemahkan dulu (banyak
 * halaman mengirim kalimat buatan sendiri), dan kalau tidak ada sama sekali
 * jatuh ke deskripsi bawaan lewat kamus — bukan ke literal Bahasa Indonesia.
 */
const metaDesc = cms(description, lang) || makePubT(lang)("pub.base.desc");

/*
 * Halaman panel (login, pembaruan) hanya mengambil warna aksennya supaya
 * identitas situs tetap terasa, tanpa ikut memakai pola latar, huruf judul,
 * atau gaya kartu yang dirancang untuk situs publik.
 */
const bodyStyle = site ? (accentOnly ? themeAccentStyle(site) : themeStyle(site)) : undefined;
const themeClass = site && !accentOnly ? themeBodyClass(site) : "";
const extraCss = site && !accentOnly ? themeExtraCss(site) : "";
const fontHref = themeFontHref(site && !accentOnly ? site : {});
const mode = site && !accentOnly ? themeMode(site) : "auto";
const bodyClasses = [bodyClass, themeClass].filter(Boolean).join(" ");

/*
 * Tag Google (Analytics, AdSense, Search Console) hanya untuk halaman publik.
 *
 * Penandanya `site` tanpa `accentOnly`: halaman panel memakai layout ini juga,
 * tapi ia hanya meminjam warna aksennya (`accentOnly`), dan wizard pemasangan
 * tidak mengirim `site` sama sekali. Dengan begitu tidak ada satu pun halaman
 * di balik login yang memuat skrip pihak ketiga — termasuk halaman masuk, yang
 * justru paling tidak pantas mengirimkan alamatnya ke mana-mana.
 */
const tagPublik = !!site && !accentOnly;
---
<!DOCTYPE html>
<html lang={lang} data-theme-mode={mode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="theme-color" content="#f6f7fa" id="metaThemeColor" />
    <script is:inline>
      // Sengaja diletakkan sebelum <link rel="stylesheet"> font: skrip inline
      // tertahan menunggu stylesheet yang mendahuluinya selesai dimuat, dan
      // di koneksi lambat itu berarti tema gelap sempat berkedip terang.
      // Dijalankan sebelum render supaya tema tidak berkedip. Tema gelap
      // ditandai dengan atribut data-theme="dark" di <html>; ketiadaan
      // atribut berarti terang.
      (function () {
        var KEY = "evkita-theme";
        var el = document.documentElement;

        // Animasi masuk (.reveal) menyembunyikan konten lewat CSS dan baru
        // memunculkannya dari JavaScript. Kalau berkas skripnya gagal dimuat,
        // seluruh isi halaman ikut tak terlihat — padahal HTML-nya sudah utuh
        // dari server. Karena itu penyembunyiannya baru berlaku setelah kelas
        // ini terpasang, dan ada jaring pengaman yang membuka paksa apa pun
        // yang masih tersembunyi beberapa saat setelah halaman selesai dimuat.
        el.classList.add("js");
        window.addEventListener("load", function () {
          setTimeout(function () {
            var sisa = document.querySelectorAll(".reveal:not(.in)");
            for (var i = 0; i < sisa.length; i++) sisa[i].classList.add("in");
          }, 2000);
        });

        function apply(mode) {
          if (mode === "dark") {
            el.setAttribute("data-theme", "dark");
          } else {
            el.removeAttribute("data-theme");
          }
          var meta = document.getElementById("metaThemeColor");
          if (meta) meta.setAttribute("content", mode === "dark" ? "#0e1116" : "#f6f7fa");
        }

        var stored = null;
        try {
          stored = localStorage.getItem(KEY);
        } catch (e) {}

        // Pemilik situs bisa mengunci tema lewat panel admin (themeMode).
        // Pilihan pembaca tetap menang supaya tombol tema tidak terasa rusak.
        var forced = el.getAttribute("data-theme-mode");
        var locked = forced === "light" || forced === "dark";

        var mq = window.matchMedia("(prefers-color-scheme: dark)");
        apply(stored || (locked ? forced : mq.matches ? "dark" : "light"));

        // Selama pembaca belum memilih sendiri, ikuti setelan sistem kalau
        // setelan itu berubah saat halaman terbuka.
        var onSystemChange = function (e) {
          var picked = null;
          try {
            picked = localStorage.getItem(KEY);
          } catch (err) {}
          if (!picked && !locked) apply(e.matches ? "dark" : "light");
        };
        if (mq.addEventListener) mq.addEventListener("change", onSystemChange);
        else if (mq.addListener) mq.addListener(onSystemChange);

        // Delegasi klik: tombol bisa ada di halaman mana pun, dan skrip ini
        // berjalan di <head> saat tombolnya belum ada di DOM.
        document.addEventListener("click", function (e) {
          var btn = e.target && e.target.closest && e.target.closest("#themeToggle");
          if (!btn) return;
          var next = el.getAttribute("data-theme") === "dark" ? "light" : "dark";
          apply(next);
          try {
            localStorage.setItem(KEY, next);
          } catch (err) {}
        });
      })();
    </script>
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="id" href={alternates.id} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="zh" href={alternates.zh} />
    <link rel="alternate" hreflang="x-default" href={alternates.id} />
    <meta name="description" content={metaDesc} />
    {keywords ? <meta name="keywords" content={keywords} /> : null}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={pubOgLocale(lang)} />
    {ogAlternate.map((loc) => <meta property="og:locale:alternate" content={loc} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDesc} />
    {ogImage ? <meta property="og:image" content={ogImage} /> : null}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/*
      Stylesheet font dimuat tanpa memblokir render. Sebagai <link rel="stylesheet">
      biasa, halaman baru boleh tampil setelah perjalanan bolak-balik ke
      fonts.googleapis.com selesai — di jaringan seluler itu ratusan milidetik
      layar kosong. Karena URL-nya sudah memakai `display=swap`, teks memang
      tampil dengan font cadangan lebih dulu, jadi tidak ada yang hilang.
    */}
    <link rel="preload" as="style" href={fontHref} />
    <link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontHref} /></noscript>
    {/*
      Font CJK hanya untuk pembaca Mandarin: mengunduh Noto Sans SC di setiap
      bahasa hanya menambah bobot tanpa guna, dan huruf Latin di kamus zh
      tetap tertutup font tema di atas.

      Sengaja non-pemblokir seperti font tema: fonts.googleapis.com diblokir di
      Tiongkok, dan sebagai stylesheet biasa ia menahan render sampai koneksinya
      habis waktu. Kalau gagal dimuat, tumpukan PingFang SC / Microsoft YaHei
      di global.css yang mengambil alih — halaman tetap Mandarin dan rapi.
    */}
    {lang === "zh" ? (
      <>
        <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&display=swap" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&display=swap" media="print" onload="this.media='all'" />
      </>
    ) : null}
    {extraCss ? <style is:inline set:html={extraCss}></style> : null}
    {tagPublik && <TagGoogle />}
    <slot name="head" />
  </head>
  <body style={bodyStyle} class={bodyClasses}>
    <slot />
    {tagPublik && <ContentGate site={site} lang={lang} />}
    {tagPublik && <MemberGate lang={lang} />}
    {tagPublik && <SiteSearch lang={lang} />}
    {tagPublik && (
      <script is:inline>
        // Pintu konten (ContentGate): tampil saat kunjungan pertama, tutup
        // 24 jam begitu tombolnya diklik. Markup pintunya selalu `hidden` —
        // skrip inilah yang membukanya, jadi tanpa JavaScript dan bagi
        // perayap isi halaman tetap terbuka penuh.
        (function () {
          var COOKIE = "evkita_gate";
          var gate = document.getElementById("contentGate");
          if (!gate) return;
          var sudah = false;
          try {
            var parts = document.cookie.split(";");
            for (var i = 0; i < parts.length; i++) {
              if (parts[i].trim().indexOf(COOKIE + "=") === 0) { sudah = true; break; }
            }
          } catch (e) {}
          if (sudah) { gate.remove(); return; }
          var btn = document.getElementById("gateBtn");
          gate.hidden = false;
          document.documentElement.classList.add("modal-open");
          if (btn) btn.focus();
          if (btn) btn.addEventListener("click", function () {
            try {
              document.cookie = COOKIE + "=1; max-age=86400; path=/; SameSite=Lax";
            } catch (e) {}
            document.documentElement.classList.remove("modal-open");
            gate.remove();
          });
        })();
      </script>
    )}
    {tagPublik && (
      <script is:inline>
        // Pintu masuk pengunjung (MemberGate): muncul pada KLIK KEDUA di
        // situs. Klik pertama biasanya tombol pintu konten; klik berikutnya —
        // di halaman mana pun — membuka popup login ini. Masuk yang berhasil
        // (atau menutupnya) dicatat supaya tidak mengganggu lagi.
        (function () {
          var gate = document.getElementById("memberGate");
          if (!gate) return;
          var KEY = "evkita_member_local";
          var KLIK = "evkita_klik";
          var TUNDA = "evkita_member_snooze";

          function sudahMasuk() {
            try {
              if (/(?:^|;\s*)evkita_member=/.test(document.cookie)) return true;
              var l = window.localStorage.getItem(KEY);
              if (l) {
                try {
                  var d = JSON.parse(l);
                  if (d && d.at && Date.now() - d.at < 30 * 24 * 3600 * 1000) return true;
                } catch (e) { return true; }
              }
              if (window.sessionStorage.getItem(KEY)) return true;
              /* Ditutup sekali = tidak muncul 90 hari, lintas kunjungan.
                 Yang tidak mau login tidak dipaksa dan tidak diganggu lagi;
                 yang sudah login tidak pernah melihatnya (cookie sesi). */
              var sn = parseInt(window.localStorage.getItem(TUNDA) || "0", 10) || 0;
              if (sn && Date.now() - sn < 90 * 24 * 3600 * 1000) return true;
              if (window.sessionStorage.getItem(TUNDA)) return true;
            } catch (e) {}
            return false;
          }
          if (sudahMasuk()) { gate.remove(); return; }

          var klik = 0, dibuka = false, selesai = false;
          try { klik = parseInt(window.sessionStorage.getItem(KLIK) || "0", 10) || 0; } catch (e) {}

          function err(msg) {
            var p = document.getElementById("memberErr");
            if (p) { p.textContent = msg; p.hidden = false; }
          }
          function buka() {
            dibuka = true;
            gate.hidden = false;
            document.documentElement.classList.add("modal-open");
            var em = gate.querySelector('input[type="email"]');
            if (em) em.focus();
          }
          function tutup() {
            document.documentElement.classList.remove("modal-open");
            gate.remove();
          }
          function tunda() {
            try {
              window.localStorage.setItem(TUNDA, String(Date.now()));
              window.sessionStorage.setItem(TUNDA, "1");
            } catch (e) {}
            selesai = true;
            tutup();
          }

          /* Capture: klik tetap terhitung walau elemen lain menghentikannya. */
          document.addEventListener("click", function (e) {
            if (selesai || dibuka) return;
            if (gate.contains(e.target)) return;
            klik++;
            try { window.sessionStorage.setItem(KLIK, String(klik)); } catch (e2) {}
            if (klik < 2) return;
            /* Jangan menumpuk di atas pintu konten yang masih terbuka. */
            var g = document.getElementById("contentGate");
            if (g && !g.hidden) return;
            buka();
          }, true);

          var x = document.getElementById("memberX");
          if (x) x.addEventListener("click", tunda);
          /* Tombol akun di header: buka popup langsung tanpa menunggu klik
             kedua. Penjaga yang sama dipakai: jangan menumpuk di atas pintu
             konten, jangan dibuka dua kali. Dari laci mobile, lacinya
             ditutup dulu supaya tidak mengganjal popup. */
          var pemicu = document.querySelectorAll("[data-member-buka]");
          for (var pi = 0; pi < pemicu.length; pi++) {
            (function (btn) {
              btn.addEventListener("click", function () {
                if (selesai || dibuka) return;
                var g = document.getElementById("contentGate");
                if (g && !g.hidden) return;
                var navTutup = document.getElementById("navClose");
                if (navTutup && document.body.classList.contains("nav-open")) navTutup.click();
                buka();
              });
            })(pemicu[pi]);
          }
          var latar = gate.querySelector("[data-member-tutup]");
          if (latar) latar.addEventListener("click", tunda);
          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && dibuka && !selesai) tunda();
          });

          var form = document.getElementById("memberForm");
          if (form) form.addEventListener("submit", function (e) {
            e.preventDefault();
            var email = "";
            var pass = "";
            var ingat = false;
            try {
              email = String(form.email.value || "").trim();
              pass = String(form.password.value || "");
              ingat = !!form.remember.checked;
            } catch (e2) {}
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { err(gate.dataset.errEmail); return; }
            if (pass.length < 6) { err(gate.dataset.errPass); return; }
            /* Belum ada akun anggota di server (belum ada alur pendaftaran),
               jadi masuk email dicatat di peramban pengunjung sendiri. */
            try {
              var rekam = JSON.stringify({ email: email, at: Date.now() });
              if (ingat) window.localStorage.setItem(KEY, rekam);
              else window.sessionStorage.setItem(KEY, rekam);
            } catch (e3) {}
            selesai = true;
            tutup();
          });
        })();
      </script>
    )}
  </body>
</html>
