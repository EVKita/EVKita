---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  theme?: { primary?: string; secondary?: string };
}

const {
  title = "EVKita",
  description = "Basis data mobil listrik yang dijual di Indonesia: spesifikasi, jarak tempuh, baterai, tenaga, dan harga.",
  theme,
} = Astro.props;

const themeStyle = theme?.primary
  ? `--accent:${theme.primary};--accent-2:${theme.secondary || theme.primary};--accent-grad:linear-gradient(135deg,${theme.primary},${theme.secondary || theme.primary})`
  : "";
---
<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="theme-color" content="#f6f7fa" id="metaThemeColor" />
    <script is:inline>
      // Sengaja diletakkan sebelum <link rel="stylesheet"> font: skrip inline
      // tertahan menunggu stylesheet yang mendahuluinya selesai dimuat, dan
      // di koneksi lambat itu berarti tema gelap sempat berkedip terang.
      // Dijalankan sebelum render supaya tema tidak berkedip. Tema gelap
      // ditandai dengan atribut data-theme="dark" di <html>; ketiadaan
      // atribut berarti terang.
      (function () {
        var KEY = "evkita-theme";
        var el = document.documentElement;

        function apply(mode) {
          if (mode === "dark") {
            el.setAttribute("data-theme", "dark");
          } else {
            el.removeAttribute("data-theme");
          }
          var meta = document.getElementById("metaThemeColor");
          if (meta) meta.setAttribute("content", mode === "dark" ? "#0e1116" : "#f6f7fa");
        }

        var stored = null;
        try {
          stored = localStorage.getItem(KEY);
        } catch (e) {}

        var mq = window.matchMedia("(prefers-color-scheme: dark)");
        apply(stored || (mq.matches ? "dark" : "light"));

        // Selama pembaca belum memilih sendiri, ikuti setelan sistem kalau
        // setelan itu berubah saat halaman terbuka.
        var onSystemChange = function (e) {
          var picked = null;
          try {
            picked = localStorage.getItem(KEY);
          } catch (err) {}
          if (!picked) apply(e.matches ? "dark" : "light");
        };
        if (mq.addEventListener) mq.addEventListener("change", onSystemChange);
        else if (mq.addListener) mq.addListener(onSystemChange);

        // Delegasi klik: tombol bisa ada di halaman mana pun, dan skrip ini
        // berjalan di <head> saat tombolnya belum ada di DOM.
        document.addEventListener("click", function (e) {
          var btn = e.target && e.target.closest && e.target.closest("#themeToggle");
          if (!btn) return;
          var next = el.getAttribute("data-theme") === "dark" ? "light" : "dark";
          apply(next);
          try {
            localStorage.setItem(KEY, next);
          } catch (err) {}
        });
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body style={themeStyle}>
    <slot />
  </body>
</html>
