---
import KoleksiPage from "../../components/KoleksiPage.astro";
import { readContent } from "../../lib/store";
import { groupByField, findGroup } from "../../lib/taxonomy.js";
import { hanyaTayang } from "../../lib/tayang.js";
import { filterWilayah, regionDariParam } from "../../lib/region.js";
import { terjemahContent } from "../../lib/terjemahan.js";

/**
 * `/merek` dan `/merek/<merek>`.
 *
 * "Mobil listrik BYD" adalah salah satu kalimat yang paling sering diketik
 * orang, dan sampai sekarang situs ini menjawabnya dengan beranda ditambah dua
 * dropdown — keadaan yang tidak punya alamat, jadi tidak bisa dibagikan dan
 * tidak pernah dilihat perayap.
 *
 * Daftar mereknya diturunkan dari `content.json`, bukan ditulis di kode: merek
 * yang baru ditambahkan lewat panel langsung punya halamannya sendiri.
 */
const content = await terjemahContent(readContent(), Astro.locals?.pubLang);
const site = content.site;

/* Edisi kelompok: `?region=us`/`?region=cn` hanya memuat kendaraan edisinya. */
const region = regionDariParam(Astro.url.searchParams.get("region"));

const pool = filterWilayah([
  ...(content.cars || []).filter(hanyaTayang()),
  ...(site.showMotor ? (content.motors || []).filter(hanyaTayang()) : []),
], region);

const raw = Astro.params.slug;
const segmen = raw === undefined || raw === "" ? [] : String(raw).split("/");

const groups = groupByField(pool, "brand");
const group = segmen.length === 1 ? findGroup(groups, segmen[0]) : null;

/**
 * Satu halaman, satu alamat: `/merek/BYD` dan `/merek/byd` isinya sama persis,
 * jadi yang bukan bentuk baku dialihkan permanen ke bentuk bakunya.
 */
if (group && segmen[0] !== group.slug) {
  return Astro.redirect(region === "id" ? `/merek/${group.slug}` : `/merek/${group.slug}?region=${region}`, 301);
}

/* Alamat berlapis seperti "/merek/byd/seal" bukan merek yang salah eja,
   melainkan halaman yang tidak pernah ada. */
const mode = segmen.length === 0 ? "indeks" : group ? "kelompok" : "hilang";
if (mode === "hilang") {
  Astro.response.status = 404;
}
---

<KoleksiPage site={site} jenis="merek" pool={pool} mode={mode} group={group} media={content.media} region={region} />
