---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ArtikelCard from "../../components/ArtikelCard.astro";
import { readContent } from "../../lib/store";
import { artikelTayang, tanggalArtikel, hrefArtikel } from "../../lib/artikel.js";
import { siteOrigin, canonicalUrl, absoluteUrl } from "../../lib/site-url";
import { makePubT, normalizePubLocale, cmsSite, pubIntl } from "../../lib/i18n/pub.js";
import { terjemahContent } from "../../lib/terjemahan.js";

/**
 * Indeks artikel orisinal.
 *
 * Seluruh artikel tayang ditampilkan di SATU halaman, dikelompokkan per tahun.
 * Sengaja tanpa paginasi: daftar ini isinya judul dan dua baris ringkasan —
 * lima puluh kartu bukan beban, dan setiap artikel mendapat satu tautan
 * langsung dari halaman yang paling sering dirayapi. Paginasi akan menyembunyikan
 * tulisan lama di balik satu klik tambahan tanpa memberi apa pun sebagai
 * gantinya.
 *
 * Urutannya terbaru lebih dulu, dengan tahun sebagai pemisah supaya daftar
 * yang panjang tetap bisa dipindai.
 */
const lang = normalizePubLocale(Astro.locals?.pubLang);
const t = makePubT(lang);

const content = await terjemahContent(readContent(), lang);
const site = cmsSite(content.site, lang);
const brand = site.brandText || "EVKita";
const brandFull = `${brand}${site.brandSuffix || ""}`;

const daftar = artikelTayang(content.artikel);

/** Kelompok per tahun terbit, tahun terbaru lebih dulu. */
const kelompok: { tahun: string; items: any[] }[] = [];
for (const a of daftar) {
  const tahun = (tanggalArtikel(a) || "").slice(0, 4) || t("pub.artikel.tanpaTanggal");
  const terakhir = kelompok[kelompok.length - 1];
  if (terakhir && terakhir.tahun === tahun) terakhir.items.push(a);
  else kelompok.push({ tahun, items: [a] });
}

const origin = siteOrigin(Astro.url);
const canonical = canonicalUrl(Astro.url);

const pageTitle = `${t("pub.artikel.pageTitle")} — ${brandFull}`;
const metaDesc = daftar.length
  ? t("pub.artikel.metaDesc", { n: daftar.length })
  : t("pub.artikel.metaDescEmpty", { brand });

const jsonLd = daftar.length
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "CollectionPage",
          "@id": canonical,
          url: canonical,
          name: pageTitle,
          description: metaDesc,
          inLanguage: pubIntl(lang),
          isPartOf: { "@type": "WebSite", name: brandFull, url: `${origin}/` },
        },
        {
          "@type": "ItemList",
          name: `${t("pub.artikel.kategori")} ${brand}`,
          numberOfItems: daftar.length,
          itemListElement: daftar.slice(0, 30).map((a: any, i: number) => ({
            "@type": "ListItem",
            position: i + 1,
            name: a.title,
            url: absoluteUrl(Astro.url, hrefArtikel(a)),
          })),
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: t("pub.nav.beranda"), item: `${origin}/` },
            { "@type": "ListItem", position: 2, name: t("pub.nav.artikel"), item: canonical },
          ],
        },
      ],
    }
  : null;
---

<Base
  title={pageTitle}
  description={metaDesc}
  keywords={site.seoKeywords}
  ogImage={site.seoOgImage}
  site={site}
>
  <link slot="head" rel="alternate" type="application/rss+xml" title={`${t("pub.artikel.kategori")} ${brandFull}`} href="/artikel/rss.xml" />
  {jsonLd ? <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} /> : null}

  <SiteHeader site={site} base="/" active="artikel" />

  <main class="container katalog" id="konten">
    <nav class="breadcrumb" aria-label={t("pub.breadcrumb")}>
      <a href="/">{t("pub.nav.beranda")}</a>
      <span aria-hidden="true">/</span>
      <span class="breadcrumb-current">{t("pub.nav.artikel")}</span>
    </nav>

    <header class="katalog-head">
      <h1>{t("pub.artikel.title")}</h1>
      <p class="katalog-lead">
        {t("pub.artikel.lead", { brand })}
      </p>
      <p class="katalog-lead">{t("pub.artikelX.panduanD")}</p>
    </header>

    <section class="kalk-section">
      <h2>{t("pub.artikelX.faqT")}</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>{t("pub.artikelX.faq1q")}</summary>
          <p>{t("pub.artikelX.faq1a")}</p>
        </details>
        <details class="faq-item">
          <summary>{t("pub.artikelX.faq2q")}</summary>
          <p>{t("pub.artikelX.faq2a")}</p>
        </details>
        <details class="faq-item">
          <summary>{t("pub.artikelX.faq3q")}</summary>
          <p>{t("pub.artikelX.faq3a")}</p>
        </details>
      </div>
    </section>

    {daftar.length ? (
      kelompok.map((g) => (
        <section class="artikel-tahun">
          <h2>{g.tahun}</h2>
          <div class="artikel-grid">
            {g.items.map((a: any) => <ArtikelCard artikel={a} />)}
          </div>
        </section>
      ))
    ) : (
      <div class="empty">
        <p class="empty-title">{t("pub.artikel.empty")}</p>
        <p>{t("pub.artikel.emptyText")}</p>
        <a class="btn btn-primary btn-sm" href="/">{t("pub.artikel.back")}</a>
      </div>
    )}
  </main>

  <SiteFooter site={site} base="/" />
</Base>
