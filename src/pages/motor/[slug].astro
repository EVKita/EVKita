---
import VehicleDetail from "../../components/VehicleDetail.astro";
import { readContent } from "../../lib/store";
import { verifyPreviewToken } from "../../lib/pratinjau";
import { hanyaTayang } from "../../lib/tayang.js";

/**
 * Halaman detail satu motor listrik.
 *
 * Dua belas motor di katalog ini selama ini tidak punya satu pun alamat: yang
 * bisa didatangi hanyalah beranda dalam mode motor, dan itu satu halaman untuk
 * dua belas kendaraan. Perayap tidak pernah melihat spesifikasinya, dan
 * pembaca tidak punya apa pun untuk dibagikan selain alamat beranda.
 *
 * Isinya dipakai bersama halaman mobil lewat `VehicleDetail.astro` — data
 * keduanya melewati `normalizeCar()` yang sama, jadi tidak ada alasan
 * halamannya berbeda.
 */
const content = readContent();
const slug = String(Astro.params.slug || "");

/* Saklar "tampilkan motor" di panel mematikan seluruh sisi publik motor, bukan
   cuma seksinya di beranda: halaman detail yang tetap hidup padahal katalognya
   disembunyikan adalah pintu belakang ke konten yang sengaja ditutup. */
const motors = content.site.showMotor ? (content.motors || []).filter(hanyaTayang()) : [];
let motor = motors.find((m: any) => m.id === slug);

/**
 * Jalur pratinjau — sama seperti di `/mobil/[slug]`, dengan satu perbedaan
 * yang disengaja: ia tetap bekerja meski saklar "tampilkan motor" dimatikan.
 *
 * Saklar itu menutup sisi publik motor, dan penjagaan di atas tetap berlaku
 * untuk siapa pun yang datang tanpa tautan. Tapi tautan pratinjau bukan pintu
 * belakang: ia ditandatangani `SESSION_SECRET`, hanya bisa diterbitkan oleh
 * akun panel yang sedang masuk, berlaku untuk satu motor saja, dan mati dalam
 * dua jam. Menolaknya di sini hanya akan membuat penyunting tidak bisa
 * menyiapkan katalog motor sebelum katalognya dinyalakan — yaitu persis saat
 * pratinjau paling dibutuhkan.
 */
let pratinjau = false;
if (!motor && verifyPreviewToken(Astro.url.searchParams.get("pratinjau"), "motors", slug)) {
  const draf = (content.motors || []).find((m: any) => m.id === slug);
  if (draf) {
    motor = draf;
    pratinjau = true;
  }
}

if (!motor) {
  /* Kebalikan dari pengalihan di `/mobil/[slug]`: alamat yang salah kamar
     dibetulkan, bukan dijawab 404. Tanpa ini, satu-satunya yang menanggung
     kesalahan ketik adalah pembacanya. */
  const car = (content.cars || []).filter(hanyaTayang()).find((c: any) => c.id === slug);
  if (car) {
    return Astro.redirect(`/mobil/${encodeURIComponent(car.id)}`, 301);
  }
  Astro.response.status = 404;
}
---

<VehicleDetail site={content.site} vehicle={motor || null} pool={motors} kind="motor" media={content.media} pratinjau={pratinjau} />
