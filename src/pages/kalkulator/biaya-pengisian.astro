---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { readContent } from "../../lib/store";
import { vehicleHref } from "../../lib/card-html.js";
import { TARIF_PRESETS } from "../../lib/hemat.js";
import {
  DEFAULTS,
  DAYA_PRESETS,
  BATAS_TAPER,
  hitungPengisian,
  modePengisian,
  teksDurasi,
  kwhKeTeks,
  kmKeTeks,
  teksRingkasPengisian,
  catatanHasil,
} from "../../lib/pengisian.js";
import { rupiahPenuh, rupiahHalus } from "../../lib/hemat.js";
import { siteOrigin, canonicalUrl } from "../../lib/site-url";
import { hanyaTayang } from "../../lib/tayang.js";
import { makePubT, normalizePubLocale, cmsSite, pubIntl } from "../../lib/i18n/pub.js";

/**
 * Kalkulator waktu & biaya sekali mengisi daya.
 *
 * Pasangan alami bagi direktori SPKLU yang sudah ada: situs ini sudah lama
 * menyebut di mana bisa mengisi, tapi tidak pernah menjawab berapa lama dan
 * habis berapa — dua hal yang justru menentukan apakah perjalanannya masuk akal.
 *
 * Hasilnya dirender SERVER dari parameter URL lalu dihitung ulang di browser
 * lewat fungsi yang sama persis, seperti kalkulator hemat. Formulirnya
 * `method="get"`, jadi halaman ini tetap berfungsi utuh tanpa JavaScript.
 *
 * Yang paling penting ditiru dari kalkulator hemat bukan strukturnya melainkan
 * SIKAPNYA: lama pengisian tidak pernah disajikan sebagai satu angka, karena
 * pengisian tidak linear dan kurvanya berbeda tiap kendaraan.
 */

const content = readContent();
const lang = normalizePubLocale(Astro.locals?.pubLang);
const site = cmsSite(content.site, lang);

const t = makePubT(lang);
const intl = pubIntl(lang);

const cars = (content.cars || []).filter(hanyaTayang());
const motors = site.showMotor ? (content.motors || []).filter(hanyaTayang()) : [];

/** Hanya kendaraan yang kapasitas baterainya tercatat — tanpa itu tak ada yang bisa dihitung. */
const punyaBaterai = (v: any) => v.batteryKwh !== null && v.batteryKwh !== undefined && Number(v.batteryKwh) > 0;
const pilihanMobil = cars.filter(punyaBaterai);
const pilihanMotor = motors.filter(punyaBaterai);
const pilihan = [...pilihanMobil, ...pilihanMotor];

const q = Astro.url.searchParams;

/**
 * Membaca satu parameter URL.
 *
 * Yang membedakan "tidak disebut" dari "sengaja dikosongkan" bukan kerewelan:
 * `?tarif=` berarti pembacanya menghapus isian itu, dan mengembalikannya ke
 * nilai bawaan membuat halaman yang dimuat ulang menjawab BEDA dari yang
 * barusan dilihat di layar. Kalkulator yang berubah jawaban saat disegarkan
 * sama tidak bisa dipercayanya dengan yang berubah saat skripnya dimuat.
 */
const num = (key: string, fallback: number | "") => {
  const raw = q.get(key);
  if (raw === null) return fallback;
  if (raw.trim() === "") return "";
  const n = Number(raw.replace(",", "."));
  return Number.isFinite(n) && n >= 0 ? n : fallback;
};

const kendaraanId = q.get("kendaraan") || "";
const terpilih = pilihan.find((c: any) => c.id === kendaraanId) || pilihan[0] || null;

const form = {
  kendaraan: terpilih ? terpilih.id : "",
  batteryKwh: num("baterai", terpilih ? terpilih.batteryKwh : 60),
  socAwal: num("awal", DEFAULTS.socAwal),
  socAkhir: num("akhir", DEFAULTS.socAkhir),
  dayaKw: num("daya", DEFAULTS.dayaKw),
  tarif: num("tarif", DEFAULTS.tarif),
};

const mode = modePengisian(form.dayaKw);

/**
 * Batas daya yang diterima kendaraan, dari katalog.
 *
 * Hari ini nilainya null untuk SELURUH kendaraan — kolomnya ada di panel dan
 * sudah terpasang di halaman detail maupun tabel perbandingan, tapi belum satu
 * pun terisi. Jalurnya tetap dipasang di sini supaya begitu penyunting
 * mengisinya, hitungannya langsung ikut benar; dan selama masih kosong,
 * `catatanHasil()` yang mengatakannya terus terang alih-alih diam-diam
 * menganggap seluruh daya stasiun terpakai.
 */
const dayaMaksKendaraan = terpilih ? (mode === "dc" ? terpilih.chargeDcKw : terpilih.chargeAcKw) : null;

const hasil = hitungPengisian({
  ...form,
  dayaMaksKendaraan,
  rangeKm: terpilih ? terpilih.rangeKm : null,
});

const catatan = catatanHasil(hasil, t);

/** Data kendaraan yang disuntik ke browser dipangkas ke field yang dipakai kotak pilihan. */
const kendaraanLite = pilihan.map((c: any) => ({
  id: c.id,
  batteryKwh: c.batteryKwh,
  rangeKm: c.rangeKm ?? null,
  chargeDcKw: c.chargeDcKw ?? null,
  chargeAcKw: c.chargeAcKw ?? null,
}));

const brand = site.brandText || "EVKita";
const pageTitle = `${t("pub.kalk.pageBiaya")} — ${brand}`;
const metaDesc = t("pub.kalk.descBiaya");

const origin = siteOrigin(Astro.url);
const canonical = canonicalUrl(Astro.url);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: t("pub.kalk.metaBiaya"),
      url: canonical,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Web",
      description: metaDesc,
      offers: { "@type": "Offer", price: 0, priceCurrency: "IDR" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: t("pub.nav.beranda"), item: `${origin}/` },
        { "@type": "ListItem", position: 2, name: t("pub.kalk.titleBiaya") },
      ],
    },
  ],
};

/** Teks hasil yang dirender server; skrip browser menghitung ulang dengan fungsi yang sama. */
const teks = {
  durasi: teksDurasi(hasil, t),
  biaya: rupiahPenuh(hasil.biaya),
  perKwh: hasil.biayaPerKwh !== null ? rupiahHalus(hasil.biayaPerKwh) : "—",
  energiMasuk: kwhKeTeks(hasil.energiMasuk),
  energiDitagih: kwhKeTeks(hasil.energiDitagih),
  km: kmKeTeks(hasil.kmDidapat),
};

const ringkas = teksRingkasPengisian(hasil, t);

/**
 * Contoh yang sudah dihitung: tiga terlaris berk baterai tercatat, skenario
 * sama (20→80%, DC 50 kW, tarif SPKLU). Dihitung fungsi yang sama dengan
 * kalkulator di atas — bukan angka yang diketik tangan — jadi tidak bisa
 * berselisih dengan hasil form. Entri yang hilang dari katalog gugur sendiri.
 */
const contohIsi = ["byd-atto-1", "jaecoo-j5-ev", "byd-m6"]
  .map((id) => pilihan.find((c: any) => c.id === id))
  .filter((v: any) => v && Number(v.batteryKwh) > 0)
  .map((v: any) => {
    const r = hitungPengisian({
      batteryKwh: v.batteryKwh,
      socAwal: 20,
      socAkhir: 80,
      dayaKw: 50,
      tarif: 2466,
      dayaMaksKendaraan: null,
      rangeKm: v.rangeKm ?? null,
    });
    return {
      nama: `${v.brand} ${v.name}`,
      masuk: kwhKeTeks(r.energiMasuk),
      waktu: teksDurasi(r, t),
      biaya: rupiahPenuh(r.biaya),
    };
  });
---

<Base
  title={pageTitle}
  description={metaDesc}
  keywords={t("pub.kalk.keywordBiaya")}
  ogImage={site.seoOgImage}
  site={site}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <SiteHeader site={site} base="/" active="" />

  <main class="container kalk" id="konten">
    <nav class="breadcrumb" aria-label={t("pub.breadcrumb")}>
      <a href="/">{t("pub.nav.beranda")}</a>
      <span aria-hidden="true">/</span>
      <span class="breadcrumb-current">{t("pub.kalk.titleBiaya")}</span>
    </nav>

    <header class="kalk-head">
      <h1>{t("pub.kalk.h1Biaya")}</h1>
      <p class="kalk-lead">{t("pub.kalk.leadBiaya")}</p>
    </header>

    <form class="kalk-form" id="pengisianForm" method="get" autocomplete="off">
      <div class="kalk-grid">
        <div class="kalk-field kalk-field-wide">
          <label for="f-kendaraan">{t("pub.kalk.kendaraan")}</label>
          <select id="f-kendaraan" name="kendaraan">
            {pilihanMobil.length ? (
              <optgroup label={t("pub.tax.titleMobil")}>
                {pilihanMobil.map((c: any) => (
                  <option value={c.id} selected={c.id === form.kendaraan}>{c.brand} {c.name}</option>
                ))}
              </optgroup>
            ) : null}
            {pilihanMotor.length ? (
              <optgroup label={t("pub.tax.titleMotor")}>
                {pilihanMotor.map((c: any) => (
                  <option value={c.id} selected={c.id === form.kendaraan}>{c.brand} {c.name}</option>
                ))}
              </optgroup>
            ) : null}
          </select>
          <p class="kalk-hint">{t("pub.kalk.pilihHint")}</p>
        </div>

        <div class="kalk-field">
          <label for="f-baterai">{t("pub.kalk.kapasitas")} <span class="kalk-unit">kWh</span></label>
          <input id="f-baterai" name="baterai" type="number" min="0.1" step="0.1" value={form.batteryKwh} />
        </div>

        <div class="kalk-field">
          <label for="f-awal">{t("pub.kalk.mulai")} <span class="kalk-unit">%</span></label>
          <input id="f-awal" name="awal" type="number" min="0" max="100" step="1" value={form.socAwal} />
        </div>

        <div class="kalk-field">
          <label for="f-akhir">{t("pub.kalk.sampai")} <span class="kalk-unit">%</span></label>
          <input id="f-akhir" name="akhir" type="number" min="0" max="100" step="1" value={form.socAkhir} />
          <p class="kalk-hint">{t("pub.kalk.hintTaper", { batas: BATAS_TAPER })}</p>
        </div>

        <div class="kalk-field">
          <label for="f-daya">{t("pub.kalk.daya")} <span class="kalk-unit">kW</span></label>
          <input id="f-daya" name="daya" type="number" min="0.1" step="0.1" value={form.dayaKw} />
          <div class="kalk-presets">
            {DAYA_PRESETS.map((p) => (
              <button type="button" class="kalk-preset" data-target="f-daya" data-value={p.value}>
                {p.i18n ? t(p.i18n) : p.label} <span>{p.value} kW</span>
              </button>
            ))}
          </div>
        </div>

        <div class="kalk-field">
          <label for="f-tarif">{t("pub.kalk.tarif")} <span class="kalk-unit">Rp / kWh</span></label>
          <input id="f-tarif" name="tarif" type="number" min="1" step="0.01" value={form.tarif} />
          <div class="kalk-presets">
            {TARIF_PRESETS.map((p) => (
              <button type="button" class="kalk-preset" data-target="f-tarif" data-value={p.value}>
                {p.i18n ? t(p.i18n) : p.label} <span>≈{Math.round(p.value).toLocaleString(intl)}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Tanpa JavaScript, tombol ini mengirim formulir sebagai GET dan server
          merender hasilnya — halaman ini tetap berfungsi utuh. */}
      <noscript>
        <button type="submit" class="btn btn-primary">{t("pub.kalk.hitung")}</button>
      </noscript>
    </form>

    <section class="kalk-result" aria-live="polite">
      <p class="kalk-summary" id="p-summary">{ringkas}</p>

      <div class="kalk-cards">
        <div class="kalk-card kalk-card-accent">
          <span class="kalk-card-label">{t("pub.kalk.lama")}</span>
          <strong class="kalk-card-value" id="p-durasi">{teks.durasi}</strong>
          <span class="kalk-card-sub">{t("pub.kalk.rentang")}</span>
        </div>
        <div class="kalk-card">
          <span class="kalk-card-label">{t("pub.kalk.biaya")}</span>
          <strong class="kalk-card-value" id="p-biaya">{teks.biaya}</strong>
          <span class="kalk-card-sub"><span id="p-per-kwh">{teks.perKwh}</span> {t("pub.kalk.perKwh")}</span>
        </div>
        <div class="kalk-card">
          <span class="kalk-card-label">{t("pub.kalk.masuk")}</span>
          <strong class="kalk-card-value" id="p-energi">{teks.energiMasuk}</strong>
          <span class="kalk-card-sub">{t("pub.kalk.dibayar")} <span id="p-ditagih">{teks.energiDitagih}</span></span>
        </div>
        <div class="kalk-card">
          <span class="kalk-card-label">{t("pub.kalk.setara")}</span>
          <strong class="kalk-card-value" id="p-km">{teks.km}</strong>
          <span class="kalk-card-sub">{t("pub.kalk.klaim")}</span>
        </div>
      </div>

      {/* Peringatan bukan hiasan, melainkan bagian dari jawabannya — dan yang
          muncul hanya yang benar-benar berlaku untuk angka yang sedang tampil. */}
      <ul class="kalk-notes kalk-notes-live" id="p-catatan">
        {catatan.map((c: string) => <li>{c}</li>)}
      </ul>

      {terpilih ? (
        <p class="kalk-detail-link">
          <a href={vehicleHref(terpilih)}>{t("pub.kalk.lihatSpesifikasi")} {terpilih.brand} {terpilih.name} →</a>
        </p>
      ) : null}
    </section>

    <section class="kalk-section">
      <h2>{t("pub.isiX.contohT")}</h2>
      <p class="section-note">{t("pub.isiX.contohD")}</p>
      {contohIsi.length ? (
        <div class="compare-scroll">
          <table class="compare-table">
            <thead>
              <tr>
                <th scope="col">{t("pub.isiX.kend")}</th>
                <th scope="col">{t("pub.isiX.masuk")}</th>
                <th scope="col">{t("pub.isiX.waktu")}</th>
                <th scope="col">{t("pub.isiX.biaya")}</th>
              </tr>
            </thead>
            <tbody>
              {contohIsi.map((c: any) => (
                <tr>
                  <th scope="row">{c.nama}</th>
                  <td>{c.masuk}</td>
                  <td>{c.waktu}</td>
                  <td>{c.biaya}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : null}
    </section>

    <section class="kalk-section">
      <h2>{t("pub.isiX.faqT")}</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>{t("pub.isiX.faq1q")}</summary>
          <p>{t("pub.isiX.faq1a")}</p>
        </details>
        <details class="faq-item">
          <summary>{t("pub.isiX.faq2q")}</summary>
          <p>{t("pub.isiX.faq2a")}</p>
        </details>
        <details class="faq-item">
          <summary>{t("pub.isiX.faq3q")}</summary>
          <p>{t("pub.isiX.faq3a")}</p>
        </details>
        <details class="faq-item">
          <summary>{t("pub.isiX.faq4q")}</summary>
          <p>{t("pub.isiX.faq4a")}</p>
        </details>
      </div>
    </section>

    <section class="kalk-section">
      <h2>{t("pub.kalk.tidakDihitung")}</h2>
      <ul class="kalk-notes">
        <li>{t("pub.kalk.tidakDihitungIsi1")}</li>
        <li>{t("pub.kalk.tidakDihitungIsi2")}</li>
        <li>{t("pub.kalk.tidakDihitungIsi3")}</li>
        <li>{t("pub.kalk.tidakDihitungIsi4")}</li>
      </ul>
    </section>

    <section class="kalk-section">
      <h2>{t("pub.kalk.lanjut")}</h2>
      <div class="tag-row">
        <a class="tag-pill" href="/kalkulator/hemat-listrik-vs-bensin">{t("pub.kalk.kalkulatorHemat")}</a>
        {site.showSpklu ? <a class="tag-pill" href="/#spklu">{t("pub.kalk.daftarSpklu")}</a> : null}
        <a class="tag-pill" href="/katalog">{t("pub.koleksi.katalogLengkap")}</a>
      </div>
    </section>
  </main>

  <SiteFooter site={site} base="/" />

  <script define:vars={{ kendaraanLite }}>
    window.__EV_PENGISIAN__ = kendaraanLite;
  </script>
  <script src="../../scripts/pengisian.js"></script>
</Base>
