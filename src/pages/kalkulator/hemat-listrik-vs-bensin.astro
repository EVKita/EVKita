---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { readContent } from "../../lib/store";
import { vehicleHref } from "../../lib/card-html.js";
import {
  DEFAULTS,
  TARIF_PRESETS,
  consumptionKwhPer100,
  hitungHemat,
  rupiahPenuh,
  rupiahHalus,
  teksBalikModal,
  teksRingkas,
} from "../../lib/hemat.js";
import { siteOrigin, canonicalUrl } from "../../lib/site-url";
import { hanyaTayang } from "../../lib/tayang.js";
import { makePubT, normalizePubLocale, cmsSite, pubIntl } from "../../lib/i18n/pub.js";

/**
 * Kalkulator hemat: listrik vs bensin.
 *
 * Pertanyaan pertama setiap calon pembeli EV di Indonesia, dan sampai sekarang
 * situs ini hanya menjawab setengahnya — katalognya menyebut kapasitas baterai
 * dan jarak tempuh, tapi tidak seorang pun membeli mobil karena angka kWh.
 * Yang mereka mau tahu: sebulan habis berapa, dan selisih harga belinya kapan
 * kembali.
 *
 * Hasilnya dirender SERVER dari parameter URL, lalu dihitung ulang di browser
 * setiap angka diubah. Dua-duanya memanggil `hitungHemat()` yang sama, jadi
 * angka yang dilihat perayap dan angka yang dilihat pembaca tidak bisa
 * berselisih — dan hasil hitungan bisa dibagikan lewat tautan.
 */

const content = readContent();
const lang = normalizePubLocale(Astro.locals?.pubLang);
const site = cmsSite(content.site, lang);

const t = makePubT(lang);
const intl = pubIntl(lang);

const cars = (content.cars || []).filter(hanyaTayang());

/** Hanya mobil yang datanya cukup untuk dihitung yang boleh muncul di pilihan. */
const pilihan = cars
  .map((c: any) => ({ ...c, kwhPer100: consumptionKwhPer100(c) }))
  .filter((c: any) => c.kwhPer100 !== null);

const q = Astro.url.searchParams;

/**
 * Membaca satu parameter URL, atau memakai nilai bawaannya.
 *
 * Bawaan untuk harga beli sengaja string kosong, BUKAN nol: nol adalah harga
 * yang sah, dan mobil bensin seharga Rp 0 akan membuat "balik modal" dihitung
 * dari seluruh harga mobil listriknya — jawaban yang kelihatan pasti padahal
 * tidak ada yang pernah menanyakannya.
 */
const num = (key: string, fallback: number | "") => {
  const raw = q.get(key);
  if (raw === null || raw.trim() === "") return fallback;
  const n = Number(raw.replace(",", "."));
  return Number.isFinite(n) && n > 0 ? n : fallback;
};

const mobilId = q.get("mobil") || "";
const terpilih = pilihan.find((c: any) => c.id === mobilId) || pilihan[0] || null;

const form = {
  mobil: terpilih ? terpilih.id : "",
  kwhPer100: num("kwh", terpilih ? terpilih.kwhPer100 : 17),
  elecPrice: num("listrik", DEFAULTS.elecPrice),
  fuelPrice: num("bbm", DEFAULTS.fuelPrice),
  kmPerLiter: num("kml", DEFAULTS.kmPerLiter),
  kmPerMonth: num("km", DEFAULTS.kmPerMonth),
  evPrice: num("hargaEv", terpilih && terpilih.price ? terpilih.price : ""),
  icePrice: num("hargaBensin", ""),
};

const hasil = hitungHemat(form);

/**
 * Data mobil yang disuntik ke browser dipangkas ke tiga field yang benar-benar
 * dipakai kotak pilihan — nama, konsumsi, harga. Bukan seluruh objek katalog.
 */
const mobilLite = pilihan.map((c: any) => ({
  id: c.id,
  label: `${c.brand} ${c.name}`,
  kwhPer100: c.kwhPer100,
  price: c.price ?? 0,
}));

const brand = site.brandText || "EVKita";
const pageTitle = `${t("pub.kalk.pageHemat")} — ${brand}`;
const metaDesc = t("pub.kalk.descHemat");

const origin = siteOrigin(Astro.url);
const canonical = canonicalUrl(Astro.url);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: t("pub.kalk.metaHemat"),
      url: canonical,
      applicationCategory: "FinanceApplication",
      operatingSystem: "Web",
      description: metaDesc,
      offers: { "@type": "Offer", price: 0, priceCurrency: "IDR" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: t("pub.nav.beranda"), item: `${origin}/` },
        { "@type": "ListItem", position: 2, name: t("pub.kalk.titleHemat") },
      ],
    },
  ],
};

/**
 * Teks hasil yang dirender server; skrip di browser menghitung ulang dengan
 * fungsi yang sama persis, jadi tidak ada satu pun kalimat di sini yang
 * dirakit dua kali di dua tempat.
 */
const teks = {
  evMonthly: rupiahPenuh(hasil.evMonthly),
  iceMonthly: rupiahPenuh(hasil.iceMonthly),
  evPerKm: rupiahHalus(hasil.evPerKm),
  icePerKm: rupiahHalus(hasil.icePerKm),
  savingMonthly: rupiahPenuh(hasil.savingMonthly),
  savingYearly: rupiahPenuh(hasil.savingYearly),
  payback: teksBalikModal(hasil, t),
};

const ringkas = teksRingkas(hasil, t);

/**
 * Contoh menurut jarak tempuh: asumsi bawaan (Atto 1 10 kWh/100 km, listrik
 * rumah, bensin 13 rb @ 12 km/l) dengan contoh selisih harga Rp45 jt.
 * Dihitung `hitungHemat()` yang sama dengan form di atas — bukan angka
 * ketikan — jadi tidak bisa berselisih dengan kalkulatornya.
 */
const contohProfil = [1000, 2000, 3000].map((km) => {
  const r = hitungHemat({
    kwhPer100: 10,
    elecPrice: 1444.7,
    fuelPrice: 13000,
    kmPerLiter: 12,
    kmPerMonth: km,
    evPrice: 195000000,
    icePrice: 150000000,
  });
  return { km: km.toLocaleString(intl), hemat: rupiahPenuh(r.savingMonthly), kembali: teksBalikModal(r, t) };
});
---

<Base title={pageTitle} description={metaDesc} keywords={t("pub.kalk.keywordHemat")} ogImage={site.seoOgImage} site={site}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <SiteHeader site={site} base="/" active="" />

  <main class="container kalk" id="konten">
    <nav class="breadcrumb" aria-label={t("pub.breadcrumb")}>
      <a href="/">{t("pub.nav.beranda")}</a>
      <span aria-hidden="true">/</span>
      <span class="breadcrumb-current">{t("pub.kalk.titleHemat")}</span>
    </nav>

    <header class="kalk-head">
      <h1>{t("pub.kalk.h1Hemat")}</h1>
      <p class="kalk-lead">{t("pub.kalk.leadHemat")}</p>
    </header>

    <form class="kalk-form" id="kalkForm" method="get" autocomplete="off">
      <div class="kalk-grid">
        <div class="kalk-field kalk-field-wide">
          <label for="f-mobil">{t("pub.kalk.mobilListrik")}</label>
          <select id="f-mobil" name="mobil">
            {pilihan.map((c: any) => (
              <option value={c.id} selected={c.id === form.mobil}>{c.brand} {c.name}</option>
            ))}
          </select>
          <p class="kalk-hint">{t("pub.kalk.hintPilihMobil")}</p>
        </div>

        <div class="kalk-field">
          <label for="f-kwh">{t("pub.kalk.konsumsi")} <span class="kalk-unit">kWh / 100 km</span></label>
          <input id="f-kwh" name="kwh" type="number" min="1" step="0.1" value={form.kwhPer100} />
          <p class="kalk-hint">{t("pub.kalk.hintKonsumsi")}</p>
        </div>

        <div class="kalk-field">
          <label for="f-listrik">{t("pub.kalk.tarif")} <span class="kalk-unit">Rp / kWh</span></label>
          <input id="f-listrik" name="listrik" type="number" min="1" step="0.01" value={form.elecPrice} />
          <div class="kalk-presets">
            {TARIF_PRESETS.map((p) => (
              <button type="button" class="kalk-preset" data-target="f-listrik" data-value={p.value}>
                {p.i18n ? t(p.i18n) : p.label} <span>≈{Math.round(p.value).toLocaleString(intl)}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="kalk-field">
          <label for="f-bbm">{t("pub.kalk.hargaBbm")} <span class="kalk-unit">Rp / liter</span></label>
          <input id="f-bbm" name="bbm" type="number" min="1" step="100" value={form.fuelPrice} />
        </div>

        <div class="kalk-field">
          <label for="f-kml">{t("pub.kalk.konsumsiBensin")} <span class="kalk-unit">km / liter</span></label>
          <input id="f-kml" name="kml" type="number" min="1" step="0.1" value={form.kmPerLiter} />
        </div>

        <div class="kalk-field">
          <label for="f-km">{t("pub.kalk.jarakBulan")} <span class="kalk-unit">{t("pub.kalk.kmBulan")}</span></label>
          <input id="f-km" name="km" type="number" min="1" step="50" value={form.kmPerMonth} />
        </div>

        <div class="kalk-field">
          <label for="f-harga-ev">{t("pub.kalk.hargaEv")} <span class="kalk-unit">Rp</span></label>
          <input id="f-harga-ev" name="hargaEv" type="number" min="0" step="1000000" value={form.evPrice || ""} />
        </div>

        <div class="kalk-field">
          <label for="f-harga-bensin">{t("pub.kalk.hargaBensin")} <span class="kalk-unit">Rp</span></label>
          <input id="f-harga-bensin" name="hargaBensin" type="number" min="0" step="1000000" value={form.icePrice || ""} placeholder={t("pub.kalk.opsional")} />
          <p class="kalk-hint">{t("pub.kalk.hintHargaBensin")}</p>
        </div>
      </div>

      {/* Tanpa JavaScript, tombol ini mengirim formulir sebagai GET dan server
          merender hasilnya — halaman ini tetap berfungsi utuh. */}
      <noscript>
        <button type="submit" class="btn btn-primary">{t("pub.kalk.hitung")}</button>
      </noscript>
    </form>

    <section class="kalk-result" aria-live="polite">
      <p class="kalk-summary" id="r-summary">{ringkas}</p>

      <div class="kalk-cards">
        <div class="kalk-card">
          <span class="kalk-card-label">{t("pub.kalk.listrikBulan")}</span>
          <strong class="kalk-card-value" id="r-ev">{teks.evMonthly}</strong>
          <span class="kalk-card-sub"><span id="r-ev-km">{teks.evPerKm}</span> {t("pub.kalk.perKm")}</span>
        </div>
        <div class="kalk-card">
          <span class="kalk-card-label">{t("pub.kalk.bensinBulan")}</span>
          <strong class="kalk-card-value" id="r-ice">{teks.iceMonthly}</strong>
          <span class="kalk-card-sub"><span id="r-ice-km">{teks.icePerKm}</span> {t("pub.kalk.perKm")}</span>
        </div>
        <div class="kalk-card kalk-card-accent">
          <span class="kalk-card-label">{t("pub.kalk.selisih")}</span>
          <strong class="kalk-card-value" id="r-saving">{teks.savingMonthly}</strong>
          <span class="kalk-card-sub"><span id="r-saving-year">{teks.savingYearly}</span> {t("pub.kalk.setahun")}</span>
        </div>
        <div class="kalk-card">
          <span class="kalk-card-label">{t("pub.kalk.selisihHarga")}</span>
          <strong class="kalk-card-value" id="r-payback">{teks.payback}</strong>
          <span class="kalk-card-sub">{t("pub.kalk.dariPenghematan")}</span>
        </div>
      </div>

      {terpilih ? (
        <p class="kalk-detail-link">
          <a href={vehicleHref(terpilih)}>{t("pub.kalk.lihatSpesifikasi")} {terpilih.brand} {terpilih.name} →</a>
        </p>
      ) : null}
    </section>

    <section class="kalk-section">
      <h2>{t("pub.hemX.profilT")}</h2>
      <p class="section-note">{t("pub.hemX.profilD")}</p>
      <div class="compare-scroll">
        <table class="compare-table">
          <thead>
            <tr>
              <th scope="col">{t("pub.hemX.jarak")}</th>
              <th scope="col">{t("pub.hemX.hematB")}</th>
              <th scope="col">{t("pub.hemX.kembali")}</th>
            </tr>
          </thead>
          <tbody>
            {contohProfil.map((c: any) => (
              <tr>
                <th scope="row">{c.km} km</th>
                <td>{c.hemat}</td>
                <td>{c.kembali}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="kalk-hint">{t("pub.hemX.acuan")}</p>
      <h3 class="mulai-faq-title">{t("pub.hemX.caraT")}</h3>
      <p class="section-note">{t("pub.hemX.caraD")}</p>
    </section>

    <section class="kalk-section">
      <h2>{t("pub.hemX.faqT")}</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>{t("pub.hemX.faq1q")}</summary>
          <p>{t("pub.hemX.faq1a")}</p>
        </details>
        <details class="faq-item">
          <summary>{t("pub.hemX.faq2q")}</summary>
          <p>{t("pub.hemX.faq2a")}</p>
        </details>
        <details class="faq-item">
          <summary>{t("pub.hemX.faq3q")}</summary>
          <p>{t("pub.hemX.faq3a")}</p>
        </details>
      </div>
    </section>

    <section class="kalk-section">
      <h2>{t("pub.kalk.tidakDihitung")}</h2>
      {/* Kalkulator yang menyajikan asumsinya sebagai fakta lebih menyesatkan
          daripada tidak ada kalkulator sama sekali. */}
      <ul class="kalk-notes">
        <li>{t("pub.kalk.tidakDihitungHemat1")}</li>
        <li>{t("pub.kalk.tidakDihitungHemat2")}</li>
        <li>{t("pub.kalk.tidakDihitungHemat3")}</li>
        <li>{t("pub.kalk.tidakDihitungHemat4")}</li>
      </ul>
    </section>

    <section class="kalk-section">
      <h2>{t("pub.kalk.lanjut")}</h2>
      <div class="tag-row">
        <a class="tag-pill" href="/kalkulator/biaya-pengisian">{t("pub.kalk.titleBiaya")}</a>
        <a class="tag-pill" href="/katalog">{t("pub.koleksi.katalogLengkap")}</a>
        <a class="tag-pill" href="/merek">{t("pub.koleksi.semua", { jenis: t("pub.koleksi.jenisMerek") })}</a>
      </div>
    </section>
  </main>

  <SiteFooter site={site} base="/" />

  <script define:vars={{ mobilLite }}>
    window.__EV_KALK__ = mobilLite;
  </script>
  <script src="../../scripts/kalkulator.js"></script>
</Base>
