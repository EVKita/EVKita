---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { readContent } from "../../lib/store";
import { makePubT, normalizePubLocale, cmsSite, pubIntl } from "../../lib/i18n/pub.js";
import { terjemahContent } from "../../lib/terjemahan.js";
import { regionDariParam } from "../../lib/region.js";
import { canonicalUrl, siteOrigin } from "../../lib/site-url";
import {
  bawaanKarbon,
  metrikKarbon,
  hitungKarbon,
  emisiTeks,
  satuanEmisi,
  satuanJarak,
} from "../../lib/kalk-region.js";

/**
 * Kalkulator emisi karbon — dan koreksi penting soal satuannya.
 *
 * Rendering SERVER dari parameter URL, sama seperti TCO: tanpa JavaScript
 * halaman tetap berfungsi, dan angka yang tampil adalah angka yang dihitung
 * satu fungsi (`hitungKarbon`) yang juga diuji.
 *
 * Edisi mengikuti `?region=`: Amerika memakai mil, MPG, dan kWh/100 mi serta
 * menampilkan emisi dalam pon; Indonesia & China memakai km, L/100 km, dan
 * kWh/100 km dengan emisi kilogram.
 */

const content = await terjemahContent(readContent(), Astro.locals?.pubLang);
const lang = normalizePubLocale(Astro.locals?.pubLang);
const t = makePubT(lang);
const site = cmsSite(content.site, lang);
const intl = pubIntl(lang);

const q = Astro.url.searchParams;
const region = regionDariParam(q.get("region"));
const us = region === "us";
const edisiBase = region === "id" ? "" : region === "us" ? "/amerika" : "/china";
const edisiParam = region === "id" ? "" : `?region=${region}`;

const b = bawaanKarbon(region);
const satuan = satuanJarak(region);
const satuanCo2 = satuanEmisi(region);

const num = (key: string, fallback: number) => {
  const raw = q.get(key);
  if (raw === null) return fallback;
  if (raw.trim() === "") return 0;
  const n = Number(raw.replace(",", "."));
  return Number.isFinite(n) && n >= 0 ? n : fallback;
};

const form = {
  jarak: num("jarak", b.jarak),
  bbm: num("bbm", b.bbm),
  ev: num("ev", b.ev),
  faktor: num("faktor", b.faktor),
};

const metrik = metrikKarbon(region, form);
const hasil = hitungKarbon(metrik);

const tampil = q.get("hitung") === "1" && form.jarak > 0;
const angka = (n: number) => Math.round(n).toLocaleString(intl);
const emisi = (kg: number) => emisiTeks(kg, region);

const origin = siteOrigin(Astro.url);
const canonical =
  region === "id" ? canonicalUrl(Astro.url) : `${origin}/kalkulator/emisi-karbon${edisiParam}`;

const labelKonsumsiBbm = us ? t("pub.kalk.karbonIceUs") : t("pub.kalk.karbonIce");
const labelKonsumsiListrik = us ? t("pub.kalk.karbonEvUs") : t("pub.kalk.karbonEv");
---

<Base
  title={t("pub.kalk.karbonTitle")}
  description={t("pub.kalk.karbonSub")}
  ogImage={site.seoOgImage}
  site={site}
>
  <SiteHeader site={site} lang={lang} t={t} region={region} />
  <link slot="head" rel="canonical" href={canonical} />

  <main class="container kalk" id="konten">
    <nav class="breadcrumb" aria-label={t("pub.breadcrumb")}>
      <a href={edisiBase || "/"}>{t("pub.nav.beranda")}</a>
      <span aria-hidden="true">/</span>
      <span class="breadcrumb-current">{t("pub.kalk.karbonTitle")}</span>
    </nav>

    <header class="kalk-head">
      <h1>{t("pub.kalk.karbonTitle")}</h1>
      <p class="kalk-lead">{t("pub.kalk.karbonSub")}</p>
    </header>

    <form id="karbonForm" class="kalk-form" method="get" autocomplete="off">
      {region === "id" ? null : <input type="hidden" name="region" value={region} />}
      <div class="kalk-grid">
        <div class="kalk-field">
          <label for="karbonJarak">{t("pub.kalk.karbonKm", { unit: satuan })}</label>
          <input id="karbonJarak" name="jarak" type="number" min="0" step="any" value={form.jarak} />
        </div>
        <div class="kalk-field">
          <label for="karbonBbm">{labelKonsumsiBbm}</label>
          <input id="karbonBbm" name="bbm" type="number" min="0" step="any" value={form.bbm} />
        </div>
        <div class="kalk-field">
          <label for="karbonEv">{labelKonsumsiListrik}</label>
          <input id="karbonEv" name="ev" type="number" min="0" step="any" value={form.ev} />
        </div>
        <div class="kalk-field">
          <label for="karbonFaktor">{t("pub.kalk.karbonFaktor")}</label>
          <input id="karbonFaktor" name="faktor" type="number" min="0" step="any" value={form.faktor} />
        </div>
      </div>
      <button type="submit" name="hitung" value="1" class="btn btn-primary">{t("pub.kalk.hitung")}</button>
    </form>

    {tampil ? (
      <div id="karbonResult" class="kalk-result">
        <div class="kalk-cards">
          <div class="kalk-card">
            <span class="kalk-card-label">{t("pub.kalk.karbonEmisiBensin")}</span>
            <strong class="kalk-card-value">{emisi(hasil.co2BbmKg)}</strong>
            <span class="kalk-card-sub">{t("pub.kalk.perTahun", { unit: satuanCo2 })}</span>
          </div>
          <div class="kalk-card">
            <span class="kalk-card-label">{t("pub.kalk.karbonEmisiEv")}</span>
            <strong class="kalk-card-value">{emisi(hasil.co2EvKg)}</strong>
            <span class="kalk-card-sub">{t("pub.kalk.perTahun", { unit: satuanCo2 })}</span>
          </div>
          <div class="kalk-card kalk-card-accent">
            <span class="kalk-card-label">{t("pub.kalk.karbonHemat")}</span>
            <strong class="kalk-card-value">{emisi(hasil.hematKg)}</strong>
            <span class="kalk-card-sub">{t("pub.kalk.perTahun", { unit: satuanCo2 })}</span>
          </div>
          <div class="kalk-card">
            <span class="kalk-card-label">{t("pub.kalk.karbonPohon")}</span>
            <strong class="kalk-card-value">{angka(hasil.pohon)}</strong>
            <span class="kalk-card-sub">{t("pub.kalk.pohonPerTahun")}</span>
          </div>
        </div>
        <p class="kalk-hint">{t("pub.kalk.catatanPerkiraan")}</p>
      </div>
    ) : null}
  </main>

  <SiteFooter site={site} lang={lang} t={t} content={content} />
</Base>
