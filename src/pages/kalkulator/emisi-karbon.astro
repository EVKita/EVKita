---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { readContent } from "../../lib/store";
import { makePubT, normalizePubLocale, cmsSite } from "../../lib/i18n/pub.js";
import { terjemahContent } from "../../lib/terjemahan.js";

const content = await terjemahContent(readContent(), Astro.locals?.pubLang);
const lang = normalizePubLocale(Astro.locals?.pubLang);
const t = makePubT(lang);
const site = cmsSite(content.site, lang);
---

<Base>
  <SiteHeader site={site} lang={lang} t={t} />
  <main class="container kalk" id="konten">
    <nav class="breadcrumb" aria-label={t("pub.breadcrumb")}>
      <a href="/">{t("pub.nav.beranda")}</a>
      <span aria-hidden="true">/</span>
      <span class="breadcrumb-current">{t("pub.kalk.karbonTitle")}</span>
    </nav>
    <header class="kalk-head">
      <h1>{t("pub.kalk.karbonTitle")}</h1>
      <p class="kalk-lead">{t("pub.kalk.karbonSub")}</p>
    </header>
    <form id="karbonForm" class="kalk-form">
      <div class="kalk-grid">
        <div class="kalk-field">
          <label for="kKm">{t("pub.kalk.karbonKm")}</label>
          <input id="kKm" type="number" value="15000" />
        </div>
        <div class="kalk-field">
          <label for="kIce">{t("pub.kalk.karbonIce")}</label>
          <input id="kIce" type="number" step="0.1" value="8" />
        </div>
        <div class="kalk-field">
          <label for="kEv">{t("pub.kalk.karbonEv")}</label>
          <input id="kEv" type="number" step="0.1" value="18" />
        </div>
        <div class="kalk-field">
          <label for="kFaktor">{t("pub.kalk.karbonFaktor")}</label>
          <input id="kFaktor" type="number" step="0.01" value="0.85" />
        </div>
      </div>
      <button type="submit" class="btn btn-primary">{t("pub.kalk.hitung")}</button>
    </form>
    <div id="karbonResult" class="kalk-result" hidden></div>
  </main>
  <SiteFooter site={site} lang={lang} t={t} content={content} />
  <script>
    (function () {
      const form = document.getElementById("karbonForm");
      const res = document.getElementById("karbonResult");
      if (!form || !res) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const km = Number(document.getElementById("kKm").value) || 0;
        const ice = Number(document.getElementById("kIce").value) || 0;
        const ev = Number(document.getElementById("kEv").value) || 0;
        const faktor = Number(document.getElementById("kFaktor").value) || 0;
        const literIce = km * ice / 100;
        const kwhEv = km * ev / 100;
        const co2Ice = literIce * 2.31;
        const co2Ev = kwhEv * faktor / 1000;
        const hemat = co2Ice - co2Ev;
        const pohon = hemat / 21;
        res.hidden = false;
        res.innerHTML = `
          <div class="kalk-cards">
            <div class="kalk-card">
              <span class="kalk-card-label">Emisi CO\u2082 mobil bensin</span>
              <strong class="kalk-card-value">${Math.round(co2Ice).toLocaleString("id-ID")} kg/thn</strong>
            </div>
            <div class="kalk-card">
              <span class="kalk-card-label">Emisi CO\u2082 mobil listrik</span>
              <strong class="kalk-card-value">${Math.round(co2Ev).toLocaleString("id-ID")} kg/thn</strong>
            </div>
            <div class="kalk-card kalk-card-accent">
              <span class="kalk-card-label">Hemat emisi</span>
              <strong class="kalk-card-value">${Math.round(hemat).toLocaleString("id-ID")} kg/thn</strong>
            </div>
            <div class="kalk-card">
              <span class="kalk-card-label">Setara menanam pohon</span>
              <strong class="kalk-card-value">${Math.round(pohon)} pohon/tahun</strong>
            </div>
          </div>
        `;
      });
    })();
  </script>
</Base>
