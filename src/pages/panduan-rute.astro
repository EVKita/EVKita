---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { readContent } from "../lib/store";
import { hanyaTayang } from "../lib/tayang.js";
import { safeUrl } from "../lib/url.js";
import { filterWilayah, regionDariParam, istilahCas } from "../lib/region.js";
import { makePubT, normalizePubLocale, cmsSite } from "../lib/i18n/pub.js";
import { terjemahContent } from "../lib/terjemahan.js";

const content = await terjemahContent(readContent(), Astro.locals?.pubLang);
const lang = normalizePubLocale(Astro.locals?.pubLang);
const t = makePubT(lang);
const site = cmsSite(content.site, lang);
const region = regionDariParam(Astro.url.searchParams.get("region"));
const spkluList = filterWilayah(content.spklu, region).filter(hanyaTayang());

/* Nama peta: edisi China memakai Amap (高德地图) — layanan peta China yang
   paling mirip Google Maps; Google sendiri tidak bisa dipakai di sana. */
const petaNama = region === "cn" ? "高德地图" : "Google Maps";
const petaCari = region === "cn" ? t("pub.rute.cariAmap") : t("pub.rute.cariGoogle");
const tipTempel = region === "cn" ? t("pub.rute.tambahPetaCn") : t("pub.rute.tempelTip");

/* Judul seksi & tombol lihat-semua memakai istilah TETAP edisi (Charging/
   充电站) — tidak pernah "SPKLU" di edisi Amerika dan China. */
const spkluJudul =
  region === "id" ? t("pub.rute.spkluTerdekat") : t(region === "us" ? "pub.region.spkluTitle" : "pub.region.cnSpkluTitle");
const spkluSemuaLabel = region === "id" ? t("pub.rute.lihatSemuaSpklu") : t(istilahCas(region, "semua"));
const spkluSemuaHref = region === "id" ? "/spklu" : region === "us" ? "/amerika#spklu" : "/china#spklu";
const petaLabel = t(istilahCas(region, "peta"));

const K = (v: any) => ({
  id: v.id,
  name: v.name,
  operator: v.operator,
  area: v.area,
  address: v.address,
  power: v.power,
  connector: v.connector,
  jenis: v.jenis,
  arus: v.arus,
  website: safeUrl(v.website),
  mapUrl: safeUrl(v.mapUrl),
  image: safeUrl(v.image),
});
const spkluLite = spkluList.map(K);
---

<Base title={t("pub.rute.title")} site={site}>
  <SiteHeader site={site} lang={lang} t={t} region={region} />
  <main class="container rute-main">
    <header class="rute-head">
      <h1>{t("pub.rute.title")}</h1>
      <p class="rute-sub">{t("pub.rute.sub")}</p>
    </header>

    <form id="ruteForm" class="rute-form" data-region={region}>
      <label>{t("pub.rute.asal")} <input type="text" id="ruteAsal" placeholder="Nama tempat, -6.2,106.8, atau tautan peta" /></label>
      <div class="rute-btn-row">
        <button type="button" class="btn btn-ghost btn-sm" id="ruteGps">📍 {t("pub.rute.gps")}</button>
        <button type="button" class="rute-gbtn" id="ruteAsalGoogle" title={t("pub.rute.lokasiPerkiraan")} aria-label={t("pub.rute.lokasiPerkiraan")}><span class="rute-g">{region === "cn" ? "◎" : "G"}</span></button>
      </div>

      <label>{t("pub.rute.tujuan")} <input type="text" id="ruteTujuan" placeholder="Nama tempat, -6.9,107.6, atau tautan peta" /></label>
      <div class="rute-btn-row">
        <button type="button" class="rute-gbtn" id="ruteTujuanGoogle" title={petaCari} aria-label={petaCari}><span class={`rute-g${region === "cn" ? " wide" : ""}`}>{region === "cn" ? "高德" : "G"}</span></button>
        <span class="rute-tip">{tipTempel}</span>
      </div>

      <button type="submit" class="btn btn-primary">{t("pub.rute.hitung")}</button>
    </form>

    <div id="ruteResult" class="rute-result" hidden></div>

    <div class="rute-save" id="ruteSave" hidden>
      <button type="button" class="btn btn-ghost btn-sm" id="ruteSaveBtn">{t("pub.rute.simpan")}</button>
      <a class="btn btn-ghost btn-sm" href={region === "id" ? "/rute-tersimpan" : `/rute-tersimpan?region=${region}`}>{t("pub.rute.ruteTersimpan")}</a>
    </div>

    <section class="rute-list">
      <h2>{spkluJudul}</h2>
      <div id="ruteSpklu" class="rute-spklu"></div>
      <p><a class="btn btn-outline btn-sm" href={spkluSemuaHref}>{spkluSemuaLabel} →</a></p>
    </section>
  </main>
  <SiteFooter site={site} lang={lang} t={t} content={content} />

  <script
    define:vars={{
      spkluLite,
      region,
      petaNama,
      spkluKosong: t("pub.rute.spkluKosong"),
      petaLabel,
      labelAsal: t("pub.rute.hasilAsal"),
      labelTujuan: t("pub.rute.hasilTujuan"),
      jarakLurus: t("pub.rute.jarakLurus"),
      waktuTempuh: t("pub.rute.waktuTempuh"),
      menit: t("pub.peng.menit"),
      bukaDi: t("pub.rute.bukaDi"),
      mencari: t("pub.rute.mencari"),
      tidakDitemukan: t("pub.rute.tidakDitemukan"),
      gpsGagal: t("pub.rute.gpsGagal"),
      gpsTakDidukung: t("pub.rute.gpsTakDidukung"),
      gpsPerkiraan: t("pub.rute.gpsPerkiraan"),
      asalPerkiraan: t("pub.rute.asalDiisiPerkiraan"),
      simpan: t("pub.rute.simpan"),
      tersimpanOk: t("pub.rute.tersimpanOk"),
    }}
  >
    window.__RUTE__ = {
      spklu: spkluLite, region, petaNama, spkluKosong, petaLabel,
      labelAsal, labelTujuan, jarakLurus, waktuTempuh, menit, bukaDi,
      mencari, tidakDitemukan, gpsGagal, gpsTakDidukung, gpsPerkiraan, asalPerkiraan,
      simpan, tersimpanOk,
    };
  </script>
  <script>
    (function () {
      const R = window.__RUTE__ || {};
      const spklu = Array.isArray(R.spklu) ? R.spklu : [];
      const IS_CN = R.region === "cn";
      const form = document.getElementById("ruteForm");
      const res = document.getElementById("ruteResult");
      const list = document.getElementById("ruteSpklu");

      function haversine(a, b) {
        const Rk = 6371;
        const toRad = (x) => x * Math.PI / 180;
        const dLat = toRad(b.lat - a.lat);
        const dLng = toRad(b.lng - a.lng);
        const x = Math.sin(dLat/2)*Math.sin(dLat/2) + Math.cos(toRad(a.lat))*Math.cos(toRad(b.lat))*Math.sin(dLng/2)*Math.sin(dLng/2);
        return 2 * Rk * Math.asin(Math.sqrt(x));
      }
      /* WGS84 → GCJ-02. Amap/Baidu memakai GCJ-02, bukan WGS84 (yang dipakai
         GPS & geokode), jadi tautan peta China digeser dulu supaya titiknya
         tepat — tanpa ini lokasinya meleset beberapa ratus meter. */
      function gcj(lat, lng) {
        if (!IS_CN) return { lat, lng };
        if (lng < 72.004 || lng > 137.8347 || lat < 0.8293 || lat > 55.8271) return { lat, lng };
        const a = 6378245, ee = 0.00669342162296594323;
        const tLat = (x, y) => {
          let r = -100 + 2*x + 3*y + 0.2*y*y + 0.1*x*y + 0.2*Math.sqrt(Math.abs(x));
          r += (20*Math.sin(6*x*Math.PI) + 20*Math.sin(2*x*Math.PI)) * 2/3;
          r += (20*Math.sin(y*Math.PI) + 40*Math.sin(y/3*Math.PI)) * 2/3;
          r += (160*Math.sin(y/12*Math.PI) + 320*Math.sin(y*Math.PI/30)) * 2/3;
          return r;
        };
        const tLng = (x, y) => {
          let r = 300 + x + 2*y + 0.1*x*x + 0.1*x*y + 0.1*Math.sqrt(Math.abs(x));
          r += (20*Math.sin(6*x*Math.PI) + 20*Math.sin(2*x*Math.PI)) * 2/3;
          r += (20*Math.sin(x*Math.PI) + 40*Math.sin(x/3*Math.PI)) * 2/3;
          r += (150*Math.sin(x/12*Math.PI) + 300*Math.sin(x/30*Math.PI)) * 2/3;
          return r;
        };
        const dLat0 = tLat(lng - 105, lat - 35), dLng0 = tLng(lng - 105, lat - 35);
        const radLat = lat/180*Math.PI;
        let magic = Math.sin(radLat); magic = 1 - ee*magic*magic;
        const sq = Math.sqrt(magic);
        const dLat = (dLat0*180)/((a*(1-ee))/(magic*sq)*Math.PI);
        const dLng = (dLng0*180)/(a/sq*Math.cos(radLat)*Math.PI);
        return { lat: lat + dLat, lng: lng + dLng };
      }
      function parseCoord(s) {
        const str = String(s == null ? "" : s).trim();
        const parts = str.split(",").map((x) => Number(x.trim()));
        if (parts.length === 2 && Number.isFinite(parts[0]) && Number.isFinite(parts[1]) && Math.abs(parts[0]) <= 90 && Math.abs(parts[1]) <= 180) return { lat: parts[0], lng: parts[1] };
        const pola = [
          /!3d(-?\d+(?:\.\d+)?)!4d(-?\d+(?:\.\d+)?)/,
          /@(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/,
          /[?&](?:q|ll|center|query|daddr|destination|position)=(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/
        ];
        for (const rx of pola) {
          const m = str.match(rx);
          if (m) {
            const lat = Number(m[1]), lng = Number(m[2]);
            if (Number.isFinite(lat) && Number.isFinite(lng) && Math.abs(lat) <= 90 && Math.abs(lng) <= 180) return { lat, lng };
          }
        }
        return null;
      }
      async function geocode(q) {
        const c = parseCoord(q);
        if (c) return { coord: c, label: q.trim() };
        const r = await fetch("/api/geocode?q=" + encodeURIComponent(q), { headers: { Accept: "application/json" } });
        const data = await r.json();
        if (!r.ok || !data || !data.ok) throw new Error("notfound");
        return { coord: { lat: Number(data.lat), lng: Number(data.lng) }, label: data.label || q };
      }
      function escapeHtml(s) {
        return String(s === null || s === undefined ? "" : s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
      }
      function safeHref(u, fallback) {
        const v = String(u == null ? "" : u).trim();
        if (/^https?:\/\//i.test(v) || v.startsWith("/")) return v;
        return fallback || "";
      }
      function petaHome() { return IS_CN ? "https://www.amap.com/" : "https://www.google.com/maps"; }
      function petaCariUrl(v) {
        return IS_CN
          ? "https://www.amap.com/search?query=" + encodeURIComponent(v)
          : "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent(v);
      }
      function petaKartu(s) {
        const nama = String(s.name || "") + (IS_CN ? " 充电站" : " charging");
        return safeHref(s.mapUrl, "") || (IS_CN
          ? "https://www.amap.com/search?query=" + encodeURIComponent(nama)
          : "https://www.google.com/maps/search/" + encodeURIComponent(nama));
      }
      function ruteUrl(a, b) {
        if (IS_CN) {
          const p = gcj(a.lat, a.lng), q = gcj(b.lat, b.lng);
          return "https://uri.amap.com/navigation?from=" + p.lng + "," + p.lat + "&to=" + q.lng + "," + q.lat + "&mode=car&coordinate=gaode&callnative=1";
        }
        return "https://www.google.com/maps/dir/?api=1&origin=" + a.lat + "," + a.lng + "&destination=" + b.lat + "," + b.lng;
      }
      function renderSpklu() {
        if (!list) return;
        if (!spklu.length) { list.innerHTML = "<p>" + escapeHtml(R.spkluKosong) + "</p>"; return; }
        list.innerHTML = spklu.map((s) => {
          const gambar = s.image ? `<a class="rute-spklu-img" href="${escapeHtml(petaKartu(s))}" target="_blank" rel="noopener"><img src="${escapeHtml(s.image)}" alt="${escapeHtml(s.name)}" loading="lazy" decoding="async" /></a>` : "";
          const meta = [s.operator, s.area, s.power ? String(s.power) + " kW" : "", s.connector]
            .filter(Boolean).map((x) => `<span>${escapeHtml(x)}</span>`).join("");
          const situs = s.website ? `<a href="${escapeHtml(s.website)}" target="_blank" rel="noopener">Situs →</a>` : "";
          return `<article class="rute-spklu-card">${gambar}<div class="rute-spklu-body"><strong>${escapeHtml(s.name)}</strong>${meta}<div class="rute-spklu-links"><a href="${escapeHtml(petaKartu(s))}" target="_blank" rel="noopener">${escapeHtml(R.petaLabel)} →</a>${situs}</div></div></article>`;
        }).join("");
      }

      const saveWrap = document.getElementById("ruteSave");
      const saveBtn = document.getElementById("ruteSaveBtn");
      let lastRoute = null;

      function isiAsal(coord, label) {
        const el = document.getElementById("ruteAsal");
        if (!el) return;
        el.value = Number(coord.lat).toFixed(6) + "," + Number(coord.lng).toFixed(6);
        el.dataset.label = label || "";
      }
      async function perkiraanLokasi() {
        const r = await fetch("/api/lokasi-saya", { headers: { Accept: "application/json" } });
        const d = await r.json();
        if (r.ok && d && d.ok) return d;
        throw new Error((d && d.error) || "gagal");
      }

      const gpsBtn = document.getElementById("ruteGps");
      if (gpsBtn) gpsBtn.addEventListener("click", () => {
        const gagal = (pesan) => { if (res) { res.hidden = false; res.textContent = pesan; } };
        if (!navigator.geolocation) {
          perkiraanLokasi()
            .then((d) => { isiAsal(d, d.label); gagal(R.gpsPerkiraan.replace("{label}", d.label || "")); })
            .catch(() => gagal(R.gpsTakDidukung));
          return;
        }
        navigator.geolocation.getCurrentPosition(
          (pos) => { isiAsal({ lat: pos.coords.latitude, lng: pos.coords.longitude }, ""); if (res) res.hidden = true; },
          () => {
            perkiraanLokasi()
              .then((d) => { isiAsal(d, d.label); gagal(R.gpsPerkiraan.replace("{label}", d.label || "")); })
              .catch(() => gagal(R.gpsGagal));
          },
          { enableHighAccuracy: true, timeout: 10000 }
        );
      });

      const ogBtn = document.getElementById("ruteAsalGoogle");
      if (ogBtn) ogBtn.addEventListener("click", () => {
        ogBtn.disabled = true;
        perkiraanLokasi()
          .then((d) => { isiAsal(d, d.label); if (res) { res.hidden = false; res.textContent = R.asalPerkiraan.replace("{label}", d.label || ""); } })
          .catch(() => { window.open(petaHome(), "_blank", "noopener"); })
          .finally(() => { ogBtn.disabled = false; });
      });

      const tgBtn = document.getElementById("ruteTujuanGoogle");
      if (tgBtn) tgBtn.addEventListener("click", () => {
        const el = document.getElementById("ruteTujuan");
        const v = el && el.value ? el.value.trim() : "";
        const url = !v ? petaHome() : (/^https?:\/\//i.test(v) ? v : petaCariUrl(v));
        window.open(url, "_blank", "noopener");
      });

      if (navigator.permissions && navigator.permissions.query) {
        navigator.permissions.query({ name: "geolocation" }).then((p) => {
          if (p.state !== "granted") return;
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              const el = document.getElementById("ruteAsal");
              if (el && !el.value) el.value = pos.coords.latitude.toFixed(6) + "," + pos.coords.longitude.toFixed(6);
            },
            () => {}
          );
        }).catch(() => {});
      }

      if (form) form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const asalVal = document.getElementById("ruteAsal").value;
        const tujuanVal = document.getElementById("ruteTujuan").value;
        if (res) { res.hidden = false; res.textContent = R.mencari; }
        if (saveWrap) saveWrap.hidden = true;
        let A, B, ga, gb;
        try {
          ga = await geocode(asalVal);
          gb = await geocode(tujuanVal);
          A = ga.coord; B = gb.coord;
        } catch (err) {
          if (res) res.textContent = R.tidakDitemukan;
          return;
        }
        const d = haversine(A, B);
        if (res) {
          res.innerHTML = `<p>${escapeHtml(R.labelAsal)}: ${escapeHtml(ga.label)} (${A.lat.toFixed(5)},${A.lng.toFixed(5)})</p><p>${escapeHtml(R.labelTujuan)}: ${escapeHtml(gb.label)} (${B.lat.toFixed(5)},${B.lng.toFixed(5)})</p><p>${escapeHtml(R.jarakLurus)}: <strong>${Math.round(d).toLocaleString("id-ID")} km</strong></p><p>${escapeHtml(R.waktuTempuh)}: <strong>${R.menit.replace("{n}", String(Math.round(d)))}</strong></p><p><a class="btn btn-outline btn-sm" href="${ruteUrl(A, B)}" target="_blank" rel="noopener">${escapeHtml(R.bukaDi.replace("{peta}", R.petaNama))} →</a></p>`;
          if (!IS_CN) {
            const embed = "https://maps.google.com/maps?saddr=" + A.lat + "," + A.lng + "&daddr=" + B.lat + "," + B.lng + "&z=8&output=embed";
            res.innerHTML += `<iframe class="rute-map" src="${embed}" title="${escapeHtml(R.petaNama)}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>`;
          }
        }
        if (saveWrap) saveWrap.hidden = false;
        lastRoute = { asal: asalVal, tujuan: tujuanVal, jarak: Math.round(d), tgl: new Date().toISOString() };
        renderSpklu();
      });

      if (saveBtn) saveBtn.addEventListener("click", () => {
        if (!lastRoute) return;
        const key = "evkita_rute_tersimpan";
        let arr = [];
        try { arr = JSON.parse(localStorage.getItem(key) || "[]"); } catch { arr = []; }
        if (!Array.isArray(arr)) arr = [];
        arr.unshift(lastRoute);
        arr = arr.slice(0, 20);
        try { localStorage.setItem(key, JSON.stringify(arr)); } catch {}
        saveBtn.textContent = R.tersimpanOk;
        setTimeout(() => { saveBtn.textContent = R.simpan; }, 1500);
      });

      renderSpklu();
    })();
  </script>
  <style>
    .rute-main { padding: 2rem 1rem 4rem; max-width: 900px; margin: 0 auto; }
    .rute-head h1 { margin: 0 0 .25rem; }
    .rute-sub { color: var(--muted, #64748b); margin: 0 0 1.5rem; }
    .rute-form { display: grid; gap: .75rem; max-width: 520px; }
    .rute-form label { display: flex; flex-direction: column; gap: .25rem; font-size: .9rem; }
    .rute-form input { padding: .5rem .6rem; border: 1px solid var(--border, #e2e8f0); border-radius: 8px; font-size: 1rem; }
    .rute-btn-row { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem; margin-top: -.35rem; }
    .rute-tip { font-size: .78rem; color: var(--muted, #64748b); flex: 1 1 220px; }
    .rute-gbtn { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 34px; padding: 0 .4rem; border: 1px solid var(--border, #e2e8f0); border-radius: 8px; background: var(--card, #fff); cursor: pointer; }
    .rute-gbtn:hover { border-color: #4285f4; box-shadow: 0 0 0 2px rgba(66,133,244,.15); }
    .rute-gbtn:disabled { opacity: .6; cursor: progress; }
    .rute-g { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 50%; background: #4285f4; color: #fff; font-weight: 700; font-size: .8rem; font-family: Arial, sans-serif; }
    .rute-g.wide { width: auto; padding: 0 .45rem; border-radius: 10px; font-size: .72rem; }
    .rute-result { margin: 1.5rem 0; padding: 1rem; border: 1px solid var(--border, #e2e8f0); border-radius: 12px; background: var(--card, #fff); }
    .rute-map { width: 100%; height: 360px; margin-top: 1rem; border: 1px solid var(--border, #e2e8f0); border-radius: 12px; }
    .rute-list { margin-top: 2rem; }
    .rute-spklu { display: grid; gap: .75rem; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); margin-top: .75rem; }
    .rute-spklu-card { display: grid; gap: .25rem; border: 1px solid var(--border, #e2e8f0); border-radius: 10px; overflow: hidden; background: var(--card, #fff); }
    .rute-spklu-img { display: block; aspect-ratio: 16 / 9; background: #e2e8f0; }
    .rute-spklu-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .rute-spklu-body { display: grid; gap: .2rem; padding: .65rem .75rem .75rem; font-size: .88rem; }
    .rute-spklu-body span { color: var(--muted, #64748b); }
    .rute-spklu-links { display: flex; gap: .75rem; margin-top: .3rem; }
    .rute-spklu-links a { font-weight: 600; }
  </style>
</Base>
