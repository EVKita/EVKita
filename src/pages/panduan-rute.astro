---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { readContent } from "../lib/store";
import { hanyaTayang } from "../lib/tayang.js";
import { safeUrl } from "../lib/url.js";
import { filterWilayah, regionDariParam } from "../lib/region.js";
import { makePubT, normalizePubLocale, cmsSite } from "../lib/i18n/pub.js";
import { terjemahContent } from "../lib/terjemahan.js";

const content = await terjemahContent(readContent(), Astro.locals?.pubLang);
const lang = normalizePubLocale(Astro.locals?.pubLang);
const t = makePubT(lang);
const site = cmsSite(content.site, lang);
const region = regionDariParam(Astro.url.searchParams.get("region"));
const spkluList = filterWilayah(content.spklu, region).filter(hanyaTayang());

const K = (v: any) => ({ id: v.id, name: v.name, lat: v.lat, lng: v.lng, area: v.area, address: v.address, power: v.power, connector: v.connector, price: v.price, mapUrl: v.mapUrl });
const spkluLite = spkluList.map(K);
---

<Base title={t("pub.rute.title")} site={site}>
  <SiteHeader site={site} lang={lang} t={t} region={region} />
  <main class="container rute-main">
    <header class="rute-head">
      <h1>{t("pub.rute.title")}</h1>
      <p class="rute-sub">{t("pub.rute.sub")}</p>
    </header>
    <form id="ruteForm" class="rute-form" data-region={region}>
      <label>{t("pub.rute.asal")} <input type="text" id="ruteAsal" placeholder="Nama tempat, -6.2,106.8, atau tautan Google Maps" /></label>
      <button type="button" class="btn btn-ghost btn-sm" id="ruteGps">📍 Gunakan lokasi saya</button>
      <label>{t("pub.rute.tujuan")} <input type="text" id="ruteTujuan" placeholder="Nama tempat, -6.9,107.6, atau tautan Google Maps" /></label>
      <div class="rute-google-row">
        <a class="rute-google" id="ruteCariAsal" data-target="ruteAsal" href="https://www.google.com/maps" target="_blank" rel="noopener" title={t("pub.rute.cariGoogle")}><span class="rute-g">G</span> {t("pub.rute.cariGoogle")}</a>
        <a class="rute-google" id="ruteCariTujuan" data-target="ruteTujuan" href="https://www.google.com/maps" target="_blank" rel="noopener" title={t("pub.rute.cariGoogle")}><span class="rute-g">G</span> {t("pub.rute.cariGoogle")}</a>
      </div>
      <button type="submit" class="btn btn-primary">{t("pub.rute.hitung")}</button>
    </form>
    <div id="ruteResult" class="rute-result" hidden></div>
    <div class="rute-save" id="ruteSave" hidden>
      <button type="button" class="btn btn-ghost btn-sm" id="ruteSaveBtn">Simpan rute ini</button>
      <a class="btn btn-ghost btn-sm" href="/rute-tersimpan">Rute tersimpan</a>
    </div>
    <section class="rute-list">
      <h2>{t("pub.rute.spkluTerdekat")}</h2>
      <div id="ruteSpklu" class="rute-spklu"></div>
    </section>
  </main>
  <SiteFooter site={site} lang={lang} t={t} content={content} />
  <script define:vars={{ spkluLite }}>
    window.__RUTE_SPKLU__ = spkluLite;
  </script>
  <script>
    (function () {
      const spklu = Array.isArray(window.__RUTE_SPKLU__) ? window.__RUTE_SPKLU__ : [];
      const form = document.getElementById("ruteForm");
      const res = document.getElementById("ruteResult");
      const list = document.getElementById("ruteSpklu");
      function haversine(a, b) {
        const R = 6371;
        const toRad = (x) => x * Math.PI / 180;
        const dLat = toRad(b.lat - a.lat);
        const dLng = toRad(b.lng - a.lng);
        const x = Math.sin(dLat/2)*Math.sin(dLat/2) + Math.cos(toRad(a.lat))*Math.cos(toRad(b.lat))*Math.sin(dLng/2)*Math.sin(dLng/2);
        return 2 * R * Math.asin(Math.sqrt(x));
      }
      function parseCoord(s) {
        const str = String(s == null ? "" : s).trim();
        const parts = str.split(",").map((x) => Number(x.trim()));
        if (parts.length === 2 && Number.isFinite(parts[0]) && Number.isFinite(parts[1]) && Math.abs(parts[0]) <= 90 && Math.abs(parts[1]) <= 180) return { lat: parts[0], lng: parts[1] };
        const pola = [
          /!3d(-?\d+(?:\.\d+)?)!4d(-?\d+(?:\.\d+)?)/,
          /@(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/,
          /[?&](?:q|ll|center|query|daddr|destination)=(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/
        ];
        for (const rx of pola) {
          const m = str.match(rx);
          if (m) {
            const lat = Number(m[1]), lng = Number(m[2]);
            if (Number.isFinite(lat) && Number.isFinite(lng) && Math.abs(lat) <= 90 && Math.abs(lng) <= 180) return { lat, lng };
          }
        }
        return null;
      }
      async function geocode(q) {
        const c = parseCoord(q);
        if (c) return { coord: c, label: q.trim() };
        const r = await fetch("/api/geocode?q=" + encodeURIComponent(q), { headers: { Accept: "application/json" } });
        const data = await r.json();
        if (!r.ok || !data || !data.ok) throw new Error("notfound");
        return { coord: { lat: Number(data.lat), lng: Number(data.lng) }, label: data.label || q };
      }
      function renderSpklu(ref) {
        if (!list) return;
        const sorted = spklu
          .filter((s) => Number.isFinite(Number(s.lat)) && Number.isFinite(Number(s.lng)))
          .map((s) => ({ s, d: ref ? haversine(ref, { lat: Number(s.lat), lng: Number(s.lng) }) : Infinity }))
          .sort((a, b) => a.d - b.d)
          .slice(0, 8);
        list.innerHTML = sorted.map((x) => {
          const s = x.s;
          const url = s.mapUrl ? s.mapUrl : "https://www.google.com/maps/search/" + encodeURIComponent(s.name + " SPKLU");
          return `<div class="rute-spklu-card"><strong>${escapeHtml(s.name)}</strong><span>${escapeHtml(s.area || "")}</span><span>${escapeHtml(s.power ? s.power + " kW" : "")}</span><span>${x.d === Infinity ? "" : Math.round(x.d) + " km"}</span><a href="${escapeHtml(url)}" target="_blank" rel="noopener">Peta →</a></div>`;
        }).join("") || "<p>Tidak ada data SPKLU.</p>";
      }
      function escapeHtml(s) {
        return String(s === null || s === undefined ? "" : s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
      }
      const saveWrap = document.getElementById("ruteSave");
      const saveBtn = document.getElementById("ruteSaveBtn");
      let lastRoute = null;
      const gpsBtn = document.getElementById("ruteGps");
      if (gpsBtn) gpsBtn.addEventListener("click", () => {
        if (!navigator.geolocation) { if (res) { res.hidden = false; res.textContent = "Geolokasi tidak didukung peramban ini."; } return; }
        gpsBtn.textContent = "Mencari lokasi...";
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const el = document.getElementById("ruteAsal");
            if (el) el.value = pos.coords.latitude.toFixed(6) + "," + pos.coords.longitude.toFixed(6);
            gpsBtn.textContent = "📍 Gunakan lokasi saya";
          },
          (err) => {
            if (res) { res.hidden = false; res.textContent = "Gagal mendapatkan lokasi: " + (err && err.message ? err.message : "izin ditolak"); }
            gpsBtn.textContent = "📍 Gunakan lokasi saya";
          },
          { enableHighAccuracy: true, timeout: 10000 }
        );
      });
      document.querySelectorAll(".rute-google").forEach((a) => {
        a.addEventListener("click", () => {
          const el = document.getElementById(a.getAttribute("data-target") || "");
          const v = el && el.value ? el.value.trim() : "";
          if (!v) { a.href = "https://www.google.com/maps"; return; }
          a.href = /^https?:\/\//i.test(v) ? v : "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent(v);
        });
      });
      if (navigator.permissions && navigator.permissions.query) {
        navigator.permissions.query({ name: "geolocation" }).then((p) => {
          if (p.state !== "granted") return;
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              const el = document.getElementById("ruteAsal");
              if (el && !el.value) el.value = pos.coords.latitude.toFixed(6) + "," + pos.coords.longitude.toFixed(6);
            },
            () => {}
          );
        }).catch(() => {});
      }
      if (form) form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const asalVal = document.getElementById("ruteAsal").value;
        const tujuanVal = document.getElementById("ruteTujuan").value;
        if (res) { res.hidden = false; res.textContent = "Mencari lokasi..."; }
        if (saveWrap) saveWrap.hidden = true;
        let A, B;
        try {
          const ga = await geocode(asalVal);
          const gb = await geocode(tujuanVal);
          A = ga.coord; B = gb.coord;
          if (res) res.innerHTML = `<p>Asal: ${escapeHtml(ga.label)} (${A.lat.toFixed(5)},${A.lng.toFixed(5)})</p><p>Tujuan: ${escapeHtml(gb.label)} (${B.lat.toFixed(5)},${B.lng.toFixed(5)})</p>`;
        } catch (err) {
          if (res) res.textContent = "Lokasi tidak ditemukan. Coba nama tempat lain atau koordinat lat,lng.";
          return;
        }
        const d = haversine(A, B);
        const reg = (form && form.getAttribute("data-region")) || "id";
        let mapUrl = "";
        if (reg === "cn") {
          mapUrl = "https://api.map.baidu.com/directions?origin=" + A.lat + "," + A.lng + "&destination=" + B.lat + "," + B.lng + "&mode=driving&region=cn";
        } else {
          mapUrl = "https://www.google.com/maps/dir/?api=1&origin=" + A.lat + "," + A.lng + "&destination=" + B.lat + "," + B.lng;
        }
        if (res) {
          res.innerHTML += `<p>Jarak lurus: <strong>${Math.round(d).toLocaleString("id-ID")} km</strong></p><p>Perkiraan waktu (60 km/jam): <strong>${Math.round(d/60*60)} menit</strong></p><p><a class="btn btn-outline btn-sm" href="${mapUrl}" target="_blank" rel="noopener">Buka rute di ${reg === "cn" ? "Baidu Maps" : "Google Maps"} →</a></p>`;
          if (reg !== "cn") {
            const embed = "https://maps.google.com/maps?saddr=" + A.lat + "," + A.lng + "&daddr=" + B.lat + "," + B.lng + "&z=8&output=embed";
            res.innerHTML += `<iframe class="rute-map" src="${embed}" title="Peta rute" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>`;
          }
        }
        if (saveWrap) saveWrap.hidden = false;
        lastRoute = { asal: asalVal, tujuan: tujuanVal, jarak: Math.round(d), tgl: new Date().toISOString() };
        renderSpklu(B);
      });
      if (saveBtn) saveBtn.addEventListener("click", () => {
        if (!lastRoute) return;
        const key = "evkita_rute_tersimpan";
        let arr = [];
        try { arr = JSON.parse(localStorage.getItem(key) || "[]"); } catch { arr = []; }
        if (!Array.isArray(arr)) arr = [];
        arr.unshift(lastRoute);
        arr = arr.slice(0, 20);
        try { localStorage.setItem(key, JSON.stringify(arr)); } catch {}
        saveBtn.textContent = "Tersimpan ✓";
        setTimeout(() => { saveBtn.textContent = "Simpan rute ini"; }, 1500);
      });
      renderSpklu(null);
    })();
  </script>
  <style>
    .rute-main { padding: 2rem 1rem 4rem; max-width: 900px; margin: 0 auto; }
    .rute-head h1 { margin: 0 0 .25rem; }
    .rute-sub { color: var(--muted, #64748b); margin: 0 0 1.5rem; }
    .rute-form { display: grid; gap: .75rem; max-width: 480px; }
    .rute-form label { display: flex; flex-direction: column; gap: .25rem; font-size: .9rem; }
    .rute-form input { padding: .4rem .6rem; border: 1px solid var(--border, #e2e8f0); border-radius: 8px; }
    .rute-result { margin: 1.5rem 0; padding: 1rem; border: 1px solid var(--border, #e2e8f0); border-radius: 12px; background: var(--card, #fff); }
    .rute-map { width: 100%; height: 360px; margin-top: 1rem; border: 1px solid var(--border, #e2e8f0); border-radius: 12px; }
    .rute-google-row { display: flex; flex-wrap: wrap; gap: .5rem; }
    .rute-google { display: inline-flex; align-items: center; gap: .4rem; padding: .35rem .7rem; border: 1px solid var(--border, #e2e8f0); border-radius: 8px; font-size: .85rem; color: var(--fg, #0f172a); text-decoration: none; background: var(--card, #fff); }
    .rute-google:hover { border-color: #4285f4; }
    .rute-g { display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px; border-radius: 50%; background: #4285f4; color: #fff; font-weight: 700; font-size: .75rem; }
    .rute-list { margin-top: 2rem; }
    .rute-spklu { display: grid; gap: .75rem; margin-top: .75rem; }
    .rute-spklu-card { display: grid; gap: .25rem; padding: .75rem; border: 1px solid var(--border, #e2e8f0); border-radius: 10px; }
  </style>
</Base>
