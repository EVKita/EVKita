---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { readContent } from "../lib/store";
import { hanyaTayang } from "../lib/tayang.js";
import { safeUrl } from "../lib/url.js";
import { filterWilayah, regionDariParam } from "../lib/region.js";
import { makePubT, normalizePubLocale, cmsSite } from "../lib/i18n/pub.js";
import { terjemahContent } from "../lib/terjemahan.js";

const content = await terjemahContent(readContent(), Astro.locals?.pubLang);
const lang = normalizePubLocale(Astro.locals?.pubLang);
const t = makePubT(lang);
const site = cmsSite(content.site, lang);
const region = regionDariParam(Astro.url.searchParams.get("region"));
const spkluList = filterWilayah(content.spklu, region).filter(hanyaTayang());

const K = (v: any) => ({
  id: v.id,
  name: v.name,
  operator: v.operator,
  area: v.area,
  address: v.address,
  power: v.power,
  connector: v.connector,
  jenis: v.jenis,
  arus: v.arus,
  website: safeUrl(v.website),
  mapUrl: safeUrl(v.mapUrl),
  image: safeUrl(v.image),
});
const spkluLite = spkluList.map(K);
---

<Base title={t("pub.rute.title")} site={site}>
  <SiteHeader site={site} lang={lang} t={t} region={region} />
  <main class="container rute-main">
    <header class="rute-head">
      <h1>{t("pub.rute.title")}</h1>
      <p class="rute-sub">{t("pub.rute.sub")}</p>
    </header>

    <form id="ruteForm" class="rute-form" data-region={region}>
      <label>{t("pub.rute.asal")} <input type="text" id="ruteAsal" placeholder="Nama tempat, -6.2,106.8, atau tautan Google Maps" /></label>
      <div class="rute-btn-row">
        <button type="button" class="btn btn-ghost btn-sm" id="ruteGps">📍 Gunakan lokasi saya</button>
        <button type="button" class="rute-gbtn" id="ruteAsalGoogle" title={t("pub.rute.lokasiPerkiraan")} aria-label={t("pub.rute.lokasiPerkiraan")}><span class="rute-g">G</span></button>
      </div>

      <label>{t("pub.rute.tujuan")} <input type="text" id="ruteTujuan" placeholder="Nama tempat, -6.9,107.6, atau tautan Google Maps" /></label>
      <div class="rute-btn-row">
        <button type="button" class="rute-gbtn" id="ruteTujuanGoogle" title={t("pub.rute.cariGoogle")} aria-label={t("pub.rute.cariGoogle")}><span class="rute-g">G</span></button>
        <span class="rute-tip">{t("pub.rute.tempelTip")}</span>
      </div>

      <button type="submit" class="btn btn-primary">{t("pub.rute.hitung")}</button>
    </form>

    <div id="ruteResult" class="rute-result" hidden></div>

    <div class="rute-save" id="ruteSave" hidden>
      <button type="button" class="btn btn-ghost btn-sm" id="ruteSaveBtn">Simpan rute ini</button>
      <a class="btn btn-ghost btn-sm" href="/rute-tersimpan">Rute tersimpan</a>
    </div>

    <section class="rute-list">
      <h2>{t("pub.rute.spkluTerdekat")}</h2>
      <div id="ruteSpklu" class="rute-spklu"></div>
      <p><a class="btn btn-outline btn-sm" href="/spklu">{t("pub.rute.lihatSemuaSpklu")} →</a></p>
    </section>
  </main>
  <SiteFooter site={site} lang={lang} t={t} content={content} />

  <script define:vars={{ spkluLite, spkluKosong: t("pub.rute.spkluKosong") }}>
    window.__RUTE_SPKLU__ = spkluLite;
    window.__RUTE_SPKLU_EMPTY__ = spkluKosong;
  </script>
  <script>
    (function () {
      const spklu = Array.isArray(window.__RUTE_SPKLU__) ? window.__RUTE_SPKLU__ : [];
      const spkluKosong = window.__RUTE_SPKLU_EMPTY__ || "Belum ada data SPKLU.";
      const form = document.getElementById("ruteForm");
      const res = document.getElementById("ruteResult");
      const list = document.getElementById("ruteSpklu");

      function haversine(a, b) {
        const R = 6371;
        const toRad = (x) => x * Math.PI / 180;
        const dLat = toRad(b.lat - a.lat);
        const dLng = toRad(b.lng - a.lng);
        const x = Math.sin(dLat/2)*Math.sin(dLat/2) + Math.cos(toRad(a.lat))*Math.cos(toRad(b.lat))*Math.sin(dLng/2)*Math.sin(dLng/2);
        return 2 * R * Math.asin(Math.sqrt(x));
      }
      function parseCoord(s) {
        const str = String(s == null ? "" : s).trim();
        const parts = str.split(",").map((x) => Number(x.trim()));
        if (parts.length === 2 && Number.isFinite(parts[0]) && Number.isFinite(parts[1]) && Math.abs(parts[0]) <= 90 && Math.abs(parts[1]) <= 180) return { lat: parts[0], lng: parts[1] };
        const pola = [
          /!3d(-?\d+(?:\.\d+)?)!4d(-?\d+(?:\.\d+)?)/,
          /@(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/,
          /[?&](?:q|ll|center|query|daddr|destination)=(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/
        ];
        for (const rx of pola) {
          const m = str.match(rx);
          if (m) {
            const lat = Number(m[1]), lng = Number(m[2]);
            if (Number.isFinite(lat) && Number.isFinite(lng) && Math.abs(lat) <= 90 && Math.abs(lng) <= 180) return { lat, lng };
          }
        }
        return null;
      }
      async function geocode(q) {
        const c = parseCoord(q);
        if (c) return { coord: c, label: q.trim() };
        const r = await fetch("/api/geocode?q=" + encodeURIComponent(q), { headers: { Accept: "application/json" } });
        const data = await r.json();
        if (!r.ok || !data || !data.ok) throw new Error("notfound");
        return { coord: { lat: Number(data.lat), lng: Number(data.lng) }, label: data.label || q };
      }
      function escapeHtml(s) {
        return String(s === null || s === undefined ? "" : s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
      }
      function safeHref(u, fallback) {
        const v = String(u == null ? "" : u).trim();
        if (/^https?:\/\//i.test(v) || v.startsWith("/")) return v;
        return fallback || "";
      }
      function petaUrl(s, reg) {
        const kata = reg === "cn" ? "充电站" : reg === "us" ? "charging station" : "SPKLU";
        return safeHref(s.mapUrl, "") || "https://www.google.com/maps/search/" + encodeURIComponent((s.name || "") + " " + kata);
      }
      function renderSpklu(ref) {
        if (!list) return;
        const reg = (form && form.getAttribute("data-region")) || "id";
        if (!spklu.length) { list.innerHTML = "<p>" + escapeHtml(spkluKosong) + "</p>"; return; }
        const baris = spklu.map((s) => {
          const gambar = s.image ? `<a class="rute-spklu-img" href="${escapeHtml(petaUrl(s, reg))}" target="_blank" rel="noopener"><img src="${escapeHtml(s.image)}" alt="${escapeHtml(s.name)}" loading="lazy" decoding="async" /></a>` : "";
          const meta = [
            s.operator ? escapeHtml(s.operator) : "",
            s.area ? escapeHtml(s.area) : "",
            s.power ? escapeHtml(String(s.power) + " kW") : "",
            s.connector ? escapeHtml(s.connector) : "",
          ].filter(Boolean).map((x) => `<span>${x}</span>`).join("");
          const situs = s.website ? `<a href="${escapeHtml(s.website)}" target="_blank" rel="noopener">Situs →</a>` : "";
          return `<article class="rute-spklu-card">${gambar}<div class="rute-spklu-body"><strong>${escapeHtml(s.name)}</strong>${meta}<div class="rute-spklu-links"><a href="${escapeHtml(petaUrl(s, reg))}" target="_blank" rel="noopener">Peta →</a>${situs}</div></div></article>`;
        }).join("");
        list.innerHTML = baris;
      }

      const saveWrap = document.getElementById("ruteSave");
      const saveBtn = document.getElementById("ruteSaveBtn");
      let lastRoute = null;

      function isiAsal(coord, label) {
        const el = document.getElementById("ruteAsal");
        if (!el) return;
        el.value = Number(coord.lat).toFixed(6) + "," + Number(coord.lng).toFixed(6);
        el.dataset.label = label || "";
      }
      async function perkiraanLokasi() {
        const r = await fetch("/api/lokasi-saya", { headers: { Accept: "application/json" } });
        const d = await r.json();
        if (r.ok && d && d.ok) return d;
        throw new Error((d && d.error) || "gagal");
      }

      const gpsBtn = document.getElementById("ruteGps");
      if (gpsBtn) gpsBtn.addEventListener("click", () => {
        const gagal = (pesan) => {
          if (res) { res.hidden = false; res.textContent = pesan; }
          gpsBtn.textContent = "📍 Gunakan lokasi saya";
        };
        if (!navigator.geolocation) {
          perkiraanLokasi()
            .then((d) => { isiAsal(d, d.label); gagal("GPS tidak didukung. Dipakai perkiraan lokasi " + (d.label || "") + "."); })
            .catch(() => gagal("Geolokasi tidak didukung peramban ini."));
          return;
        }
        gpsBtn.textContent = "Mencari lokasi...";
        navigator.geolocation.getCurrentPosition(
          (pos) => { isiAsal({ lat: pos.coords.latitude, lng: pos.coords.longitude }, ""); gpsBtn.textContent = "📍 Gunakan lokasi saya"; if (res) res.hidden = true; },
          () => {
            perkiraanLokasi()
              .then((d) => { isiAsal(d, d.label); gagal("GPS tidak tersedia. Dipakai perkiraan lokasi " + (d.label || "") + "."); })
              .catch(() => gagal("Gagal mendapatkan lokasi. Izinkan akses lokasi lalu coba lagi."));
          },
          { enableHighAccuracy: true, timeout: 10000 }
        );
      });

      const ogBtn = document.getElementById("ruteAsalGoogle");
      if (ogBtn) ogBtn.addEventListener("click", () => {
        ogBtn.disabled = true;
        perkiraanLokasi()
          .then((d) => { isiAsal(d, d.label); if (res) { res.hidden = false; res.textContent = "Lokasi asal diisi dari perkiraan: " + (d.label || ""); } })
          .catch(() => { window.open("https://www.google.com/maps", "_blank", "noopener"); })
          .finally(() => { ogBtn.disabled = false; });
      });

      const tgBtn = document.getElementById("ruteTujuanGoogle");
      if (tgBtn) tgBtn.addEventListener("click", () => {
        const el = document.getElementById("ruteTujuan");
        const v = el && el.value ? el.value.trim() : "";
        const url = !v ? "https://www.google.com/maps" : (/^https?:\/\//i.test(v) ? v : "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent(v));
        window.open(url, "_blank", "noopener");
      });

      if (navigator.permissions && navigator.permissions.query) {
        navigator.permissions.query({ name: "geolocation" }).then((p) => {
          if (p.state !== "granted") return;
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              const el = document.getElementById("ruteAsal");
              if (el && !el.value) el.value = pos.coords.latitude.toFixed(6) + "," + pos.coords.longitude.toFixed(6);
            },
            () => {}
          );
        }).catch(() => {});
      }

      if (form) form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const asalVal = document.getElementById("ruteAsal").value;
        const tujuanVal = document.getElementById("ruteTujuan").value;
        if (res) { res.hidden = false; res.textContent = "Mencari lokasi..."; }
        if (saveWrap) saveWrap.hidden = true;
        let A, B, ga, gb;
        try {
          ga = await geocode(asalVal);
          gb = await geocode(tujuanVal);
          A = ga.coord; B = gb.coord;
        } catch (err) {
          if (res) res.textContent = "Lokasi tidak ditemukan. Coba nama tempat lain, koordinat lat,lng, atau tautan Google Maps.";
          return;
        }
        const d = haversine(A, B);
        const reg = (form && form.getAttribute("data-region")) || "id";
        let mapUrl = reg === "cn"
          ? "https://api.map.baidu.com/directions?origin=" + A.lat + "," + A.lng + "&destination=" + B.lat + "," + B.lng + "&mode=driving&region=cn"
          : "https://www.google.com/maps/dir/?api=1&origin=" + A.lat + "," + A.lng + "&destination=" + B.lat + "," + B.lng;
        if (res) {
          res.innerHTML = `<p>Asal: ${escapeHtml(ga.label)} (${A.lat.toFixed(5)},${A.lng.toFixed(5)})</p><p>Tujuan: ${escapeHtml(gb.label)} (${B.lat.toFixed(5)},${B.lng.toFixed(5)})</p><p>Jarak lurus: <strong>${Math.round(d).toLocaleString("id-ID")} km</strong></p><p>Perkiraan waktu (60 km/jam): <strong>${Math.round(d/60*60)} menit</strong></p><p><a class="btn btn-outline btn-sm" href="${mapUrl}" target="_blank" rel="noopener">Buka rute di ${reg === "cn" ? "Baidu Maps" : "Google Maps"} →</a></p>`;
          if (reg !== "cn") {
            const embed = "https://maps.google.com/maps?saddr=" + A.lat + "," + A.lng + "&daddr=" + B.lat + "," + B.lng + "&z=8&output=embed";
            res.innerHTML += `<iframe class="rute-map" src="${embed}" title="Peta rute" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>`;
          }
        }
        if (saveWrap) saveWrap.hidden = false;
        lastRoute = { asal: asalVal, tujuan: tujuanVal, jarak: Math.round(d), tgl: new Date().toISOString() };
        renderSpklu(B);
      });

      if (saveBtn) saveBtn.addEventListener("click", () => {
        if (!lastRoute) return;
        const key = "evkita_rute_tersimpan";
        let arr = [];
        try { arr = JSON.parse(localStorage.getItem(key) || "[]"); } catch { arr = []; }
        if (!Array.isArray(arr)) arr = [];
        arr.unshift(lastRoute);
        arr = arr.slice(0, 20);
        try { localStorage.setItem(key, JSON.stringify(arr)); } catch {}
        saveBtn.textContent = "Tersimpan ✓";
        setTimeout(() => { saveBtn.textContent = "Simpan rute ini"; }, 1500);
      });

      renderSpklu(null);
    })();
  </script>
  <style>
    .rute-main { padding: 2rem 1rem 4rem; max-width: 900px; margin: 0 auto; }
    .rute-head h1 { margin: 0 0 .25rem; }
    .rute-sub { color: var(--muted, #64748b); margin: 0 0 1.5rem; }
    .rute-form { display: grid; gap: .75rem; max-width: 520px; }
    .rute-form label { display: flex; flex-direction: column; gap: .25rem; font-size: .9rem; }
    .rute-form input { padding: .5rem .6rem; border: 1px solid var(--border, #e2e8f0); border-radius: 8px; font-size: 1rem; }
    .rute-btn-row { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem; margin-top: -.35rem; }
    .rute-tip { font-size: .78rem; color: var(--muted, #64748b); flex: 1 1 220px; }
    .rute-gbtn { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 34px; padding: 0; border: 1px solid var(--border, #e2e8f0); border-radius: 8px; background: var(--card, #fff); cursor: pointer; }
    .rute-gbtn:hover { border-color: #4285f4; box-shadow: 0 0 0 2px rgba(66,133,244,.15); }
    .rute-gbtn:disabled { opacity: .6; cursor: progress; }
    .rute-g { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 50%; background: #4285f4; color: #fff; font-weight: 700; font-size: .8rem; font-family: Arial, sans-serif; }
    .rute-result { margin: 1.5rem 0; padding: 1rem; border: 1px solid var(--border, #e2e8f0); border-radius: 12px; background: var(--card, #fff); }
    .rute-map { width: 100%; height: 360px; margin-top: 1rem; border: 1px solid var(--border, #e2e8f0); border-radius: 12px; }
    .rute-list { margin-top: 2rem; }
    .rute-spklu { display: grid; gap: .75rem; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); margin-top: .75rem; }
    .rute-spklu-card { display: grid; gap: .25rem; border: 1px solid var(--border, #e2e8f0); border-radius: 10px; overflow: hidden; background: var(--card, #fff); }
    .rute-spklu-img { display: block; aspect-ratio: 16 / 9; background: #e2e8f0; }
    .rute-spklu-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .rute-spklu-body { display: grid; gap: .2rem; padding: .65rem .75rem .75rem; font-size: .88rem; }
    .rute-spklu-body span { color: var(--muted, #64748b); }
    .rute-spklu-links { display: flex; gap: .75rem; margin-top: .3rem; }
    .rute-spklu-links a { font-weight: 600; }
  </style>
</Base>
