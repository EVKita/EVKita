              <div class="field">
                <label for="t-buttonStyle" data-i18n="tampilan.buttonStyle">{t("tampilan.buttonStyle")}</label>
                <select id="t-buttonStyle" name="buttonStyle">
                  {CHOICES.buttonStyle.map((v) => (
                    <option value={v} data-i18n={`tampilan.buttonStyle.${v}`}>{t(`tampilan.buttonStyle.${v}`)}</option>
                  ))}
                </select>
              </div>
              <div class="field">
                <label for="t-buttonShape" data-i18n="tampilan.buttonShape">{t("tampilan.buttonShape")}</label>
                <select id="t-buttonShape" name="buttonShape">
                  {CHOICES.buttonShape.map((v) => (
                    <option value={v} data-i18n={`tampilan.buttonShape.${v}`}>{t(`tampilan.buttonShape.${v}`)}</option>
                  ))}
                </select>
              </div>
            </div>
          </div>

          <!-- Hero -->
          <div class="form-section">
            <div class="form-section-head">
              <h2 data-i18n="tampilan.hero">{t("tampilan.hero")}</h2>
              <p data-i18n="tampilan.hero.desc">{t("tampilan.hero.desc")}</p>
            </div>
            <div class="field-grid">
              <div class="field">
                <label for="t-heroAlign" data-i18n="tampilan.heroAlign">{t("tampilan.heroAlign")}</label>
                <select id="t-heroAlign" name="heroAlign">
                  {CHOICES.heroAlign.map((v) => (
                    <option value={v} data-i18n={`tampilan.heroAlign.${v}`}>{t(`tampilan.heroAlign.${v}`)}</option>
                  ))}
                </select>
              </div>
              <div class="field range-field">
                <label for="t-heroOverlay" data-i18n="tampilan.heroOverlay">{t("tampilan.heroOverlay")}</label>
                <input id="t-heroOverlay" type="range" name="heroOverlay" min="0" max="100" step="5" />
                <output class="range-value" for="t-heroOverlay" data-unit="%"></output>
                <span class="hint" data-i18n="tampilan.heroOverlay.hint">{t("tampilan.heroOverlay.hint")}</span>
              </div>
              <div class="field full">
                <label class="switch-row">
                  <input type="checkbox" name="heroGlow" />
                  <span class="switch" aria-hidden="true"></span>
                  <span data-i18n="tampilan.heroGlow">{t("tampilan.heroGlow")}</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Efek -->
          <div class="form-section">
            <div class="form-section-head">
              <h2 data-i18n="tampilan.fx">{t("tampilan.fx")}</h2>
              <p data-i18n="tampilan.fx.desc">{t("tampilan.fx.desc")}</p>
            </div>
            <div class="field-grid">
              <div class="field full">
                <label class="switch-row">
                  <input type="checkbox" name="fxAnimations" />
                  <span class="switch" aria-hidden="true"></span>
                  <span data-i18n="tampilan.fxAnimations">{t("tampilan.fxAnimations")}</span>
                </label>
              </div>
              <div class="field full">
                <label class="switch-row">
                  <input type="checkbox" name="fxHover" />
                  <span class="switch" aria-hidden="true"></span>
                  <span data-i18n="tampilan.fxHover">{t("tampilan.fxHover")}</span>
                </label>
              </div>
            </div>
          </div>

          <!-- CSS kustom -->
          <div class="form-section">
            <div class="form-section-head">
              <h2 data-i18n="tampilan.css">{t("tampilan.css")}</h2>
              <p data-i18n="tampilan.css.desc">{t("tampilan.css.desc")}</p>
            </div>
            <div class="field-grid">
              <div class="field full">
                <label for="t-customCss" data-i18n="tampilan.customCss">{t("tampilan.customCss")}</label>
                <textarea id="t-customCss" name="customCss" rows="8" spellcheck="false" class="code-area" placeholder={t("tampilan.customCss.ph")} data-i18n-ph="tampilan.customCss.ph"></textarea>
                <span class="hint" data-i18n="tampilan.customCss.hint">{t("tampilan.customCss.hint")}</span>
              </div>
            </div>
          </div>

          <div class="form-actions">
            <span class="form-actions-note" data-i18n="site.saveNote">{t("site.saveNote")}</span>
            <button type="submit" class="btn btn-primary" data-i18n="common.save">{t("common.save")}</button>
          </div>
        </form>
      </section>

      <!-- ===== Media ===== -->
      <section class="view" data-view="media" hidden>
        <div class="view-head">
          <div>
            <h1 class="view-title" data-i18n="view.media.title">{t("view.media.title")}</h1>
            <p class="view-sub" data-i18n="view.media.sub">{t("view.media.sub")}</p>
          </div>
          <div class="view-head-actions">
            <button id="media-refresh" class="btn btn-outline btn-sm" type="button" data-i18n="common.refresh">{t("common.refresh")}</button>
          </div>
        </div>
        <div id="media-toolbar" class="toolbar">
          <div class="toolbar-search">
            <input id="media-search" class="search-input" type="search" placeholder={t("media.searchPh")} data-i18n-ph="media.searchPh" autocomplete="off" />
          </div>
          <div class="toolbar-actions">
            <span id="media-summary" class="media-summary"></span>
            <button
              id="media-filter-alt"
              class="btn btn-outline btn-sm"
              type="button"
              aria-pressed="false"
              data-i18n="media.onlyMissingAlt"
            >{t("media.onlyMissingAlt")}</button>
          </div>
        </div>
        <div id="media-grid"></div>
      </section>

      <!-- ===== Editor Kendaraan =====
           Mobil & motor punya 30+ isian dalam lima kelompok — terlalu banyak
           untuk sebuah popup. Editornya jadi halaman tersendiri dengan alamat
           sendiri (#/cars/new, #/cars/edit/<id>), jadi tombol Kembali browser,
           penanda halaman, dan berbagi tautan semuanya bekerja. -->
      <section class="view view-editor" data-view="editor" hidden>
        <div class="editor-bar" id="editor-bar">
          <div class="editor-bar-row">
            <button type="button" class="btn btn-icon editor-back" id="editor-back" aria-label={t("editor.back")} data-i18n-aria="editor.back">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18 9 12l6-6"/></svg>
            </button>
            <div class="editor-titles">
              <span class="editor-eyebrow" id="editor-eyebrow"></span>
              <h1 class="editor-title" id="editor-title"></h1>
            </div>
            <div class="editor-bar-actions">
              <!-- Tautan sungguhan, bukan tombol: /api/pratinjau menjawab
                   dengan pengalihan, jadi target="_blank" sudah cukup dan tidak
                   ada jendela yang perlu dibuka lebih dulu. admin.js hanya
                   mengisi alamatnya, dan menahan klik saat masih ada perubahan
                   yang belum tersimpan. -->
              <a
                class="btn btn-outline"
                id="editor-preview"
                href="#"
                target="_blank"
                rel="noopener"
                hidden
                title={t("editor.preview.title")}
                data-i18n-title="editor.preview.title"
                data-i18n="editor.preview"
              >{t("editor.preview")}</a>
              <button type="button" class="btn btn-outline btn-ai" id="ai-open" hidden data-i18n="ai.research">{t("ai.research")}</button>
              <button type="button" class="btn btn-ghost editor-cancel" id="editor-cancel" data-i18n="common.cancel">{t("common.cancel")}</button>
              <button type="button" class="btn btn-outline" id="editor-save-add" hidden data-i18n="editor.saveAndAdd">{t("editor.saveAndAdd")}</button>
              <button type="submit" form="vehicle-form" class="btn btn-primary" id="editor-save" data-i18n="common.save">{t("common.save")}</button>
            </div>
          </div>
          <p class="editor-sub" id="editor-sub"></p>
          <div class="editor-meter" id="vehicle-meter"></div>
        </div>

        <div class="editor-layout">
          <aside class="editor-rail">
            <nav class="editor-nav" id="editor-nav" aria-label={t("editor.navLabel")} data-i18n-aria="editor.navLabel"></nav>
            <div class="editor-preview">
              <div class="editor-preview-label" data-i18n="editor.previewLabel">{t("editor.previewLabel")}</div>
              <div class="item-row" id="vehicle-preview"></div>
            </div>
          </aside>

          <form id="vehicle-form" class="editor-form" novalidate>
            <section class="editor-section" data-section="dasar"></section>
            <section class="editor-section" data-section="spesifikasi"></section>
            <section class="editor-section" data-section="media"></section>
            <section class="editor-section" data-section="varian"></section>
            <section class="editor-section" data-section="lanjutan"></section>
          </form>
        </div>
      </section>

      <!-- ===== Cadangan ===== -->
      <!-- ===== AI ===== -->
      <section class="view view-narrow" data-view="ai" hidden>
        <div class="view-head">
          <div>
            <h1 class="view-title" data-i18n="ai.title">{t("ai.title")}</h1>
            <p class="view-sub" data-i18n="ai.sub">{t("ai.sub")}</p>
          </div>
        </div>
        <div id="ai-root"></div>
      </section>

      <!-- ===== Cadangan ===== -->
      <section class="view" data-view="backups" hidden>
        <div class="view-head">
          <div>
            <h1 class="view-title" data-i18n="view.backups.title">{t("view.backups.title")}</h1>
            <p class="view-sub" data-i18n="view.backups.sub">{t("view.backups.sub")}</p>
          </div>
        </div>
        <div class="panel">
          <div class="panel-body" id="backups-list"></div>
        </div>
      </section>

      <!-- ===== Profil Saya ===== -->
      <section class="view view-narrow" data-view="profile" hidden>
        <div class="view-head">
          <div>
            <h1 class="view-title" data-i18n="profile.title">{t("profile.title")}</h1>
            <p class="view-sub" data-i18n="profile.sub">{t("profile.sub")}</p>
          </div>
        </div>
        <div id="profile-root"></div>
      </section>

      <!-- ===== Pengguna ===== -->
      <section class="view" data-view="users" hidden>
        <div class="view-head">
          <div>
            <h1 class="view-title" data-i18n="users.title">{t("users.title")}</h1>
            <p class="view-sub" data-i18n="users.sub">{t("users.sub")}</p>
          </div>
          <div class="view-head-actions">
            <button id="add-user" class="btn btn-primary" type="button" hidden={!isAdmin} data-requires-admin data-i18n="users.add">{t("users.add")}</button>
          </div>
        </div>
        <div id="users-root"></div>
      </section>
    </main>
  </div>

  <!-- ===== Modal riset AI =====
       Satu modal dengan tiga keadaan berurutan — persiapan, progres, usulan —
       yang seluruh isinya digambar admin.js. Ketiganya adalah satu alur, dan
       memisahkannya jadi tiga dialog berarti memaksa penyunting kehilangan
       konteks dua kali di tengah pekerjaan yang sama. -->
  <div id="ai-modal" class="modal-backdrop">
    <div class="modal modal-form modal-ai" role="dialog" aria-modal="true" aria-labelledby="ai-modal-title">
      <div class="modal-head">
        <div class="modal-head-text">
          <h3 class="modal-title" id="ai-modal-title"></h3>
          <p class="modal-sub" id="ai-modal-sub"></p>
        </div>
        <button type="button" class="modal-close" id="ai-modal-close" aria-label={t("common.close")} data-i18n-aria="common.close">&times;</button>
      </div>
      <div class="modal-body" id="ai-modal-body"></div>
      <div class="modal-foot" id="ai-modal-foot"></div>
    </div>
  </div>

  <!-- ===== Modal direktori (SPKLU / bengkel / berita) ===== -->
  <div id="dir-modal" class="modal-backdrop">
    <div class="modal modal-form" role="dialog" aria-modal="true" aria-labelledby="dir-modal-title">
      <div class="modal-head">
        <div class="modal-head-text">
          <h3 class="modal-title" id="dir-modal-title"></h3>
          <p class="modal-sub" id="dir-modal-sub"></p>
        </div>
        <button type="button" class="modal-close" id="dir-modal-close" aria-label={t("common.close")} data-i18n-aria="common.close">&times;</button>
      </div>
      <div class="editor-meter modal-meter" id="dir-meter"></div>
      <form id="dir-form">
        <div class="modal-body">
          <div id="dir-fields"></div>
        </div>
        <div class="modal-foot">
          <p class="modal-foot-hint" data-i18n="editor.saveShortcut">{t("editor.saveShortcut")}</p>
          <button type="button" class="btn btn-ghost" id="dir-cancel" data-close-modal data-i18n="common.cancel">{t("common.cancel")}</button>
          <button type="button" class="btn btn-outline" id="dir-save-add" hidden data-i18n="editor.saveAndAdd">{t("editor.saveAndAdd")}</button>
          <button type="submit" class="btn btn-primary" data-i18n="common.save">{t("common.save")}</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ===== Modal pengguna ===== -->
  <div id="user-modal" class="modal-backdrop">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="user-modal-title">
      <div class="modal-head">
        <h3 class="modal-title" id="user-modal-title"></h3>
        <button type="button" class="modal-close" aria-label={t("common.close")} data-i18n-aria="common.close">&times;</button>
      </div>
      <form id="user-form">
        <div class="modal-body">
          <div id="user-fields" class="field-grid"></div>
        </div>
        <div class="modal-foot">
          <button type="button" class="btn btn-ghost" data-close-modal data-i18n="common.cancel">{t("common.cancel")}</button>
          <button type="submit" class="btn btn-primary" data-i18n="common.save">{t("common.save")}</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ===== Dialog konfirmasi ===== -->
  <!-- ===== Modal media =====
       Pratinjau besar satu gambar plus segala yang diketahui tentangnya:
       ukuran, tempat pemakaian, dan tiga field metadata. Panah kiri/kanan
       berpindah gambar tanpa menutup modal, jadi mengisi teks alternatif
       untuk dua puluh gambar tidak berarti dua puluh kali buka-tutup. -->
  <div id="media-modal" class="modal-backdrop">
    <div class="modal modal-lg mediaview" role="dialog" aria-modal="true" aria-labelledby="media-modal-title">
      <div class="modal-head">
        <div class="modal-head-text">
          <h3 class="modal-title" id="media-modal-title"></h3>
          <p class="modal-sub" id="media-modal-sub"></p>
        </div>
        <button type="button" class="modal-close" aria-label={t("common.close")} data-i18n-aria="common.close">&times;</button>
      </div>

      <div class="modal-body mediaview-body">
        <div class="mediaview-stage">
          <div class="mediaview-canvas" id="media-canvas">
            <img id="media-image" src="" alt="" />
          </div>
          <button type="button" class="mediaview-nav prev" id="media-prev" aria-label={t("media.prev")} data-i18n-aria="media.prev">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
          </button>
          <button type="button" class="mediaview-nav next" id="media-next" aria-label={t("media.next")} data-i18n-aria="media.next">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
          </button>
          <button type="button" class="btn btn-ghost btn-sm mediaview-zoom" id="media-zoom" data-i18n="media.zoomIn">{t("media.zoomIn")}</button>
        </div>

        <div class="mediaview-side">
          <dl class="mediaview-facts">
            <div><dt data-i18n="media.factDimensions">{t("media.factDimensions")}</dt><dd id="media-fact-dim">—</dd></div>
            <div><dt data-i18n="media.factSize">{t("media.factSize")}</dt><dd id="media-fact-size">—</dd></div>
            <div><dt data-i18n="media.factType">{t("media.factType")}</dt><dd id="media-fact-type">—</dd></div>
            <div><dt data-i18n="media.factUses">{t("media.factUses")}</dt><dd id="media-fact-uses">—</dd></div>
          </dl>

          <div class="field-grid mediaview-fields">
            <div class="field full">
              <label for="media-field-alt" data-i18n="media.fieldAlt">{t("media.fieldAlt")}</label>
              <textarea id="media-field-alt" data-media-field="alt" rows="2" maxlength={MEDIA_LIMITS.alt}></textarea>
              <span class="hint" data-i18n="media.fieldAlt.hint">{t("media.fieldAlt.hint")}</span>
            </div>
            <div class="field full">
              <label for="media-field-title" data-i18n="media.fieldTitle">{t("media.fieldTitle")}</label>
              <input id="media-field-title" type="text" data-media-field="title" maxlength={MEDIA_LIMITS.title} />
              <span class="hint" data-i18n="media.fieldTitle.hint">{t("media.fieldTitle.hint")}</span>
            </div>
            <div class="field full">
              <label for="media-field-note" data-i18n="media.fieldNote">{t("media.fieldNote")}</label>
              <textarea id="media-field-note" data-media-field="note" rows="2" maxlength={MEDIA_LIMITS.note}></textarea>
              <span class="hint" data-i18n="media.fieldNote.hint">{t("media.fieldNote.hint")}</span>
            </div>
          </div>

          <div class="mediaview-uses">
            <h4 data-i18n="media.usesTitle">{t("media.usesTitle")}</h4>
            <div id="media-uses"></div>
          </div>
        </div>
      </div>

      <div class="modal-foot mediaview-foot">
        <div class="mediaview-foot-actions">
          <button type="button" class="btn btn-outline btn-sm" id="media-copy" data-i18n="common.copyUrl">{t("common.copyUrl")}</button>
          <a class="btn btn-outline btn-sm" id="media-open" href="#" target="_blank" rel="noopener" data-i18n="media.openFile">{t("media.openFile")}</a>
          <a class="btn btn-outline btn-sm" id="media-download" href="#" download data-i18n="media.download">{t("media.download")}</a>
        </div>
        <button type="button" class="btn btn-primary" data-close-modal data-i18n="common.close">{t("common.close")}</button>
      </div>
    </div>
  </div>

  <div id="confirm-modal" class="modal-backdrop">
    <div class="modal modal-sm">
      <div class="modal-head"><h3 class="modal-title" id="confirm-title"></h3></div>
      <div class="modal-body"><p id="confirm-text"></p></div>
      <div class="modal-foot">
        <button type="button" class="btn btn-ghost" id="confirm-cancel" data-i18n="common.cancel">{t("common.cancel")}</button>
        <button type="button" class="btn btn-danger" id="confirm-ok"></button>
      </div>
    </div>
  </div>

  <!-- Tombol tambah melayang: hanya tampil di layar sempit, isinya mengikuti halaman aktif. -->
  <button id="quick-add" class="fab" type="button" hidden>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
    <span class="fab-label" data-i18n="common.add">{t("common.add")}</span>
  </button>

  <div id="toast-stack" class="toast-stack"></div>

  <script src="../../scripts/admin.js"></script>
</Base>
