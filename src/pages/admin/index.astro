---
import Base from "../../layouts/Base.astro";
import AdminSidebar from "../../components/AdminSidebar.astro";
import LogoMark from "../../components/LogoMark.astro";
import { MEDIA_LIMITS } from "../../lib/media.js";
import "../../styles/admin.css";
import { currentUser } from "../../lib/auth";
import { makeT, localeMeta, LOCALES } from "../../lib/i18n/index.js";
import { FONT_NAMES, CHOICES, THEME_PRESETS } from "../../lib/theme.js";

const me = currentUser(Astro.cookies);
if (!me) {
  return Astro.redirect("/admin/login");
}

/**
 * Bahasa panel diambil dari profil pengguna, bukan dari cookie: cookie hanya
 * cerminan supaya halaman lain yang tidak mengenal sesi tetap tahu bahasanya.
 * Dengan begitu satu orang bisa memakai Bahasa Inggris tanpa mengubah tampilan
 * rekannya yang memakai Bahasa Indonesia di peramban yang sama.
 */
const locale = me.locale;
const t = makeT(locale);
const lang = localeMeta(locale);
const isAdmin = me.role === "owner" || me.role === "admin";

/** Bobot huruf judul yang ditawarkan. Angka, jadi tidak perlu diterjemahkan. */
const HEADING_WEIGHTS = ["400", "500", "600", "700", "800", "900"];
---

<Base title={`${t("topbar.adminPanel")} — EVKita`} bodyClass="admin-ui" lang={lang.html} noindex>
  <div id="admin-app" class="admin-app" class:list={[{ "density-compact": me.density === "compact" }]}>
    <!-- Lapisan gelap khusus mode drawer (≤900px); klik untuk menutup sidebar. -->
    <div id="sidebar-scrim" class="sidebar-scrim"></div>

    <AdminSidebar mode="app" active="dashboard" locale={locale} role={me.role} />

    <header id="admin-topbar" class="admin-topbar">
      <button id="sidebar-toggle" class="btn btn-icon" type="button" aria-label={t("nav.collapse")} data-i18n-aria="nav.collapse">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>

      <div class="topbar-search">
        <svg class="topbar-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input
          id="global-search"
          type="search"
          placeholder={t("topbar.searchPlaceholder")}
          data-i18n-ph="topbar.searchPlaceholder"
          autocomplete="off"
          aria-label={t("topbar.searchLabel")}
          data-i18n-aria="topbar.searchLabel"
        />
        <span class="kbd">⌘K</span>
      </div>

      <div class="topbar-right">
        <span id="save-state" class="save-state" data-i18n="save.ready">{t("save.ready")}</span>

        <!-- Pemilih bahasa. Isinya digambar ulang oleh admin.js supaya pilihan
             yang aktif selalu tersorot setelah bahasa berganti. -->
        <div id="lang-menu" class="lang-menu">
          <button id="lang-toggle" class="btn btn-icon lang-toggle" type="button" aria-label={t("topbar.languageLabel")} data-i18n-aria="topbar.languageLabel" title={t("topbar.language")}>
            <span class="lang-flag">{lang.flag}</span>
          </button>
          <div id="lang-switch" class="lang-switch">
            {LOCALES.map((l) => (
              <button type="button" class:list={["lang-opt", { active: l.code === locale }]} data-lang={l.code} lang={l.html} title={l.label}>
                <span class="lang-flag">{l.flag}</span>
                <span class="lang-short">{l.short}</span>
                <span class="lang-label">{l.label}</span>
              </button>
            ))}
          </div>
        </div>

        <button id="themeToggle" class="btn btn-icon" type="button" aria-label={t("topbar.themeToggle")} data-i18n-aria="topbar.themeToggle" title={t("topbar.themeToggle")} data-i18n-title="topbar.themeToggle">
          <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
          <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
        </button>

        <button id="account-chip" class="account-chip" type="button" title={t("nav.profile")}></button>
        <button id="logout" class="btn btn-ghost btn-sm" type="button" data-i18n="topbar.logout">{t("topbar.logout")}</button>
      </div>
    </header>

    <main id="admin-main" class="admin-main">
      <!-- ===== Dasbor ===== -->
      <section class="view" data-view="dashboard">
        <!-- Sapaan, skor kelengkapan, dan aksi cepat. Digambar admin.js karena
             isinya bergantung pada profil dan konten yang baru dimuat. -->
        <div id="dash-hello"></div>

        <div id="dash-stats"></div>

        <div class="grid-2">
          <div class="panel">
            <div class="panel-head">
              <h2 class="panel-title" data-i18n="dash.charts.title">{t("dash.charts.title")}</h2>
            </div>
            <div class="panel-body" id="dash-charts"></div>
          </div>
          <div class="panel">
            <div class="panel-head">
              <h2 class="panel-title" data-i18n="dash.health.title">{t("dash.health.title")}</h2>
            </div>
            <div class="panel-body" id="dash-health"></div>
          </div>
        </div>

        <div class="grid-2">
          <div class="panel">
            <div class="panel-head">
              <h2 class="panel-title" data-i18n="dash.recent.title">{t("dash.recent.title")}</h2>
            </div>
            <div class="panel-body" id="dash-recent"></div>
          </div>
          <div class="panel">
            <div class="panel-head">
              <h2 class="panel-title" data-i18n="dash.activity.title">{t("dash.activity.title")}</h2>
            </div>
            <div class="panel-body" id="dash-activity"></div>
          </div>
        </div>
      </section>

      <!-- ===== Mobil ===== -->
      <section class="view" data-view="cars" hidden>
        <div class="view-head">
          <div>
            <h1 class="view-title" data-i18n="view.cars.title">{t("view.cars.title")}</h1>
            <p class="view-sub" data-i18n="view.cars.sub">{t("view.cars.sub")}</p>
          </div>
          <div class="view-head-actions">
            <button id="add-cars" class="btn btn-primary" type="button" data-add="cars" data-i18n="view.cars.add">{t("view.cars.add")}</button>
          </div>
        </div>
        <div id="cars-toolbar"></div>
        <div id="cars-list" class="item-list"></div>
      </section>

      <!-- ===== Motor ===== -->
      <section class="view" data-view="motors" hidden>
        <div class="view-head">
          <div>
            <h1 class="view-title" data-i18n="view.motors.title">{t("view.motors.title")}</h1>
            <p class="view-sub" data-i18n="view.motors.sub">{t("view.motors.sub")}</p>
          </div>
          <div class="view-head-actions">
            <button id="add-motors" class="btn btn-primary" type="button" data-add="motors" data-i18n="view.motors.add">{t("view.motors.add")}</button>
          </div>
        </div>
        <div id="motors-toolbar"></div>
        <div id="motors-list" class="item-list"></div>
      </section>

      <!-- ===== SPKLU ===== -->
      <section class="view" data-view="spklu" hidden>
        <div class="view-head">
          <div>
            <h1 class="view-title" data-i18n="view.spklu.title">{t("view.spklu.title")}</h1>
            <p class="view-sub" data-i18n="view.spklu.sub">{t("view.spklu.sub")}</p>
          </div>
          <div class="view-head-actions">
            <button id="add-spklu" class="btn btn-primary" type="button" data-add="spklu" data-i18n="view.spklu.add">{t("view.spklu.add")}</button>
          </div>
        </div>
        <div id="spklu-toolbar"></div>
        <div id="spklu-list" class="item-list"></div>
      </section>

      <!-- ===== Bengkel ===== -->
      <section class="view" data-view="bengkel" hidden>
        <div class="view-head">
          <div>
            <h1 class="view-title" data-i18n="view.bengkel.title">{t("view.bengkel.title")}</h1>
            <p class="view-sub" data-i18n="view.bengkel.sub">{t("view.bengkel.sub")}</p>
          </div>
          <div class="view-head-actions">
            <button id="add-bengkel" class="btn btn-primary" type="button" data-add="bengkel" data-i18n="view.bengkel.add">{t("view.bengkel.add")}</button>
          </div>
        </div>
        <div id="bengkel-toolbar"></div>
        <div id="bengkel-list" class="item-list"></div>
      </section>

      <!-- ===== Berita ===== -->
      <section class="view" data-view="berita" hidden>
        <div class="view-head">
          <div>
            <h1 class="view-title" data-i18n="view.berita.title">{t("view.berita.title")}</h1>
            <p class="view-sub" data-i18n="view.berita.sub">{t("view.berita.sub")}</p>
          </div>
          <div class="view-head-actions">
            <button id="add-berita" class="btn btn-primary" type="button" data-add="berita" data-i18n="view.berita.add">{t("view.berita.add")}</button>
          </div>
        </div>
        <div id="berita-toolbar"></div>
        <div id="berita-list" class="item-list"></div>
      </section>

      <!-- ===== Pengaturan Situs ===== -->
      <section class="view" data-view="site" hidden>
        <div class="view-head">
          <div>
            <h1 class="view-title" data-i18n="view.site.title">{t("view.site.title")}</h1>
            <p class="view-sub" data-i18n="view.site.sub">{t("view.site.sub")}</p>
          </div>
        </div>

        <form id="site-form">
          <!-- Identitas -->
          <div class="form-section">
            <div class="form-section-head">
              <h2 data-i18n="site.identity">{t("site.identity")}</h2>
              <p data-i18n="site.identity.desc">{t("site.identity.desc")}</p>
            </div>
            <div class="field-grid">
              <div class="field">
                <label for="s-brandText" data-i18n="site.brandText">{t("site.brandText")}</label>
                <input id="s-brandText" name="brandText" placeholder="ReferensiID" />
              </div>
              <div class="field">
                <label for="s-brandSuffix" data-i18n="site.brandSuffix">{t("site.brandSuffix")}</label>
                <input id="s-brandSuffix" name="brandSuffix" placeholder=".com" />
                <span class="hint" data-i18n="site.brandSuffix.hint">{t("site.brandSuffix.hint")}</span>
              </div>
              <div class="field">
                <label for="s-logoMark" data-i18n="site.logoMark">{t("site.logoMark")}</label>
                <input id="s-logoMark" name="logoMark" maxlength="4" placeholder="EV" />
                <span class="hint" data-i18n="site.logoMark.hint">{t("site.logoMark.hint")}</span>
              </div>
              <div class="field full" data-image-field="logoImage">
                <label data-i18n="site.logoImage">{t("site.logoImage")}</label>
                <div class="dropzone" data-dropzone></div>
                <input type="hidden" name="logoImage" />
                <span class="hint" data-i18n="site.logoImage.hint">{t("site.logoImage.hint")}</span>
              </div>
            </div>
          </div>

          <!-- Hero -->
          <div class="form-section">
            <div class="form-section-head">
              <h2 data-i18n="site.hero">{t("site.hero")}</h2>
              <p data-i18n="site.hero.desc">{t("site.hero.desc")}</p>
            </div>
            <div class="field-grid">
              <div class="field">
                <label for="s-heroEyebrow" data-i18n="site.heroEyebrow">{t("site.heroEyebrow")}</label>
                <input id="s-heroEyebrow" name="heroEyebrow" placeholder={t("site.heroEyebrow.ph")} data-i18n-ph="site.heroEyebrow.ph" />
              </div>
              <div class="field">
                <label for="s-heroTitle" data-i18n="site.heroTitle">{t("site.heroTitle")}</label>
                <input id="s-heroTitle" name="heroTitle" />
              </div>
              <div class="field full">
                <label for="s-heroSub" data-i18n="site.heroSub">{t("site.heroSub")}</label>
                <textarea id="s-heroSub" name="heroSub" rows="3"></textarea>
              </div>
              <div class="field full" data-image-field="heroImage">
                <label data-i18n="site.heroImage">{t("site.heroImage")}</label>
                <div class="dropzone" data-dropzone></div>
                <input type="hidden" name="heroImage" />
              </div>
              <div class="field">
                <label for="s-heroCtaText" data-i18n="site.heroCtaText">{t("site.heroCtaText")}</label>
                <input id="s-heroCtaText" name="heroCtaText" placeholder={t("site.heroCtaText.ph")} data-i18n-ph="site.heroCtaText.ph" />
              </div>
              <div class="field">
                <label for="s-heroCtaUrl" data-i18n="site.heroCtaUrl">{t("site.heroCtaUrl")}</label>
                <input id="s-heroCtaUrl" name="heroCtaUrl" placeholder="#katalog" />
              </div>
              <div class="field">
                <label for="s-heroCtaAltText" data-i18n="site.heroCtaAltText">{t("site.heroCtaAltText")}</label>
                <input id="s-heroCtaAltText" name="heroCtaAltText" placeholder={t("site.heroCtaAltText.ph")} data-i18n-ph="site.heroCtaAltText.ph" />
              </div>
              <div class="field">
                <label for="s-heroCtaAltUrl" data-i18n="site.heroCtaAltUrl">{t("site.heroCtaAltUrl")}</label>
                <input id="s-heroCtaAltUrl" name="heroCtaAltUrl" placeholder="#spklu" />
              </div>
              <div class="field full">
                <label class="switch-row">
                  <input type="checkbox" name="showHeroStats" />
                  <span class="switch" aria-hidden="true"></span>
                  <span data-i18n="site.showHeroStats">{t("site.showHeroStats")}</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Seksi Beranda -->
          <div class="form-section">
            <div class="form-section-head">
              <h2 data-i18n="site.sections">{t("site.sections")}</h2>
              <p data-i18n="site.sections.desc">{t("site.sections.desc")}</p>
            </div>
            <div class="field-grid">
              <div class="field">
                <label for="s-katalogTitle" data-i18n="site.katalogTitle">{t("site.katalogTitle")}</label>
                <input id="s-katalogTitle" name="katalogTitle" />
              </div>
              <div class="field">
                <label for="s-katalogNote" data-i18n="site.katalogNote">{t("site.katalogNote")}</label>
                <input id="s-katalogNote" name="katalogNote" />
              </div>
              <div class="field full">
                <label class="switch-row">
                  <input type="checkbox" name="showMotor" />
                  <span class="switch" aria-hidden="true"></span>
                  <span data-i18n="site.showMotor">{t("site.showMotor")}</span>
                </label>
              </div>

              <div class="field">
                <label for="s-spkluTitle" data-i18n="site.spkluTitle">{t("site.spkluTitle")}</label>
                <input id="s-spkluTitle" name="spkluTitle" />
              </div>
              <div class="field">
                <label for="s-spkluNote" data-i18n="site.spkluNote">{t("site.spkluNote")}</label>
                <input id="s-spkluNote" name="spkluNote" />
              </div>
              <div class="field full">
                <label class="switch-row">
                  <input type="checkbox" name="showSpklu" />
                  <span class="switch" aria-hidden="true"></span>
                  <span data-i18n="site.showSpklu">{t("site.showSpklu")}</span>
                </label>
              </div>

              <div class="field">
                <label for="s-bengkelTitle" data-i18n="site.bengkelTitle">{t("site.bengkelTitle")}</label>
                <input id="s-bengkelTitle" name="bengkelTitle" />
              </div>
              <div class="field">
                <label for="s-bengkelNote" data-i18n="site.bengkelNote">{t("site.bengkelNote")}</label>
                <input id="s-bengkelNote" name="bengkelNote" />
              </div>
              <div class="field full">
                <label class="switch-row">
                  <input type="checkbox" name="showBengkel" />
                  <span class="switch" aria-hidden="true"></span>
                  <span data-i18n="site.showBengkel">{t("site.showBengkel")}</span>
                </label>
              </div>

              <div class="field">
                <label for="s-beritaTitle" data-i18n="site.beritaTitle">{t("site.beritaTitle")}</label>
                <input id="s-beritaTitle" name="beritaTitle" />
              </div>
              <div class="field">
                <label for="s-beritaNote" data-i18n="site.beritaNote">{t("site.beritaNote")}</label>
                <input id="s-beritaNote" name="beritaNote" />
              </div>
              <div class="field full">
                <label class="switch-row">
                  <input type="checkbox" name="showBerita" />
                  <span class="switch" aria-hidden="true"></span>
                  <span data-i18n="site.showBerita">{t("site.showBerita")}</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Tentang -->
          <div class="form-section">
            <div class="form-section-head">
              <h2 data-i18n="site.about">{t("site.about")}</h2>
              <p data-i18n="site.about.desc">{t("site.about.desc")}</p>
            </div>
            <div class="field-grid">
              <div class="field full">
                <label for="s-aboutTitle" data-i18n="site.aboutTitle">{t("site.aboutTitle")}</label>
                <input id="s-aboutTitle" name="aboutTitle" />
              </div>
              <div class="field full">
                <label for="s-aboutText" data-i18n="site.aboutText">{t("site.aboutText")}</label>
                <textarea id="s-aboutText" name="aboutText" rows="4"></textarea>
              </div>
              <div class="field full">
                <label class="switch-row">
                  <input type="checkbox" name="showAbout" />
                  <span class="switch" aria-hidden="true"></span>
                  <span data-i18n="site.showAbout">{t("site.showAbout")}</span>
                </label>
              </div>
            </div>
          </div>

          <!-- SEO -->
          <div class="form-section">
            <div class="form-section-head">
              <h2 data-i18n="site.seo">{t("site.seo")}</h2>
              <p data-i18n="site.seo.desc">{t("site.seo.desc")}</p>
            </div>
            <div class="field-grid">
              <div class="field full">
                <label for="s-seoTitle" data-i18n="site.seoTitle">{t("site.seoTitle")}</label>
                <input id="s-seoTitle" name="seoTitle" />
                <span class="hint" data-i18n="site.seoTitle.hint">{t("site.seoTitle.hint")}</span>
              </div>
              <div class="field full">
                <label for="s-seoDescription" data-i18n="site.seoDescription">{t("site.seoDescription")}</label>
                <textarea id="s-seoDescription" name="seoDescription" rows="3"></textarea>
                <span class="hint" data-i18n="site.seoDescription.hint">{t("site.seoDescription.hint")}</span>
              </div>
              <div class="field full">
                <label for="s-seoKeywords" data-i18n="site.seoKeywords">{t("site.seoKeywords")}</label>
                <input id="s-seoKeywords" name="seoKeywords" placeholder="mobil listrik, spklu, harga ev" />
                <span class="hint" data-i18n="site.seoKeywords.hint">{t("site.seoKeywords.hint")}</span>
              </div>
              <div class="field full" data-image-field="seoOgImage">
                <label data-i18n="site.seoOgImage">{t("site.seoOgImage")}</label>
                <div class="dropzone" data-dropzone></div>
                <input type="hidden" name="seoOgImage" />
                <span class="hint" data-i18n="site.seoOgImage.hint">{t("site.seoOgImage.hint")}</span>
              </div>
            </div>
          </div>

          <!-- Kontak & Sosial -->
          <div class="form-section">
            <div class="form-section-head">
              <h2 data-i18n="site.contact">{t("site.contact")}</h2>
              <p data-i18n="site.contact.desc">{t("site.contact.desc")}</p>
            </div>
            <div class="field-grid">
              <div class="field">
                <label for="s-contactEmail" data-i18n="site.contactEmail">{t("site.contactEmail")}</label>
                <input id="s-contactEmail" type="email" name="contactEmail" />
              </div>
              <div class="field">
                <label for="s-contactPhone" data-i18n="site.contactPhone">{t("site.contactPhone")}</label>
                <input id="s-contactPhone" name="contactPhone" placeholder="+62 21 1234 5678" />
              </div>
              <div class="field">
                <label for="s-contactWhatsapp" data-i18n="site.contactWhatsapp">{t("site.contactWhatsapp")}</label>
                <input id="s-contactWhatsapp" name="contactWhatsapp" placeholder="628xxxxxxxxxx" />
                <span class="hint" data-i18n="site.contactWhatsapp.hint">{t("site.contactWhatsapp.hint")}</span>
              </div>
              <div class="field">
                <label for="s-contactHours" data-i18n="site.contactHours">{t("site.contactHours")}</label>
                <input id="s-contactHours" name="contactHours" placeholder={t("site.contactHours.ph")} data-i18n-ph="site.contactHours.ph" />
              </div>
              <div class="field full">
                <label for="s-contactAddress" data-i18n="site.contactAddress">{t("site.contactAddress")}</label>
                <input id="s-contactAddress" name="contactAddress" />
              </div>
              <div class="field">
                <label for="s-contactMapUrl" data-i18n="site.contactMapUrl">{t("site.contactMapUrl")}</label>
                <input id="s-contactMapUrl" name="contactMapUrl" placeholder="https://maps.google.com/…" />
              </div>
              <div class="field">
                <label for="s-contactWebsite" data-i18n="site.contactWebsite">{t("site.contactWebsite")}</label>
                <input id="s-contactWebsite" name="contactWebsite" placeholder="https://…" />
              </div>
              <div class="field">
                <label for="s-socialInstagram">Instagram</label>
                <input id="s-socialInstagram" name="socialInstagram" placeholder="https://instagram.com/…" />
              </div>
              <div class="field">
                <label for="s-socialYoutube">YouTube</label>
                <input id="s-socialYoutube" name="socialYoutube" placeholder="https://youtube.com/@…" />
              </div>
              <div class="field">
                <label for="s-socialTiktok">TikTok</label>
                <input id="s-socialTiktok" name="socialTiktok" placeholder="https://tiktok.com/@…" />
              </div>
              <div class="field">
                <label for="s-socialFacebook">Facebook</label>
                <input id="s-socialFacebook" name="socialFacebook" placeholder="https://facebook.com/…" />
              </div>
              <div class="field">
                <label for="s-socialX">X (Twitter)</label>
                <input id="s-socialX" name="socialX" placeholder="https://x.com/…" />
              </div>
              <div class="field">
