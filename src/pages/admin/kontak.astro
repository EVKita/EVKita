---
import Base from "../../layouts/Base.astro";
import AdminSidebar from "../../components/AdminSidebar.astro";
import "../../styles/admin.css";
import { currentUser } from "../../lib/auth";
import { can } from "../../lib/users";
import { readContent } from "../../lib/store";
import { smtpState } from "../../lib/smtp";
import { makeT, localeMeta } from "../../lib/i18n/index.js";

/**
 * Halaman Kontak — pengaturan SMTP untuk formulir kontak di footer.
 *
 * HALAMAN SENDIRI, bukan satu tampilan lagi di dalam /admin, dengan alasan yang
 * sama seperti halaman Integrasi dan Pembaruan: isinya tidak menyentuh
 * `content.json`, dan memuat seluruh CMS untuk sebuah formulir berisi enam field
 * tidak sepadan. Ia hanya membawa `admin-shell.js` dan skrip formulirnya sendiri.
 *
 * Kata sandi SMTP disimpan di `.env` lewat `writeEnvFile()` — rahasia, sama
 * seperti kunci API DeepSeek — dan endpoint pengaturannya TIDAK PERNAH
 * mengembalikannya. Lihat src/pages/api/smtp.ts.
 */

const me = currentUser(Astro.cookies);
if (!me) {
  return Astro.redirect("/admin/login");
}
// Kata sandi SMTP menentukan dari alamat mana surat situs ini dikirim — itu
// keputusan pemilik situs, jadi Editor ditutup di SERVER, bukan sekadar
// disembunyikan tombolnya.
if (!can(me, "kontak")) {
  return Astro.redirect("/admin");
}

const locale = me.locale;
const t = makeT(locale);
const lang = localeMeta(locale);

const site = readContent().site || {};
const cfg = smtpState();

/* Teks untuk skrip di bawah. Skrip itu berjalan di peramban dan tidak memuat
   kamus, jadi terjemahannya dirakit di server lalu dikirim lewat define:vars. */
const texts = {
  ready: t("save.ready"),
  saving: t("save.saving"),
  saved: t("save.saved"),
  ujiOk: t("kontak.uji.ok"),
  galat: {
    "err.kontak.port": t("err.kontak.port"),
    "err.kontak.emailUji": t("err.kontak.emailUji"),
    "err.kontak.belumDiatur": t("err.kontak.belumDiatur"),
    "err.kontak.gagalKirim": t("err.kontak.gagalKirim"),
    "err.ai.terlaluSering": t("err.ai.terlaluSering"),
    "err.forbidden": t("err.forbidden"),
    "err.badJson": t("err.badJson"),
    "err.unauthorized": t("err.unauthorized"),
  },
};

const statusKelas = (terpasang: boolean) => (terpasang ? "integrasi-status is-on" : "integrasi-status");
const statusTeks = (terpasang: boolean) => (terpasang ? t("kontak.on") : t("kontak.off"));
--- 

<Base title={`${t("kontak.title")} — EVKita`} bodyClass="admin-ui" lang={lang.html} noindex site={site} accentOnly>
  <div id="admin-app" class="admin-app">
    <div id="sidebar-scrim" class="sidebar-scrim"></div>

    <AdminSidebar mode="link" active="kontak" locale={locale} role={me.role} />

    <header id="admin-topbar" class="admin-topbar">
      <button id="sidebar-toggle" class="btn btn-icon" type="button" aria-label={t("nav.collapse")}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>

      <div class="topbar-heading">
        <span class="topbar-heading-eyebrow">{t("topbar.adminPanel")}</span>
        <strong>{t("kontak.title")}</strong>
      </div>

      <div class="topbar-right">
        <span id="kontak-state" class="save-state">{t("save.ready")}</span>
        <button id="themeToggle" class="btn btn-icon" type="button" aria-label={t("topbar.themeToggle")} title={t("topbar.themeToggle")}>
          <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
          <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
        </button>
        <button id="logout" class="btn btn-ghost btn-sm" type="button">{t("topbar.logout")}</button>
      </div>
    </header>

    <main id="admin-main" class="admin-main">
      <section class="view view-narrow">
        <div class="view-head">
          <div>
            <h1 class="view-title">{t("kontak.title")}</h1>
            <p class="view-sub">{t("kontak.sub")}</p>
          </div>
        </div>

        <form id="kontak-form">
          <section class="panel form-section">
            <div class="form-section-head integrasi-head">
              <span class="integrasi-logo" aria-hidden="true">✉️</span>
              <div>
                <h2>{t("kontak.smtp")}</h2>
                <p>{t("kontak.smtp.desc")}</p>
              </div>
              <span class={statusKelas(cfg.terpasang)} data-status data-on={t("kontak.on")} data-off={t("kontak.off")}>{statusTeks(cfg.terpasang)}</span>
            </div>

            <div class="field-grid">
              <div class="field">
                <label for="k-host">{t("kontak.host")}</label>
                <input id="k-host" name="host" value={cfg.host} placeholder={t("kontak.host.ph")} spellcheck="false" autocapitalize="none" autocomplete="off" />
              </div>
              <div class="field">
                <label for="k-port">{t("kontak.port")}</label>
                <input id="k-port" name="port" value={cfg.port} inputmode="numeric" spellcheck="false" autocomplete="off" />
                <span class="hint">{t("kontak.port.hint")}</span>
              </div>
              <div class="field">
                <label for="k-user">{t("kontak.user")}</label>
                <input id="k-user" name="user" value={cfg.user} placeholder={t("kontak.user.ph")} spellcheck="false" autocapitalize="none" autocomplete="off" />
              </div>
              <div class="field">
                <label for="k-pass">{t("kontak.pass")}</label>
                <input id="k-pass" name="pass" type="password" placeholder={cfg.terpasang ? "••••••••" : ""} autocomplete="new-password" />
                <span class="hint">{t("kontak.pass.hint")}</span>
              </div>
              <div class="field">
                <label for="k-from">{t("kontak.from")}</label>
                <input id="k-from" name="from" value={cfg.from} spellcheck="false" autocapitalize="none" autocomplete="off" />
                <span class="hint">{t("kontak.from.hint")}</span>
              </div>
              <div class="field full">
                <label class="switch-row">
                  <input type="checkbox" name="secure" checked={cfg.secure} />
                  <span class="switch" aria-hidden="true"></span>
                  <span>{t("kontak.secure")}</span>
                </label>
              </div>
            </div>
          </section>

          <section class="panel form-section">
            <div class="form-section-head">
              <div>
                <h2>{t("kontak.uji")}</h2>
                <p>{t("kontak.uji.hint")}</p>
              </div>
            </div>
            <div class="field-grid">
              <div class="field full">
                <label for="k-ujiKe">{t("kontak.ujiKe")}</label>
                <input id="k-ujiKe" name="ujiKe" value={cfg.from || cfg.user} type="email" spellcheck="false" autocapitalize="none" autocomplete="off" />
              </div>
            </div>
          </section>

          <div class="form-actions">
            <button type="button" class="btn btn-outline" id="kontak-uji">{t("kontak.uji")}</button>
            <button type="button" class="btn btn-outline" id="kontak-hapus" hidden={!cfg.terpasang}>{t("kontak.hapus")}</button>
            <button type="submit" class="btn btn-primary" id="kontak-save">{t("common.save")}</button>
          </div>
          <p class="integrasi-hasil" id="kontak-hasil" hidden></p>
        </form>

        <section class="panel analitik-note">
          <p>{t("kontak.privasi")}</p>
        </section>
      </section>
    </main>
  </div>

  <script src="../../scripts/admin-shell.js"></script>

  <script define:vars={{ texts }}>
    /* Skrip halaman Kontak.
     *
     * Berdiri sendiri: halaman ini tidak memuat admin.js, jadi tidak ada esc(),
     * tidak ada toast(), dan tidak ada kamus. Teks datang dari `texts` yang
     * sudah diterjemahkan di server, dan seluruh keluarannya dipasang lewat
     * `textContent` — tidak ada satu pun HTML yang dirakit dari string di sini. */
    (function () {
      const form = document.getElementById("kontak-form");
      if (!form) return;

      const state = document.getElementById("kontak-state");
      const hasil = document.getElementById("kontak-hasil");
      const tombolSimpan = document.getElementById("kontak-save");
      const tombolUji = document.getElementById("kontak-uji");
      const tombolHapus = document.getElementById("kontak-hapus");

      const nilaiForm = () => ({
        host: form.elements.host.value.trim(),
        port: form.elements.port.value.trim(),
        user: form.elements.user.value.trim(),
        pass: form.elements.pass.value,
        from: form.elements.from.value.trim(),
        secure: form.elements.secure.checked,
      });

      function pesan(teks, kelas) {
        hasil.hidden = false;
        hasil.textContent = teks;
        hasil.className = "integrasi-hasil" + (kelas ? " " + kelas : "");
      }

      function teksGalat(data) {
        let s = (data && texts.galat[data.errorKey]) || (data && data.error) || texts.galat["err.badJson"];
        const vars = (data && data.errorVars) || {};
        for (const [k, v] of Object.entries(vars)) s = s.split("{" + k + "}").join(String(v));
        return s;
      }

      function tandaiStatus(cfg) {
        const el = document.querySelector('[data-status]');
        if (!el) return;
        el.classList.toggle("is-on", !!cfg.terpasang);
        el.textContent = cfg.terpasang ? el.getAttribute("data-on") : el.getAttribute("data-off");
        tombolHapus.hidden = !cfg.terpasang;
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        tombolSimpan.disabled = true;
        state.textContent = texts.saving;
        try {
          const res = await fetch("/api/smtp", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(nilaiForm()),
          });
          if (res.status === 401) { location.href = "/admin/login"; return; }
          const data = await res.json().catch(() => null);
          if (!res.ok || !data || !data.ok) {
            pesan(teksGalat(data), "is-off");
            state.textContent = texts.ready;
            return;
          }
          form.elements.pass.value = "";
          tandaiStatus(data);
          state.textContent = texts.saved;
          pesan(texts.saved, "is-ok");
        } catch (err) {
          pesan(texts.galat["err.badJson"], "is-off");
          state.textContent = texts.ready;
        } finally {
          tombolSimpan.disabled = false;
        }
      });

      document.addEventListener("click", async (e) => {
        if (e.target.closest("#kontak-uji")) {
          tombolUji.disabled = true;
          state.textContent = texts.saving;
          pesan("", "");
          try {
            const ke = form.elements.ujiKe.value.trim();
            const res = await fetch("/api/smtp", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ ke }),
            });
            if (res.status === 401) { location.href = "/admin/login"; return; }
            const data = await res.json().catch(() => null);
            if (!res.ok || !data || !data.ok) {
              pesan(teksGalat(data), "is-off");
              state.textContent = texts.ready;
              return;
            }
            state.textContent = texts.saved;
            pesan(texts.ujiOk, "is-ok");
          } catch (err) {
            pesan(texts.galat["err.badJson"], "is-off");
            state.textContent = texts.ready;
          } finally {
            tombolUji.disabled = false;
          }
          return;
        }

        if (e.target.closest("#kontak-hapus")) {
          tombolHapus.disabled = true;
          state.textContent = texts.saving;
          try {
            const res = await fetch("/api/smtp", { method: "DELETE" });
            if (res.status === 401) { location.href = "/admin/login"; return; }
            const data = await res.json().catch(() => null);
            if (!res.ok || !data || !data.ok) {
              pesan(teksGalat(data), "is-off");
              state.textContent = texts.ready;
              return;
            }
            form.reset();
            form.elements.port.value = "587";
            tandaiStatus(data);
            state.textContent = texts.saved;
            pesan(texts.saved, "is-ok");
          } catch (err) {
            pesan(texts.galat["err.badJson"], "is-off");
            state.textContent = texts.ready;
          } finally {
            tombolHapus.disabled = false;
          }
        }
      });
    })();
  </script>
</Base>
