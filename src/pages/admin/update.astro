---
import Base from "../../layouts/Base.astro";
import AdminSidebar from "../../components/AdminSidebar.astro";
import "../../styles/admin.css";
import { currentUser } from "../../lib/auth";
import { markdownToHtml } from "../../lib/markdown";
import { getEnv } from "../../lib/env";
import { fetchReleases, compareVersions } from "../../lib/releases";
import { readContent } from "../../lib/store";
import { can } from "../../lib/users";
import { makeT, localeMeta, intlLocale } from "../../lib/i18n/index.js";
import fs from "node:fs";
import path from "node:path";

const me = currentUser(Astro.cookies);
if (!me) {
  return Astro.redirect("/admin/login");
}
// Pembaruan mengganti berkas aplikasi dan me-restart server; editor tidak
// punya akses ke sana, jadi halamannya pun tidak dibuka untuk mereka.
if (!can(me, "update")) {
  return Astro.redirect("/admin");
}

const locale = me.locale;
const t = makeT(locale);
const lang = localeMeta(locale);

const REPO = getEnv("GITHUB_REPO", "EVKita/EVKita");

/* Warna aksen diambil dari pengaturan situs supaya halaman ini memakai warna
   yang sama dengan /admin, yang menerapkannya lewat JavaScript setelah konten
   selesai dimuat. */
const site = readContent().site || {};

let currentVersion = "dev";
try {
  const pkg = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), "package.json"), "utf8"));
  currentVersion = pkg.version || "dev";
} catch {
  /* ignore */
}

const { releases, error } = await fetchReleases(REPO);

const latest = releases[0];
const previous = releases.slice(1, 4); // tiga versi sebelumnya
const updateAvailable = !!latest && compareVersions(latest.tag_name, currentVersion) > 0;
const canAutoUpdate = fs.existsSync(path.resolve(process.cwd(), "deploy.sh"));

const zipOf = (r: (typeof releases)[number]) => r.assets.find((a) => a.name.endsWith(".zip"));
const mb = (bytes: number) => `${(bytes / 1048576).toFixed(1)} MB`;
const tanggal = (iso: string) =>
  iso ? new Date(iso).toLocaleDateString(intlLocale(locale), { day: "numeric", month: "long", year: "numeric" }) : "";

/* Teks yang dipakai skrip di bawah. Skrip itu berjalan di browser dan tidak
   memuat kamus, jadi teksnya dirakit di server lalu dikirim lewat define:vars. */
const texts = {
  steps: ["prepare", "download", "verify", "backup", "install", "reload"].map((k) => ({
    label: t(`update.step.${k}`),
    note: t(`update.note.${k}`),
  })),
  installing: t("update.installing"),
  installingBtn: t("update.installingBtn"),
  retry: t("update.retry"),
  doneNote: t("update.doneNote"),
  failed: t("update.failed"),
  failedGeneric: t("update.failedGeneric"),
  reasons: {
    "process-gone": t("update.reason.processGone"),
    "no-start": t("update.reason.noStart"),
    stale: t("update.reason.stale"),
  },
  reconnecting: t("update.reconnecting"),
  timeout: t("update.timeout"),
  cannotStart: t("update.cannotStart"),
  cannotReach: t("update.cannotReach"),
  confirmInstall: t("update.confirmInstall"),
  // Tanpa argumen, placeholder {version} dibiarkan utuh dan diisi di browser.
  done: t("update.done"),
};
---

<Base title={`${t("update.title")} — EVKita`} bodyClass="admin-ui" lang={lang.html} theme={{ primary: site.themePrimary, secondary: site.themeSecondary }}>
  <div id="admin-app" class="admin-app">
    <!-- Lapisan gelap khusus mode drawer (≤900px); klik untuk menutup sidebar. -->
    <div id="sidebar-scrim" class="sidebar-scrim"></div>

    <AdminSidebar mode="link" active="update" locale={locale} role={me.role} />

    <header id="admin-topbar" class="admin-topbar">
      <button id="sidebar-toggle" class="btn btn-icon" type="button" aria-label={t("nav.collapse")}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>

      <div class="topbar-heading">
        <span class="topbar-heading-eyebrow">{t("topbar.adminPanel")}</span>
        <strong>{t("update.title")}</strong>
      </div>

      <div class="topbar-right">
        <span class="topbar-tag">v{currentVersion}</span>
        <button id="themeToggle" class="btn btn-icon" type="button" aria-label={t("topbar.themeToggle")} title={t("topbar.themeToggle")}>
          <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
          <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
        </button>
        <button id="logout" class="btn btn-ghost btn-sm" type="button">{t("topbar.logout")}</button>
      </div>
    </header>

    <main id="admin-main" class="admin-main">
      <section class="view view-narrow">
        <div class="view-head">
          <div>
            <h1 class="view-title">{t("update.title")}</h1>
            <p class="view-sub">{t("update.sub")}</p>
          </div>
          <div class="view-head-actions">
            <a class="btn btn-ghost btn-sm" href={`https://github.com/${REPO}/releases`} target="_blank" rel="noopener">
              {t("update.allReleases")}
            </a>
          </div>
        </div>

        {error && (
          <div class="panel upd-note upd-error">
            <strong>{t("update.loadFailed")}</strong> {error}{" "}
            <a href={`https://github.com/${REPO}/releases`} target="_blank" rel="noopener">{t("update.openOnGithub")}</a>
          </div>
        )}

        {!error && !latest && (
          <div class="panel upd-note">
            {t("update.noReleases", { repo: REPO })}
          </div>
        )}

        {!error && latest && (
          <section class={`upd-hero ${updateAvailable ? "is-outdated" : "is-current"}`}>
            <div class="upd-hero-top">
              <div>
                <span class="upd-badge">{updateAvailable ? t("update.available") : t("update.upToDate")}</span>
                <h2 class="upd-version">{latest.tag_name}</h2>
                <p class="upd-meta">
                  {t("update.releasedOn", { date: tanggal(latest.published_at) })}
                  {zipOf(latest) && <> · {zipOf(latest)!.name} · {mb(zipOf(latest)!.size)}</>}
                </p>
              </div>
              <div class="upd-nowbox">
                <span class="upd-nowbox-l">{t("update.installedVersion")}</span>
                <span class="upd-nowbox-v">v{currentVersion}</span>
              </div>
            </div>

            <div class="upd-cta">
              {updateAvailable && canAutoUpdate && (
                <button class="btn btn-primary" id="btn-update" type="button">
                  {t("update.installButton", { version: latest.tag_name })}
                </button>
            )}
              {updateAvailable && !canAutoUpdate && (
                <span class="upd-meta">{t("update.noDeployScript")}</span>
            )}
              {!updateAvailable && <span class="upd-meta">{t("update.nothingToInstall")}</span>}
              <a class="btn btn-ghost" href={latest.html_url} target="_blank" rel="noopener">{t("update.viewOnGithub")}</a>
            </div>

            <div class="upd-progress" id="progress" hidden>
              <div class="upd-prog-top">
                <span class="upd-prog-icon" aria-hidden="true"></span>
                <div class="upd-prog-heading">
                  <strong id="progress-title">{t("update.installing")}</strong>
                  <span class="upd-prog-route">
                    v{currentVersion} <span class="upd-prog-arrow" aria-hidden="true">→</span> {latest.tag_name}
                  </span>
                </div>
                <div class="upd-prog-pct"><span id="prog-pct">0</span><small>%</small></div>
              </div>

              <div
                class="upd-bar"
                id="prog-bar"
                role="progressbar"
                aria-label={t("update.progressLabel")}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
              >
                <div class="upd-bar-fill" id="prog-fill"></div>
              </div>

              <p class="upd-prog-note">
                <span id="progress-note">{t("update.note.prepare")}</span>
                <span class="upd-prog-time" id="prog-time">00:00</span>
              </p>

              <ol class="upd-steps" id="prog-steps"></ol>

              <p class="upd-prog-hint">{t("update.dontClose")}</p>

              <details class="upd-logbox" id="prog-logbox">
                <summary>{t("update.techLog")}</summary>
                <pre class="upd-log" id="progress-log" aria-live="polite"></pre>
              </details>
            </div>

            <div class="upd-changelog">
              <h3>{t("update.whatsNew")}</h3>
              <div class="upd-body" set:html={markdownToHtml(latest.body || `*${t("update.noReleaseNotes")}*`)} />
            </div>
          </section>
        )}

        {!error && previous.length > 0 && (
          <section class="upd-history">
            <h2>{t("update.previousVersions")}</h2>
            {previous.map((r) => (
              <details class="upd-acc">
                <summary>
                  <span class="upd-acc-v">{r.tag_name}</span>
                  <span class="upd-acc-d">{tanggal(r.published_at)}</span>
                  {r.tag_name.replace(/^v/, "") === currentVersion && (
                    <span class="upd-acc-tag">{t("update.installedTag")}</span>
                  )}
                  <span class="upd-acc-chev" aria-hidden="true"></span>
                </summary>
                <div class="upd-acc-body">
                  <div class="upd-body" set:html={markdownToHtml(r.body || `*${t("update.noReleaseNotes")}*`)} />
                  <a class="btn btn-ghost btn-sm" href={r.html_url} target="_blank" rel="noopener">{t("update.viewOnGithub")}</a>
                </div>
              </details>
            ))}
          </section>
        )}
      </section>
    </main>
  </div>

  <script src="../../scripts/admin-shell.js"></script>

  <script define:vars={{ texts }}>
    const btn = document.getElementById("btn-update");
    const box = document.getElementById("progress");
    const title = document.getElementById("progress-title");
    const note = document.getElementById("progress-note");
    const log = document.getElementById("progress-log");
    const logbox = document.getElementById("prog-logbox");
    const bar = document.getElementById("prog-bar");
    const fill = document.getElementById("prog-fill");
    const pct = document.getElementById("prog-pct");
    const time = document.getElementById("prog-time");
    const stepList = document.getElementById("prog-steps");

    if (btn && box) {
      // Tahapan deploy.sh. `match` dicocokkan ke isi log: tahap yang cocok
      // paling akhir dianggap tahap yang sedang berjalan. `from`/`to` adalah
      // rentang persen tahap itu, `speed` perkiraan lamanya dalam milidetik —
      // bilah tetap merayap halus di dalam rentangnya walau log belum berubah,
      // jadi progres tidak pernah terlihat macet.
      // `speed` disetel mendekati lama tahap yang sebenarnya (diukur: seluruh
      // deploy ±5 detik). Angka yang jauh lebih besar membuat bilah merayap
      // pelan padahal kerjanya sudah selesai — pembaruan jadi terasa lambat
      // walau tidak.
      // Label dan catatan datang dari server (sudah diterjemahkan); pola
      // `match` dicocokkan ke keluaran deploy.sh, yang selalu Bahasa Indonesia
      // berapa pun bahasa panelnya — jadi pola itu TIDAK boleh diterjemahkan.
      const SHAPE = [
        { from: 2, to: 8, speed: 1200 },
        { from: 8, to: 44, speed: 4000, match: /==> (Deploy dari|Mengunduh paket)/ },
        { from: 46, to: 58, speed: 1200, match: /(^|\n)Downloaded |==> Memeriksa isi paket/ },
        { from: 60, to: 68, speed: 1200, match: /==> Mencadangkan/ },
        { from: 70, to: 86, speed: 1500, match: /==> Memasang berkas baru/ },
        { from: 88, to: 97, speed: 3000, match: /==> Restart PM2/ },
      ];
      const STEPS = SHAPE.map((shape, i) => Object.assign({}, shape, texts.steps[i]));

      const chips = STEPS.map((s) => {
        const li = document.createElement("li");
        li.className = "upd-step";
        li.textContent = s.label;
        stepList.appendChild(li);
        return li;
      });

      let stage = 0;
      let stageSince = Date.now();
      let startedAt = Date.now();
      let shown = 0;
      let outcome = null; // null | "done" | "failed"
      let settled = false;
      let ticker = 0;

      // Saat gagal, tahap yang sedang berjalan ditandai silang — bukan ikut
      // dicentang — supaya terlihat di mana pembaruan berhenti.
      const paintChips = () => {
        chips.forEach((li, i) => {
          li.classList.toggle("is-done", outcome === "done" || i < stage);
          li.classList.toggle("is-active", !outcome && i === stage);
          li.classList.toggle("is-failed", outcome === "failed" && i === stage);
        });
      };

      const setStage = (i) => {
        if (settled || i <= stage) return;
        stage = i;
        stageSince = Date.now();
        note.textContent = STEPS[i].note;
        paintChips();
      };

      const setPercent = (value) => {
        const v = Math.max(0, Math.min(100, value));
        shown = Math.max(shown, v);
        const rounded = Math.round(shown);
        fill.style.width = `${shown}%`;
        pct.textContent = String(rounded);
        bar.setAttribute("aria-valuenow", String(rounded));
      };

      const clock = () => {
        const s = Math.floor((Date.now() - startedAt) / 1000);
        time.textContent = `${String(Math.floor(s / 60)).padStart(2, "0")}:${String(s % 60).padStart(2, "0")}`;
      };

      const tick = () => {
        clock();
        if (settled) return;
        const s = STEPS[stage];
        // Perayapan melambat mendekati batas atas tahap: tidak pernah
        // menyentuh `to` sebelum log tahap berikutnya benar-benar muncul.
        const t = (Date.now() - stageSince) / s.speed;
        setPercent(s.from + (s.to - s.from) * (1 - Math.exp(-t)));
      };

      const readLog = (text) => {
        if (typeof text !== "string" || !text) return;
        if (log.textContent !== text) {
          const stick = log.scrollTop + log.clientHeight >= log.scrollHeight - 24;
          log.textContent = text;
          if (stick) log.scrollTop = log.scrollHeight;
        }
        for (let i = STEPS.length - 1; i > stage; i--) {
          if (STEPS[i].match && STEPS[i].match.test(text)) {
            setStage(i);
            break;
          }
        }
      };

      const REASONS = texts.reasons;

      const finish = (ok, message, reason) => {
        settled = true;
        outcome = ok ? "done" : "failed";
        box.classList.add(ok ? "is-done" : "is-failed");
        title.textContent = message;
        paintChips();
        if (ok) {
          setPercent(100);
          note.textContent = texts.doneNote;
          setTimeout(() => location.reload(), 700);
        } else {
          note.textContent = REASONS[reason] || texts.failedGeneric;
          logbox.open = true;
          if (btn) {
            btn.disabled = false;
            btn.textContent = texts.retry;
          }
        }
        clock();
        clearInterval(ticker);
      };

      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

      // Batas waktu per permintaan: saat PM2 memuat ulang aplikasi, koneksi
      // bisa menggantung. Tanpa batas ini polling ikut berhenti berdenyut.
      const ask = async () => {
        const ac = new AbortController();
        const t = setTimeout(() => ac.abort(), 4000);
        try {
          const res = await fetch("/api/update", {
            headers: { Accept: "application/json" },
            cache: "no-store",
            signal: ac.signal,
          });
          if (!res.ok) return null;
          return await res.json();
        } catch {
          return null;
        } finally {
          clearTimeout(t);
        }
      };

      // Selama pembaruan, PM2 memuat ulang aplikasi sehingga beberapa
      // permintaan pasti gagal. Itu normal: kegagalan diabaikan dan polling
      // diteruskan sampai batas waktu.
      const poll = async () => {
        const deadline = Date.now() + 10 * 60 * 1000;
        let misses = 0;
        while (Date.now() < deadline && !settled) {
          const data = await ask();
          if (data) {
            misses = 0;
            readLog(data.log);
            if (data.state === "done") return finish(true, texts.done.replace("{version}", data.version));
            if (data.state === "failed") return finish(false, texts.failed, data.reason);
            note.textContent = STEPS[stage].note;
          } else if (++misses >= 2) {
            note.textContent = texts.reconnecting;
          }
          await sleep(misses ? 1200 : 700);
        }
        if (!settled) finish(false, texts.timeout);
      };

      const showPanel = (since) => {
        startedAt = Number(since) || Date.now();
        stageSince = Date.now();
        box.hidden = false;
        paintChips();
        clearInterval(ticker);
        ticker = setInterval(tick, 120);
        tick();
        if (btn) {
          btn.disabled = true;
          btn.textContent = texts.installingBtn;
        }
      };

      btn.addEventListener("click", async () => {
        if (!confirm(texts.confirmInstall)) {
          return;
        }
        box.classList.remove("is-done", "is-failed");
        settled = false;
        outcome = null;
        stage = 0;
        shown = 0;
        log.textContent = "";
        note.textContent = STEPS[0].note;
        title.textContent = texts.installing;
        showPanel(Date.now());

        try {
          // Content-Type wajib diisi: proteksi CSRF bawaan Astro menolak POST
          // tanpa content-type dengan 403.
          const res = await fetch("/api/update", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: "{}",
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || !data.ok) {
            return finish(false, data.error || texts.cannotStart);
          }
        } catch {
          return finish(false, texts.cannotReach);
        }
        poll();
      });

      // Pembaruan me-restart aplikasi, jadi halaman ini bisa saja ter-reload
      // di tengah proses. Kalau di server masih ada pembaruan yang berjalan,
      // sambung lagi progresnya alih-alih menampilkan keadaan diam.
      (async () => {
        const data = await ask();
        if (!data || data.state !== "running") return;
        showPanel(data.startedAt);
        readLog(data.log);
        poll();
      })();
    }
  </script>
</Base>
