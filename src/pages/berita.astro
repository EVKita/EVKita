---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { readContent } from "../lib/store";
import { hanyaTayang } from "../lib/tayang.js";
import { safeUrl } from "../lib/url.js";
import { siteOrigin, canonicalUrl } from "../lib/site-url";
import { makePubT, normalizePubLocale, cmsSite, pubIntl } from "../lib/i18n/pub.js";
import { terjemahContent } from "../lib/terjemahan.js";
import { gambarBerita, kunciKanonik, petaGambarBerita } from "../lib/berita-gambar";
import { SUMBER_BERITA } from "../lib/berita-sumber.js";

/**
 * Daftar berita kurasi yang penuh.
 *
 * Beranda hanya menampilkan berita sebagai seksi di antara seksi lain; halaman
 * ini menampilkannya semua sekaligus. Kartunya tautan KELUAR ke situs
 * penerbitnya — sama seperti di beranda — karena isi lengkapnya memang tinggal
 * di sana, bukan di sini.
 *
 * Urutannya sama dengan beranda: yang bertanda `featured` naik ke atas,
 * sisanya menjaga urutan aslinya.
 */
const content = await terjemahContent(readContent(), Astro.locals?.pubLang);

const lang = normalizePubLocale(Astro.locals?.pubLang);
const t = makePubT(lang);

/** Setelan situs diterjemahkan sekali di sini — seluruh pembacaan `site.x`
 *  di bawah ini otomatis ikut bahasa yang dipilih pembaca. */
const site = cmsSite(content.site, lang);
const brand = site.brandText || "EVKita";
const brandFull = `${brand}${site.brandSuffix || ""}`;

/** Komunitas memakai bendera yang sama dengan berita — keduanya satu seksi
 *  "Berita & Komunitas" di beranda, jadi dimatikan lewat saklar yang sama. */
if (!site.showBerita) Astro.response.status = 404;

/** Item bertanda `featured` naik ke atas — sisanya menjaga urutan aslinya. */
const byFeatured = (list: any[]) => [...list].sort((a, b) => Number(!!b.featured) - Number(!!a.featured));

/** Draf dan yang belum tiba jadwalnya tidak boleh bocor ke halaman publik. */
const beritaList = site.showBerita ? byFeatured((content.berita || []).filter(hanyaTayang())) : [];

/**
 * Foto tiap kartu: `n.image` (bawaan feed RSS) diutamakan; yang kosong
 * dilengkapi dari og:image halaman sumbernya (cache 7 hari di
 * `data/berita-gambar.json`). Baris yang tetap tanpa foto tampil teks saja.
 */
const thumbBerita = await petaGambarBerita(beritaList.map((n: any) => String(n?.url || "")));
const fotoBerita = (n: any) =>
  safeUrl(n.image) || thumbBerita[kunciKanonik(String(n?.url || ""))] || "";

const judul = site.beritaTitle || t("pub.dir.pageBerita");
const lead = site.beritaNote || t("pub.dir.leadBerita");

const origin = siteOrigin(Astro.url);
const canonical = canonicalUrl(Astro.url);

const pageTitle = site.showBerita ? `${judul} — ${brandFull}` : `${t("pub.koleksi.notFound")} — ${brand}`;
const metaDesc = site.showBerita ? lead : t("pub.laman.404Text");
const localeTag = pubIntl(lang);

const jsonLd = site.showBerita
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": canonical,
          url: canonical,
          name: pageTitle,
          description: metaDesc,
          inLanguage: localeTag,
          isPartOf: { "@type": "WebSite", name: brandFull, url: `${origin}/` },
        },
        {
          "@type": "ItemList",
          name: judul,
          numberOfItems: beritaList.length,
          itemListElement: beritaList.map((n: any, i: number) => ({
            "@type": "ListItem",
            position: i + 1,
            name: n.title,
            ...(safeUrl(n.url) ? { url: safeUrl(n.url) } : {}),
          })),
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: t("pub.nav.beranda"), item: `${origin}/` },
            { "@type": "ListItem", position: 2, name: judul, item: canonical },
          ],
        },
      ],
    }
  : null;
---

<Base
  title={pageTitle}
  description={metaDesc}
  keywords={site.seoKeywords}
  ogImage={site.seoOgImage}
  site={site}
>
  {jsonLd ? <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} /> : null}

  <SiteHeader site={site} base="/" active="" />

  {!site.showBerita ? (
    <main class="container notfound" id="konten">
      <p class="notfound-code">404</p>
      <h1>{t("pub.koleksi.notFound")}</h1>
      <p class="notfound-text">
        {t("pub.laman.404Text")}
      </p>
      <a class="btn btn-primary" href="/">{t("pub.laman.kembali")}</a>
    </main>
  ) : (
    <main class="container katalog" id="konten">
      <nav class="breadcrumb" aria-label={t("pub.breadcrumb")}>
        <a href="/">{t("pub.nav.beranda")}</a>
        <span aria-hidden="true">/</span>
        <span class="breadcrumb-current">{judul}</span>
      </nav>

      <header class="katalog-head">
        <h1>{judul}</h1>
        <p class="katalog-lead">{lead}</p>
        <p class="katalog-lead">{t("pub.dir.hitungBerita", { n: beritaList.length })}</p>
      </header>

      {/*
        Cara membaca + sumber + FAQ: menjawab tiga hal yang paling sering
        membingungkan — kenapa tautan keluar, seberapa segar daftarnya, dan
        dari mana kabarnya. Nama medianya proper noun, tanpa kunci terjemahan.
      */}
      <section class="kalk-section">
        <h2>{t("pub.beritaX.panduanT")}</h2>
        <p class="section-note">{t("pub.beritaX.panduanD")}</p>
        <p class="section-note"><strong>{t("pub.beritaX.sumberT")}:</strong> {SUMBER_BERITA.map((s: any) => s.nama).join(" · ")}</p>
      </section>

      <section class="kalk-section">
        <h2>{t("pub.beritaX.faqT")}</h2>
        <div class="faq-list">
          <details class="faq-item">
            <summary>{t("pub.beritaX.faq1q")}</summary>
            <p>{t("pub.beritaX.faq1a")}</p>
          </details>
          <details class="faq-item">
            <summary>{t("pub.beritaX.faq2q")}</summary>
            <p>{t("pub.beritaX.faq2a")}</p>
          </details>
          <details class="faq-item">
            <summary>{t("pub.beritaX.faq3q")}</summary>
            <p>{t("pub.beritaX.faq3a")}</p>
          </details>
        </div>
      </section>

      <div class="news-grid">
        {beritaList.map((n: any) => (
          <a class={`news-card${n.featured ? " is-featured" : ""}`} href={safeUrl(n.url) || "#"} target={safeUrl(n.url) ? "_blank" : undefined} rel={safeUrl(n.url) ? "noopener" : undefined}>
            {fotoBerita(n) ? (
              <div class="news-thumb"><img src={fotoBerita(n)} alt="" loading="lazy" referrerpolicy="no-referrer" data-thumb-berita /></div>
            ) : null}
            <div class="news-body">
              <div class="news-top">
                {n.source ? <span class="news-source">{n.source}</span> : null}
                {n.featured ? <span class="badge badge-featured">{t("pub.sorotan")}</span> : null}
              </div>
              <h3 class="news-title">{n.title}</h3>
              {n.excerpt ? <p class="news-excerpt">{n.excerpt}</p> : null}
              <div class="news-foot">
                {n.date ? <span class="news-date">{n.date}</span> : <span></span>}
                <span class="dir-link">{t("pub.read")} →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </main>
  )}

  <SiteFooter site={site} base="/" />

  <script>
    /*
     * Foto berita adalah hotlink ke situs penerbit — kalau gambarnya mati,
     * sembunyikan kotaknya supaya kartu kembali tampil teks saja.
     * Tanpa inline handler (CSP): galat didengarkan di fase capture.
     */
    (function () {
      document.addEventListener(
        "error",
        function (e) {
          var t = e.target;
          if (t && t.hasAttribute && t.hasAttribute("data-thumb-berita")) {
            var box = t.closest ? t.closest(".news-thumb") : null;
            if (box) box.remove();
            else t.remove();
          }
        },
        true
      );
    })();
  </script>
</Base>
