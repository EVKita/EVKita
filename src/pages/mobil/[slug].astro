---
import VehicleDetail from "../../components/VehicleDetail.astro";
import { readContent } from "../../lib/store";
import { verifyPreviewToken } from "../../lib/pratinjau";

/**
 * Halaman detail satu mobil.
 *
 * Seluruh isinya ada di `VehicleDetail.astro`, yang dipakai bersama halaman
 * motor: struktur datanya identik, jadi dua salinan hanya berarti setiap
 * perbaikan harus diingat dua kali. Yang tersisa di sini cuma yang memang
 * khas rute ini — mencari kendaraannya, dan menjawab alamat yang salah kamar.
 */
const content = readContent();
const slug = String(Astro.params.slug || "");

const isLive = (v: any) => v && v.status !== "draft";
const cars = (content.cars || []).filter(isLive);
let car = cars.find((c: any) => c.id === slug);

/**
 * Jalur pratinjau: mobil berstatus draf boleh tampil, tapi hanya kepada
 * pemegang tautan bertanda tangan untuk mobil ITU — lihat `pratinjau.ts`.
 *
 * Yang tidak ikut berubah adalah `cars` yang diteruskan sebagai `pool`. Daftar
 * itu memasok kendaraan terkait dan lawan perbandingan, dan draf tidak boleh
 * bocor ke sana lewat halaman mana pun, termasuk halamannya sendiri.
 */
let pratinjau = false;
if (!car && verifyPreviewToken(Astro.url.searchParams.get("pratinjau"), "cars", slug)) {
  const draf = (content.cars || []).find((c: any) => c.id === slug);
  if (draf) {
    car = draf;
    pratinjau = true;
  }
}

if (!car) {
  /**
   * Slug motor dialihkan PERMANEN ke halaman motornya.
   *
   * Sebelum `/motor/<slug>` ada, alamat ini melempar pembaca ke katalog
   * beranda dengan mode motor — jalan keluar terbaik yang tersedia saat itu.
   * Sekarang halaman yang dimaksud benar-benar ada, jadi 301: URL lama sudah
   * beredar, dan membiarkannya menjawab 404 membuat tautan yang sudah
   * tersebar berhenti bekerja.
   */
  const motor = content.site.showMotor
    ? (content.motors || []).filter(isLive).find((m: any) => m.id === slug)
    : null;
  if (motor) {
    return Astro.redirect(`/motor/${encodeURIComponent(motor.id)}`, 301);
  }
  // Kendaraan draft/terhapus harus menjawab 404 sungguhan supaya mesin
  // pencari melepas URL-nya, bukan diam-diam dilempar ke beranda.
  Astro.response.status = 404;
}
---

<VehicleDetail site={content.site} vehicle={car || null} pool={cars} kind="mobil" media={content.media} pratinjau={pratinjau} />
