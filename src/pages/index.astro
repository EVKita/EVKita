---
import Base from "../layouts/Base.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { readContent } from "../lib/store";

const content = readContent();
const { site, cars, motors, spklu, bengkel, berita } = content;
---

<Base title={`${site.brandText} — ${site.heroTitle}`} description={site.heroSub} theme={{ primary: site.themePrimary, secondary: site.themeSecondary }}>
  <header class="masthead">
    <div class="container masthead-inner">
      <a href="/" class="logo">
        <span class="logo-mark">EV</span>
        <span class="logo-text">{site.brandText}<em>.com</em></span>
      </a>
      <nav class="main-nav">
        <a href="/" class="active">Beranda</a>
        <a href="#daftar" data-navmode="mobil">Mobil Listrik</a>
        <a href="#daftar" data-navmode="motor">Motor Listrik</a>
        <a href="#spklu">SPKLU</a>
        <a href="#bengkel">Bengkel</a>
        <a href="#berita">Berita</a>
        <a href="#tentang">Tentang</a>
      </nav>
      <ThemeToggle />
    </div>
  </header>

  <section class="hero">
    <div class="container">
      <p class="hero-eyebrow">{site.heroEyebrow}</p>
      <h1>{site.heroTitle}</h1>
      <p class="hero-sub">{site.heroSub}</p>
      <div class="hero-stats" id="heroStats"></div>
    </div>
  </section>

  <main id="daftar" class="container">
    <div class="mode-toggle" id="modeToggle" style="margin-bottom: 14px;">
      <button type="button" class="mode-btn active" data-mode="mobil">Mobil</button>
      <button type="button" class="mode-btn" data-mode="motor">Motor</button>
    </div>

    <div class="chips-row" id="bodyChips"></div>

    <div class="toolbar">
      <div class="search-wrap">
        <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14Zm8 16-4-4" />
        </svg>
        <input type="search" id="search" placeholder="Cari merek atau model…" autocomplete="off" />
      </div>

      <div class="filter-row">
        <label class="select-field">
          <span>Merek</span>
          <select id="filterBrand"></select>
        </label>

        <label class="select-field">
          <span>Tipe Bodi</span>
          <select id="filterBody"></select>
        </label>

        <label class="select-field">
          <span>Rentang Harga</span>
          <select id="filterPrice"></select>
        </label>

        <label class="select-field">
          <span>Urutkan</span>
          <select id="sortBy">
            <option value="brand">Merek (A–Z)</option>
            <option value="priceAsc">Harga terendah</option>
            <option value="priceDesc">Harga tertinggi</option>
            <option value="rangeDesc" selected>Jarak terjauh</option>
            <option value="batteryDesc">Baterai terbesar</option>
            <option value="powerDesc">Tenaga terbesar</option>
          </select>
        </label>

        <button id="resetFilters" class="btn-reset" type="button">Reset</button>
      </div>
    </div>

    <div class="result-bar">
      <span id="resultCount"></span>
    </div>

    <div class="grid" id="grid"></div>
    <div class="empty" id="empty" hidden>
      <p>Tidak ada model yang cocok dengan filter.</p>
      <button id="emptyReset" class="btn-reset" type="button">Reset semua filter</button>
    </div>

    <section id="spklu" class="dir-section">
      <div class="section-head">
        <h2>SPKLU Indonesia</h2>
        <span class="section-note">Jaringan pengisian daya publik</span>
      </div>
      <div class="dir-grid">
        {spklu.map((s) => (
          <a class="dir-card" href={s.website} target="_blank" rel="noopener">
            <span class="dir-badge">SPKLU</span>
            <h4>{s.name}</h4>
            <p class="dir-operator">{s.operator}</p>
            <p class="dir-meta">{s.area}{s.power ? ` · ${s.power} kW` : ""}</p>
            <span class="dir-link">Kunjungi Situs →</span>
          </a>
        ))}
      </div>
    </section>

    <section id="bengkel" class="dir-section">
      <div class="section-head">
        <h2>Bengkel &amp; Servis EV</h2>
        <span class="section-note">Mobil &amp; motor listrik</span>
      </div>
      <div class="dir-grid">
        {bengkel.map((b) => (
          <a class="dir-card" href={b.website} target="_blank" rel="noopener">
            <span class="dir-badge">{b.type}</span>
            <h4>{b.name}</h4>
            <p class="dir-operator">{b.brand}</p>
            <p class="dir-meta">{b.area}</p>
            <span class="dir-link">Kunjungi Situs →</span>
          </a>
        ))}
      </div>
    </section>

    <section id="berita" class="dir-section">
      <div class="section-head">
        <h2>Berita Terkini</h2>
        <span class="section-note">Mobil &amp; motor listrik</span>
      </div>
      <div class="news-list">
        {berita.map((n) => (
          <a class="news-item" href={n.url} target="_blank" rel="noopener">
            <span class="news-source">{n.source}</span>
            <h4>{n.title}</h4>
            <span class="news-date">{n.date}</span>
            <span class="dir-link">Baca Berita →</span>
          </a>
        ))}
      </div>
    </section>

    <section id="tentang" class="about">
      <h2>{site.aboutTitle}</h2>
      <p>{site.aboutText}</p>
    </section>
  </main>

  <footer id="sumber" class="site-footer">
    <div class="container footer-grid">
      <div>
        <div class="footer-brand">
          <span class="logo-mark">EV</span>
          <span class="logo-text">{site.brandText}<em>.com</em></span>
        </div>
        <p class="footer-about">{site.footerDesc}</p>
      </div>
      <div>
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/">Beranda</a></li>
          <li><a href="#daftar">Mobil Listrik</a></li>
          <li><a href="#spklu">SPKLU</a></li>
          <li><a href="#berita">Berita</a></li>
        </ul>
      </div>
      <div>
        <h4>Sumber Data</h4>
        <ul>
          <li>
            <a href={site.footerSourceUrl} target="_blank" rel="noopener">{site.footerSourceText}</a>
          </li>
        </ul>
      </div>
      <div>
        <h4>Catatan</h4>
        <p class="footer-about">{site.footerNote}</p>
      </div>
    </div>
    <div class="container copyright">
      <span>© 2026 {site.brandText} — {site.footerTitle}.</span>
      <span>Harga &amp; spesifikasi dapat berubah sewaktu-waktu.</span>
    </div>
  </footer>

  <script define:vars={{ cars, motors }}>
    window.__EV_CARS__ = cars;
    window.__EV_MOTORS__ = motors;
  </script>
  <script src="../scripts/app.js"></script>
</Base>
