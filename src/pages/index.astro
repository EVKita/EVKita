  <script>
    /*
     * Panel Mobil&Motor Kita: tiap grup menampilkan 5, tombol "Pilihan lain"
     * membuka 10. Tanpa JavaScript, 5 pertama tetap tampil (atribut `hidden`
     * hanya dibuka oleh skrip ini) — tidak ada konten yang hilang.
     */
    (function () {
      document.addEventListener("click", function (e) {
        var b = e.target && e.target.closest ? e.target.closest("[data-kita-more]") : null;
        if (!b) return;
        var grup = b.closest(".kita-grup");
        if (!grup) return;
        var buka = b.getAttribute("aria-expanded") !== "true";
        var items = grup.querySelectorAll("[data-kita-lebih]");
        for (var i = 0; i < items.length; i++) items[i].hidden = !buka;
        b.setAttribute("aria-expanded", buka ? "true" : "false");
        var teks = b.querySelector("[data-kita-more-teks]");
        if (teks) teks.textContent = buka ? b.getAttribute("data-teks-tutup") : b.getAttribute("data-teks-buka");
        var panah = b.querySelector("[data-kita-more-panah]");
        if (panah) panah.textContent = buka ? " ↑" : " ↓";
      });
    })();
  </script>

  <script>
    /*
     * Foto berita adalah hotlink ke situs penerbit — kalau penerbitnya
     * memblokir atau gambarnya sudah dipindah, sembunyikan kotaknya supaya
     * baris kembali seperti sebelum ada foto. Tanpa inline handler (CSP):
     * galat dim dengarkan di fase capture.
     */
    (function () {
      document.addEventListener(
        "error",
        function (e) {
          var t = e.target;
          if (t && t.hasAttribute && t.hasAttribute("data-thumb-berita")) t.remove();
        },
        true
      );
    })();
  </script>

  <script>
    /*
     * Tanya EVKita: kirim pertanyaan ke /api/ai/tanya, tampilkan jawabannya
     * sebagai percakapan — gelembung pertanyaan, jawaban AI ber-Markdown, lalu
     * kartu ber-foto untuk kendaraan katalog yang disebut. Terbuka untuk umum,
     * tanpa wajib masuk.
     *
     * Keamanan: jawaban model SELALU di-escape lebih dulu, baru Markdown-nya
     * diubah jadi segelintir tag yang kita tulis sendiri (p, ul, ol, li,
     * strong, em, code). Tidak ada tautan, gambar, atau HTML mentah dari model
     * yang bisa lolos — teks dari luar tidak pernah dirender sebagai HTML.
     */
    (function () {
      var akar = document.getElementById("tanyaEvkita");
      if (!akar) return;
      var form = document.getElementById("tanyaForm");
      if (!form) return;
      var masukan = document.getElementById("tanyaInput");
      var tombol = document.getElementById("tanyaKirim");
      var jawab = document.getElementById("tanyaJawab");
      var sisa = document.getElementById("tanyaSisa");
      var chips = document.getElementById("tanyaChips");
      if (!masukan || !tombol || !jawab) return;

      var IKON_AI =
        '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">' +
        '<path fill="currentColor" d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12z" /></svg>';
      var IKON_SALIN =
        '<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">' +
        '<path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ' +
        'd="M9 9h10v10H9zM5 15V5h10" /></svg>';
      var teksTerakhir = "";

      function attr(nama) {
        return akar.getAttribute(nama) || "";
      }

      function esc(s) {
        return String(s || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      /* ---------- Markdown kecil yang aman ---------- */

      /* `s` SUDAH di-escape. Hanya menambah tag milik kita sendiri. */
      function sebaris(s) {
        return s
          .replace(/`([^`\n]+)`/g, "<code>$1</code>")
          .replace(/\*\*(?!\s)([^\n]+?)\*\*/g, "<strong>$1</strong>")
          .replace(/__(?!\s)([^\n]+?)__/g, "<strong>$1</strong>")
          .replace(/(^|[^*\w])\*(?![\s*])([^*\n]+?)\*(?!\w)/g, "$1<em>$2</em>")
          .replace(/(^|[^_\w])_(?![\s_])([^_\n]+?)_(?!\w)/g, "$1<em>$2</em>");
      }

      function markdown(teks) {
        var baris = esc(teks).replace(/\r/g, "").split("\n");
        var out = [];
        var para = [];
        var daftar = null;
        function tutupPara() {
          if (para.length) out.push("<p>" + sebaris(para.join(" ")) + "</p>");
          para = [];
        }
        function tutupDaftar() {
          if (!daftar) return;
          var buka = daftar.tag === "ol" && daftar.mulai > 1 ? '<ol start="' + daftar.mulai + '">' : "<" + daftar.tag + ">";
          out.push(buka + daftar.butir.map(function (b) { return "<li>" + sebaris(b) + "</li>"; }).join("") + "</" + daftar.tag + ">");
          daftar = null;
        }
        for (var i = 0; i < baris.length; i++) {
          var asli = baris[i];
          var t = asli.trim();
          var m;
          if (!t || /^(-{3,}|\*{3,}|_{3,})$/.test(t)) { tutupPara(); tutupDaftar(); continue; }
          if ((m = t.match(/^#{1,6}\s+(.*)$/))) {
            tutupPara(); tutupDaftar();
            out.push('<p class="tanya-md-h">' + sebaris(m[1]) + "</p>");
            continue;
          }
          if ((m = t.match(/^[-*•]\s+(.*)$/))) {
            tutupPara();
            if (!daftar || daftar.tag !== "ul") { tutupDaftar(); daftar = { tag: "ul", butir: [], mulai: 1 }; }
            daftar.butir.push(m[1]);
            continue;
          }
          if ((m = t.match(/^(\d{1,3})[.)]\s+(.*)$/))) {
            tutupPara();
            if (!daftar || daftar.tag !== "ol") { tutupDaftar(); daftar = { tag: "ol", butir: [], mulai: Number(m[1]) || 1 }; }
            daftar.butir.push(m[2]);
            continue;
          }
          /* Baris lanjutan butir (menjorok) tetap milik butir terakhir. */
          if (daftar && /^\s{2,}/.test(asli)) { daftar.butir[daftar.butir.length - 1] += " " + t; continue; }
          tutupDaftar();
          para.push(t);
        }
        tutupPara();
        tutupDaftar();
        return out.join("");
      }

      /* Versi teks polos untuk tombol salin: tanpa penanda Markdown. */
      function teksPolos(teks) {
        return String(teks || "")
          .replace(/\*\*|__/g, "")
          .replace(/(^|\s)[*_](\S)/g, "$1$2")
          .replace(/(\S)[*_](?=\s|[.,;:!?]|$)/g, "$1")
          .replace(/^#{1,6}\s+/gm, "")
          .replace(/^\s*[*•]\s+/gm, "- ")
          .trim();
      }

      /* ---------- Bagian-bagian tampilan ---------- */

      /* err.tanya.kuotaHabis → data-err-kuota-habis. */
      function pesanGalat(errorKey) {
        var akhir = String(errorKey || "").split(".").pop() || "";
        var kebab = akhir.replace(/([A-Z])/g, "-$1").toLowerCase();
        return attr("data-err-" + kebab) || attr("data-err-umum");
      }

      function tampilSisa(n, kuota) {
        if (!sisa) return;
        if (n === undefined || n === null || kuota === undefined || kuota === null) return;
        var tpl = attr("data-sisa-tpl");
        sisa.textContent = tpl.split("{n}").join(String(n)).split("{kuota}").join(String(kuota));
        sisa.hidden = false;
      }

      function kunci(mengunci) {
        masukan.disabled = mengunci;
        tombol.disabled = mengunci;
        akar.classList.toggle("is-sibuk", mengunci);
        if (mengunci) tombol.classList.add("is-loading");
        else tombol.classList.remove("is-loading");
      }

      /* Tautan kartu hanya yang berupa path situs sendiri. */
      function hrefAman(h) {
        var s = String(h || "");
        return s.charAt(0) === "/" && s.charAt(1) !== "/" ? s : "#";
      }

      function gelembungTanya(q) {
        return '<div class="tanya-q"><span class="sr-only">' + esc(attr("data-kamu")) + ": </span>" +
          '<p class="tanya-q-isi">' + esc(q) + "</p></div>";
      }

      function gelembungJawab(isi, kelas) {
        return '<div class="tanya-a' + (kelas ? " " + kelas : "") + '">' +
          '<span class="tanya-a-av" aria-hidden="true">' + IKON_AI + "</span>" +
          '<div class="tanya-a-isi">' + isi + "</div></div>";
      }

      function kartu(k) {
        var nama = esc(k && k.nama);
        var href = esc(hrefAman(k && k.href));
        var meta = esc(k && k.meta);
        var harga = esc(k && k.harga);
        var jenis = k && k.jenis === "motor" ? attr("data-jenis-motor") : attr("data-jenis-mobil");
        var img = String((k && k.image) || "");
        var foto = /^(\/(?!\/)|https:)/i.test(img)
          ? '<img src="' + esc(img) + '" alt="' + nama + '" loading="lazy" decoding="async" />'
          : "";
        return '<a class="tanya-kartu" href="' + href + '">' +
          '<span class="tanya-kartu-foto' + (foto ? "" : " is-kosong") + '">' + foto +
          '<span class="tanya-kartu-jenis">' + esc(jenis) + "</span></span>" +
          '<span class="tanya-kartu-info">' +
          '<span class="tanya-kartu-nama">' + nama + "</span>" +
          (meta ? '<span class="tanya-kartu-meta">' + meta + "</span>" : "") +
          '<span class="tanya-kartu-kaki">' +
          (harga ? '<span class="tanya-kartu-harga">' + harga + "</span>" : "<span></span>") +
          '<span class="tanya-kartu-cta">' + esc(attr("data-lihat")) +
          ' <span aria-hidden="true">→</span></span></span></span></a>';
      }

      function tampil(html) {
        jawab.innerHTML = html;
        jawab.hidden = false;
      }

      function json(nama) {
        try {
          var v = JSON.parse(attr(nama) || "[]");
          return Array.isArray(v) ? v.filter(function (x) { return typeof x === "string" && x; }) : [];
        } catch (e) {
          return [];
        }
      }

      var gerakMinimal = !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);

      /* ---------- Tahap "berpikir": teks status bergilir selama menunggu ---------- */
      var tahap = json("data-tahap");
      var timerTahap = null;
      function mulaiTahap() {
        hentikanTahap();
        var i = 0;
        timerTahap = setInterval(function () {
          var el = document.getElementById("tanyaTahap");
          if (!el || i >= tahap.length - 1) return hentikanTahap();
          i++;
          el.classList.add("is-ganti");
          setTimeout(function () {
            el.textContent = tahap[i];
            el.classList.remove("is-ganti");
          }, 180);
        }, 1600);
      }
      function hentikanTahap() {
        if (timerTahap) clearInterval(timerTahap);
        timerTahap = null;
      }

      /* Urutan muncul bertahap: tiap paragraf/butir/kartu diberi indeks untuk
         jeda animasinya (lihat .tanya-muncul-i di global.css). */
      function urutkanMuncul() {
        var bagian = jawab.querySelectorAll(".tanya-md > *, .tanya-a-aksi, .tanya-judul-blok, .tanya-kartu");
        for (var i = 0; i < bagian.length; i++) {
          bagian[i].classList.add("tanya-muncul-i");
          bagian[i].style.setProperty("--i", String(Math.min(i, 12)));
        }
      }

      /* ---------- Contoh pertanyaan: diacak, lalu digilir bertiga ---------- */
      var kumpulan = chips ? (function () {
        try {
          var v = JSON.parse(chips.getAttribute("data-tanya-pool") || "[]");
          return Array.isArray(v) ? v.filter(function (x) { return typeof x === "string" && x; }) : [];
        } catch (e) {
          return [];
        }
      })() : [];
      for (var k = kumpulan.length - 1; k > 0; k--) {
        var j = Math.floor(Math.random() * (k + 1));
        var tmp = kumpulan[k]; kumpulan[k] = kumpulan[j]; kumpulan[j] = tmp;
      }
      var posisiContoh = 0;
      var timerContoh = null;

      function isiContoh(animasi) {
        if (!chips || kumpulan.length < 3) return;
        var tombolContoh = chips.querySelectorAll("[data-tanya-contoh]");
        for (var n = 0; n < tombolContoh.length; n++) {
          (function (b, q, jeda) {
            function ganti() {
              b.setAttribute("data-tanya-contoh", q);
              b.textContent = q;
            }
            if (!animasi) return ganti();
            setTimeout(function () {
              b.classList.add("is-keluar");
              setTimeout(function () {
                ganti();
                b.classList.remove("is-keluar");
                b.classList.add("is-masuk");
                setTimeout(function () { b.classList.remove("is-masuk"); }, 420);
              }, 260);
            }, jeda);
          })(tombolContoh[n], kumpulan[(posisiContoh + n) % kumpulan.length], n * 110);
        }
        posisiContoh = (posisiContoh + tombolContoh.length) % kumpulan.length;
        /* Di HP baris contoh bisa digeser — set baru selalu mulai dari kiri. */
        if (animasi) setTimeout(function () { chips.scrollTo({ left: 0, behavior: gerakMinimal ? "auto" : "smooth" }); }, 120);
      }

      /* Bergilir tiap 6 detik; berhenti saat disentuh/difokus, saat AI menjawab,
         saat tab tersembunyi, dan untuk pengunjung yang meminta gerak minimal. */
      function gilirContoh(jeda) {
        if (timerContoh) clearInterval(timerContoh);
        timerContoh = null;
        if (jeda || gerakMinimal || !chips || kumpulan.length <= 3) return;
        timerContoh = setInterval(function () {
          if (document.hidden || akar.classList.contains("is-sibuk")) return;
          if (chips.matches(":hover") || chips.contains(document.activeElement)) return;
          isiContoh(true);
        }, 6000);
      }

      isiContoh(false);
      gilirContoh(false);

      /* Di HP jawaban bisa jatuh di bawah layar — gulir secukupnya. */
      function gulirKeJawaban() {
        var r = jawab.getBoundingClientRect();
        var tinggi = window.innerHeight || document.documentElement.clientHeight;
        if (r.top > tinggi * 0.75 || r.top < 0) {
          var halus = !(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
          jawab.scrollIntoView({ behavior: halus ? "smooth" : "auto", block: "start" });
        }
      }

      function tampilHasil(q, data) {
        teksTerakhir = String((data && data.jawaban) || "");
        var daftar = data && Array.isArray(data.kandidat) ? data.kandidat : [];
        var isi = '<div class="tanya-md">' + markdown(teksTerakhir) + "</div>" +
          '<div class="tanya-a-aksi"><button type="button" class="tanya-salin" data-tanya-salin>' +
          IKON_SALIN + "<span>" + esc(attr("data-salin")) + "</span></button></div>";
        var out = gelembungTanya(q) + gelembungJawab(isi, "");
        if (daftar.length) {
          out += '<div class="tanya-kendaraan"><p class="tanya-judul-blok">' + esc(attr("data-judul-katalog")) + "</p>" +
            '<div class="tanya-kartu-daftar' + (daftar.length === 1 ? " is-satu" : "") + '">';
          for (var i = 0; i < daftar.length; i++) out += kartu(daftar[i]);
          out += "</div></div>";
        }
        tampil(out);
        urutkanMuncul();
      }

      async function tanya(pertanyaan) {
        var q = String(pertanyaan || "").trim();
        if (!q) {
          tampil(gelembungJawab("<p>" + esc(pesanGalat("err.tanya.kosong")) + "</p>", "is-galat"));
          masukan.focus();
          return;
        }
        kunci(true);
        gilirContoh(true);
        tampil(
          gelembungTanya(q) +
          gelembungJawab(
            '<div class="tanya-pikir">' +
            '<span class="tanya-ketik" aria-hidden="true"><i></i><i></i><i></i></span>' +
            '<span class="tanya-pikir-teks" id="tanyaTahap">' + esc(tahap[0] || attr("data-menjawab")) + "</span></div>" +
            '<div class="tanya-kerangka" aria-hidden="true"><i></i><i></i><i></i></div>',
            "is-memuat"
          )
        );
        mulaiTahap();
        gulirKeJawaban();
        try {
          var lang = (document.documentElement.getAttribute("lang") || "id").slice(0, 2);
          var res = await fetch("/api/ai/tanya", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({ pertanyaan: q.slice(0, 500), lang: lang }),
          });
          var data = null;
          try { data = await res.json(); } catch (e) { data = null; }
          if (!data || !data.ok) {
            if (data) tampilSisa(data.sisa, data.kuota);
            throw new Error((data && data.errorKey) || "err.tanya.umum");
          }
          tampilHasil(q, data);
          tampilSisa(data.sisa, data.kuota);
          masukan.value = "";
        } catch (err) {
          tampil(gelembungTanya(q) + gelembungJawab("<p>" + esc(pesanGalat(err && err.message)) + "</p>", "is-galat"));
        } finally {
          hentikanTahap();
          kunci(false);
          gilirContoh(false);
        }
      }

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        tanya(masukan.value);
      });

      if (chips) {
        chips.addEventListener("click", function (e) {
          var b = e.target && e.target.closest ? e.target.closest("[data-tanya-contoh]") : null;
          if (!b || tombol.disabled) return;
          masukan.value = b.getAttribute("data-tanya-contoh") || "";
          tanya(masukan.value);
        });
      }

      /* Tombol salin. */
      jawab.addEventListener("click", function (e) {
        var b = e.target && e.target.closest ? e.target.closest("[data-tanya-salin]") : null;
        if (!b || !teksTerakhir) return;
        var label = b.querySelector("span");
        function selesai() {
          b.classList.add("is-ok");
          if (label) label.textContent = attr("data-tersalin");
          setTimeout(function () {
            b.classList.remove("is-ok");
            if (label) label.textContent = attr("data-salin");
          }, 1800);
        }
        try {
          navigator.clipboard.writeText(teksPolos(teksTerakhir)).then(selesai, function () {});
        } catch (err) { /* peramban tanpa clipboard API: diam saja */ }
      });

      /* Foto kartu yang gagal dimuat: tampilkan bingkai kosong, bukan ikon rusak. */
      jawab.addEventListener(
        "error",
        function (e) {
          var t = e.target;
          if (!t || t.tagName !== "IMG") return;
          var bingkai = t.parentNode;
          t.remove();
          if (bingkai && bingkai.classList) bingkai.classList.add("is-kosong");
        },
        true
      );
    })();
  </script>

  <script define:vars={{ carsLite, motorsLite, mediaAltLite }}>
    window.__EV_CARS__ = carsLite;
    window.__EV_MOTORS__ = motorsLite;
    window.__EV_MEDIA_ALT__ = mediaAltLite;
  </script>
  <script define:vars={{ votes }}>
    window.__EV_VOTES__ = votes;
  </script>
  <script src="../scripts/app.js"></script>
</Base>
