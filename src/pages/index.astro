---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ArtikelCard from "../components/ArtikelCard.astro";
import { readContent } from "../lib/store";
import { carSVG, defaultColor } from "../lib/cars-ui.js";
import { safeUrl } from "../lib/url.js";
import { cardHTML, defaultSort, vehicleHref } from "../lib/card-html.js";
import { siteOrigin } from "../lib/site-url";
import { altMapFor, mediaAlt } from "../lib/media.js";
import { hanyaTayang, masihBaru } from "../lib/tayang.js";
import { menuBawaan } from "../lib/footer.js";
import { tautanFooter } from "../lib/laman.js";
import { artikelTayang } from "../lib/artikel.js";
import { makePubT, normalizePubLocale, cms, cmsSite, pubIntl } from "../lib/i18n/pub.js";
import { terjemahContent } from "../lib/terjemahan.js";
import { bacaVotes } from "../lib/vote-store.js";
import { rankVotes, voteRowHtml } from "../lib/vote-html.js";
import { gambarBerita, kunciKanonik, petaGambarBerita } from "../lib/berita-gambar";

const content = await terjemahContent(readContent(), Astro.locals?.pubLang);

const lang = normalizePubLocale(Astro.locals?.pubLang);
const t = makePubT(lang);

/** Setelan situs diterjemahkan sekali di sini — seluruh pembacaan `site.x`
 *  di bawah ini otomatis ikut bahasa yang dipilih pembaca. */
const site = cmsSite(content.site, lang);

/**
 * Kendaraan berstatus draft hanya untuk penyunting — halaman publik tidak
 * boleh menampilkannya, termasuk di baris unggulan maupun data katalog yang
 * disuntik ke klien.
 */
const cars = (content.cars || []).filter(hanyaTayang());
const motors = site.showMotor ? (content.motors || []).filter(hanyaTayang()) : [];
/* Direktori ikut disaring sejak versi ini. Sebelumnya SPKLU, bengkel, dan
   berita langsung tayang begitu tombol Simpan ditekan — tidak ada cara
   menyiapkan sepuluh entri lalu menayangkannya sekaligus, dan tidak ada cara
   menahan sebuah berita sampai waktunya. */
const spklu = (content.spklu || []).filter(hanyaTayang());
const bengkel = (content.bengkel || []).filter(hanyaTayang());
const berita = (content.berita || []).filter(hanyaTayang());
const komunitas = (content.komunitas || []).filter(hanyaTayang());

/**
 * Artikel orisinal yang tayang. Enam yang terbaru saja di beranda — seksi ini
 * yang membuat tulisan baru terhubung dari halaman paling banyak dikunjungi,
 * dan sisanya menunggu di /artikel.
 */
const artikelList = artikelTayang(content.artikel).slice(0, 6);

/** Item bertanda `featured` naik ke atas — sisanya menjaga urutan aslinya. */
const byFeatured = (list: any[]) => [...list].sort((a, b) => Number(!!b.featured) - Number(!!a.featured));

/* `kind` sudah dipasang `normalizeCar()` saat konten dibaca — tidak perlu
   ditempel ulang di sini, dan menempelnya berarti ada dua tempat yang harus
   sepakat soal hal yang sama. */
const featured = [
  ...cars.filter((c: any) => c.featured),
  ...motors.filter((c: any) => c.featured),
].slice(0, 8);

function trimNum(x: number) {
  return String(Math.round(x * 100) / 100);
}

function fmtPrice(v: any) {
  /* Angka didahulukan supaya satuannya ikut bahasa (jt/M/万/亿);
     teks bebas hanya dipakai kalau angkanya memang tidak ada — nilainya
     diisi otomatis dari angka saat menyimpan di panel. */
  if (v.price != null) {
    if (lang === "zh") {
      if (v.price >= 1e8) return t("pub.price.miliar", { n: trimNum(v.price / 1e8) });
      return t("pub.price.juta", { n: trimNum(v.price / 1e4) });
    }
    if (v.price >= 1_000_000_000) return t("pub.price.miliar", { n: (v.price / 1_000_000_000).toFixed(2).replace(".", ",") });
    return t("pub.price.juta", { n: String(Math.round(v.price / 1_000_000)) });
  }
  if (v.priceText) return v.priceText;
  return t("pub.card.priceNa");
}

const heroTitle = site.heroTitle || t("pub.hero.titleFallback", { brand: site.brandText || "" }).trim();
const heroSub = site.heroSub || t("pub.hero.subFallback");

/**
 * Kotak "Tanya EVKita" terbuka untuk umum — siapa pun bisa langsung bertanya
 * tanpa masuk. Pintu masuk anggota (MemberGate) tetap ada sendiri: muncul
 * saat pertama masuk situs dan lewat tombol Masuk di header.
 */

/* Kumpulan contoh pertanyaan Tanya EVKita — diacak dan digilir di peramban. */
const contohTanya = [1, 2, 3, 4, 5, 6, 7, 8, 9].map((n) => t(`pub.tanya.contoh${n}`));

const seoTitle = site.seoTitle || `${site.brandText || "EVKita"} — ${heroTitle}`;
const seoDesc = site.seoDescription || heroSub;

const spkluList = byFeatured(spklu);
const bengkelList = byFeatured(bengkel);
const beritaList = byFeatured(berita);
const komunitasList = byFeatured(komunitas);

/* Etalase direktori: tiga entri pertama, sisanya di halaman penuhnya
   (/spklu, /bengkel, /berita, /komunitas) lewat tombol di bawah tiap grid. */
const TEASER_DIR = 3;

/**
 * Panel "Mobil&Motor Kita": tiga isi — Laris Mobil Kita, Mobil Terbaru Kita,
 * Motor Terbaru Kita — dengan foto asli katalog. "Terbaru" berarti tahun
 * model terbesar, lalu yang paling baru diubah (katalog tidak punya tanggal
 * launching).
 *
 * Laris selalu bisa dibuka sampai 10 baris: yang berangka penjualan tampil
 * sebagai peringkat ("N unit"); kalau angkanya belum ada, slotnya diisi
 * mobil terbaru yang sudah ada di katalog (tampil tahunnya, BUKAN angka
 * unit) sampai auto-update melengkapi angka Gaikindo yang sebenarnya —
 * tidak ada satu pun angka yang dikarang.
 *
 * Angkanya mengejar data Gaikindo tiap bulan lewat jalur yang sudah ada:
 * pemantau menandai kendaraan yang tersangkut sinyal penjualan tiap jam,
 * lalu auto-update katalog meriset ulang yang basi dan menerapkan angka
 * berkeyakinan tinggi langsung — tanpa menunggu klik.
 */
const byLaris = (list: any[]) =>
  list
    .filter((v: any) => v.penjualan2026 !== null && v.penjualan2026 !== undefined && Number(v.penjualan2026) > 0)
    .sort((a: any, b: any) => b.penjualan2026 - a.penjualan2026)
    .slice(0, 10);
const mobilKita = byLaris(cars);
const byTerbaru = (list: any[]) =>
  [...list]
    .sort(
      (a: any, b: any) =>
        Number(b.year || 0) - Number(a.year || 0) ||
        String(b.updatedAt || "").localeCompare(String(a.updatedAt || ""))
    )
    .slice(0, 10);
const mobilBaru = byTerbaru(cars);
/* Slot Laris yang belum berangka diisi data lama (mobil terbaru di luar
   peringkat) — barisnya tampil tahun, bukan unit, sampai angkanya datang. */
const larisAdaAngka = mobilKita.length;
const larisIsi = [
  ...mobilKita,
  ...byTerbaru(cars)
    .filter((v: any) => !mobilKita.some((m: any) => m.id === v.id))
    .slice(0, Math.max(0, 10 - mobilKita.length)),
];
const motorBaru = site.showMotor ? byTerbaru(motors) : [];
/** Baris kedua tiap model terbaru: tahunnya, atau tipenya kalau belum ada. */
const metaBaru = (v: any) => (v.year ? String(v.year) : String(v.bodyType || ""));
const fmtUnit = (n: any) => Number(n).toLocaleString(pubIntl(lang));

/** Panel berita: 5 berita pertama kurasi pemilik, lengkap dengan fotonya. */
const beritaKita = beritaList.slice(0, 5);

/**
 * Foto kecil tiap baris "Berita Terkini": diambil dari situs sumbernya
 * sendiri (og:image halaman yang ditautkan), sekali lalu di-cache di
 * `data/berita-gambar.json`. Pararel dan berbatas waktu per situs — satu
 * penerbit yang lambat tidak menahan beranda. Yang gagal tetap tampil tanpa
 * foto, sama seperti sebelumnya.
 */
const thumbBerita: string[] = await Promise.all(
  beritaKita.map((n: any) => gambarBerita(String(n?.url || "")))
);

/**
 * Foto seksi sorotan berita (3 kartu atas): `n.image` bawaan feed diutamakan,
 * sisanya dilengkapi dari cache og:image yang sama dengan panel samping —
 * supaya kartu /berita, sorotan beranda, panel samping, dan running text
 * selalu memakai daftar berita harian yang sama dengan foto yang sama.
 */
const thumbSorotan = await petaGambarBerita(beritaList.slice(0, 3).map((n: any) => String(n?.url || "")));
const fotoSorotan = (n: any) =>
  safeUrl(n.image) || thumbSorotan[kunciKanonik(String(n?.url || ""))] || "";

/**
 * Panel VoteKita: 10 terfavorit pilihan pengunjung per jenis. Peringkat
 * dihitung dari agregat suara (`data/votes.json`); tanpa suara urutannya
 * mengikuti urutan bawaan katalog. Agregat penuh disuntik ke browser supaya
 * daftar bisa diurut ulang seketika setelah voting tanpa memuat ulang.
 */
const votes = bacaVotes();
const voteMobil = rankVotes(defaultSort(cars), votes.cars, 10);
const voteMotor = site.showMotor ? rankVotes(defaultSort(motors), votes.motors, 10) : [];
/* Total suara sejenis untuk bilah persen ala Shining Awards di tiap baris. */
const totalVoteMobil = voteMobil.reduce((n: number, r: any) => n + (Number(r.votes) || 0), 0);
const totalVoteMotor = voteMotor.reduce((n: number, r: any) => n + (Number(r.votes) || 0), 0);

/** Sorotan SPKLU beranda: entri pertama tampil besar berfoto di kiri. */
const spkluUnggulan = spkluList[0] || null;
const spkluSisi = spkluList.slice(1, TEASER_DIR);

/** Ikon DC/AC kartu SPKLU — sama dengan halaman /spklu. */
const adaAc = (s: any) => String(s?.arus || "").includes("AC");
const adaDc = (s: any) => String(s?.arus || "").includes("DC");

/**
 * Tautan "Jelajahi" — dulu kolom menu di dalam footer, kini seksi sendiri di
 * beranda tepat di bawah katalog. Susunannya dari `menuBawaan()` di
 * src/lib/footer.js, halaman statisnya dari `tautanFooter()`.
 */
const jelajahi = site.showFooterMenu
  ? menuBawaan(site, tautanFooter(content.halaman).menu).map((l: any) => ({
      ...l,
      label: l.i18n ? t(l.i18n) : cms(l.label, lang),
    }))
  : [];

/**
 * Bengkel dipisah menjadi dua kelompok supaya pembaca tidak mencampur servis
 * motor dengan servis mobil. Entri bertipe "Mobil & Motor" tampil di keduanya.
 * Mobil di atas, motor di bawahnya — sama seperti halaman /bengkel.
 */
const bengkelGroups = [
  { title: t("pub.index.grupMobil"), items: bengkelList.filter((b: any) => b.type.includes("Mobil")) },
  { title: t("pub.index.grupMotor"), items: bengkelList.filter((b: any) => b.type.includes("Motor")) },
].filter((g) => g.items.length);

/** Baris meta kartu direktori: hanya yang terisi, supaya kartu tidak bolong. */
function metaRows(pairs: [string, any][]) {
  return pairs.filter(([, v]) => v !== null && v !== undefined && String(v).trim() !== "");
}

/**
 * Tautan lokasi SPKLU. `mapUrl` diisi dari panel; selama kosong, tautannya
 * membuka pencarian Google Maps nama penyedia supaya tombol tidak pernah mati.
 */
function spkluMapUrl(s: any) {
  return safeUrl(s.mapUrl) || `https://www.google.com/maps/search/${encodeURIComponent(`${s.name} SPKLU`)}`;
}

/**
 * Tautan lokasi bengkel. Polanya sama dengan `spkluMapUrl()`: `mapUrl` dari
 * panel dipakai kalau ada, kalau tidak pencarian Google Maps nama bengkelnya.
 * Alamat ikut kalau terisi, tetapi `area` sengaja tidak — isinya "Indonesia"
 * untuk hampir semua entri, dan itu tidak menyempitkan pencarian sedikit pun.
 */
function bengkelMapUrl(b: any) {
  const q = [b.name, b.address].map((v) => String(v || "").trim()).filter(Boolean).join(" ");
  return safeUrl(b.mapUrl) || `https://www.google.com/maps/search/${encodeURIComponent(q)}`;
}

/** Ketersediaan SPKLU untuk mobil dan motor. Jenis kosong dianggap Mobil. */
function spkluJenis(s: any) {
  return {
    mobil: !s.jenis || String(s.jenis).includes("Mobil"),
    motor: String(s.jenis || "").includes("Motor"),
  };
}

/**
 * Katalog yang dirender SERVER.
 *
 * Sebelum ini beranda mengirim `<div id="grid">` yang kosong dan menyerahkan
 * seluruh perenderan ke `app.js`. Perayap yang tidak menjalankan JavaScript —
 * termasuk sebagian besar perayap media sosial dan perayap model bahasa —
 * melihat halaman berisi hero, judul seksi, dan nol kendaraan.
 *
 * Yang dirender di sini adalah halaman pertama dalam urutan bawaan yang sama
 * dengan yang dipakai `app.js`, sehingga kartunya tidak melompat saat skrip
 * selesai dimuat. Begitu pembaca memfilter atau mengurutkan, `app.js` yang
 * mengambil alih — memakai fungsi kartu yang sama persis, jadi keduanya tidak
 * bisa berselisih.
 */
const canonical = `${siteOrigin(Astro.url)}/`;

/* Beranda etalase empat kartu — mengisi penuh baris grid, tidak menyisakan
   slot kosong. Angka 4 ini disamakan dengan HOME_TEASER di src/scripts/app.js. */
const HOME_CARDS = 4;
const initialCards = defaultSort(cars).slice(0, HOME_CARDS);
const initialGrid = initialCards.map((c: any) => cardHTML(c, { linkable: true, media: content.media, t })).join("");

/**
 * Data katalog yang disuntik ke klien dipangkas ke field yang benar-benar
 * dipakai kartu, daftar bandingkan, dan filter. Sebelumnya seluruh objek ikut
 * — deskripsi panjang, galeri, baris spesifikasi bebas — sekitar 40 KB JSON
 * sebaris di setiap pemuatan beranda, padahal halaman detail sudah punya
 * semuanya.
 */
const KATALOG_FIELDS = [
  // `kind` ikut karena `vehicleHref()` memakainya: tanpa itu kartu motor yang
  // dirender ULANG di browser akan menautkan dirinya ke /mobil/.
  "id", "kind", "brand", "name", "bodyType", "tagline", "tags",
  "rangeKm", "rangeStandard", "batteryKwh", "powerHp", "torqueNm",
  "topSpeedKph", "accelSec", "seats", "year", "driveType",
  "chargeDcKw", "chargeAcKw", "chargeTime", "warranty",
  "variants", "variantNames", "colors", "price", "priceText",
  "featured", "stale", "image", "video", "updatedAt",
];
const ringkas = (v: any) =>
  Object.fromEntries(KATALOG_FIELDS.filter((k) => v[k] !== undefined).map((k) => [k, v[k]]));
const carsLite = cars.map(ringkas);
const motorsLite = motors.map(ringkas);

/**
 * Teks alternatif ikut ke browser, tapi hanya alt dan hanya untuk gambar yang
 * benar-benar ada di muatan ini: `app.js` menggambar ULANG kartu setiap kali
 * pembaca memfilter, dan tanpa peta ini alt yang ditulis di Admin → Media akan
 * hilang begitu filter pertama disentuh.
 */
const mediaAltLite = altMapFor(
  content.media,
  [...carsLite, ...motorsLite].map((v: any) => v.image).filter(Boolean)
);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${canonical}#situs`,
      url: canonical,
      name: `${site.brandText || "EVKita"}${site.brandSuffix || ""}`,
      description: seoDesc,
      inLanguage: pubIntl(lang),
    },
    // Daftar kendaraan sebagai ItemList: inilah yang memberi tahu mesin
    // pencari bahwa halaman ini adalah katalog, bukan sekadar halaman muka.
    {
      "@type": "ItemList",
      name: site.katalogTitle || cms("Katalog Kendaraan Listrik", lang),
      numberOfItems: cars.length + motors.length,
      itemListElement: [...cars, ...motors].slice(0, 30).map((v: any, i: number) => ({
        "@type": "ListItem",
        position: i + 1,
        name: `${v.brand} ${v.name}`,
        url: `${siteOrigin(Astro.url)}${vehicleHref(v)}`,
      })),
    },
  ],
};
---

<Base
  title={seoTitle}
  description={seoDesc}
  keywords={site.seoKeywords}
  ogImage={site.seoOgImage || site.heroImage}
  site={site}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <SiteHeader site={site} active="beranda" />

  <section class={`hero${site.heroImage ? " has-image" : ""}`}>
    {site.heroImage ? (
      <div class="hero-bg" style={`background-image:url(${JSON.stringify(site.heroImage)})`} aria-hidden="true"></div>
    ) : (
      <div class="hero-glow" aria-hidden="true"></div>
    )}
    <div class="container hero-inner">
      {site.heroEyebrow ? <p class="hero-eyebrow enter">{site.heroEyebrow}</p> : null}
      <h1 class="hero-title enter">{heroTitle}</h1>
      <p class="hero-sub enter">{heroSub}</p>

      {/*
        Tanya EVKita: chatbot hero, terbuka untuk umum — formulirnya selalu
        dirender, tanpa wajib masuk. Di HP tampil vertikal seperti biasa;
        di desktop kotak memanjang selebar wadah hero (lihat .tanya-wide di
        global.css). Teks dinamis lewat atribut `data-*` (pola yang sama
        dengan SiteSearch): skrip klien tidak boleh tahu bahasa.
      */}
      <div
        class="tanya tanya-wide enter"
        id="tanyaEvkita"
        data-menjawab={t("pub.tanya.menjawab")}
        data-tahap={JSON.stringify([t("pub.tanya.tahap1"), t("pub.tanya.tahap2"), t("pub.tanya.tahap3")])}
        data-sisa-tpl={t("pub.tanya.sisa")}
        data-judul-katalog={t("pub.tanya.dariKatalog")}
        data-judul-ai={t("pub.tanya.jawabanAi")}
        data-kamu={t("pub.tanya.kamu")}
        data-salin={t("pub.tanya.salin")}
        data-tersalin={t("pub.tanya.tersalin")}
        data-lihat={t("pub.tanya.lihat")}
        data-jenis-mobil={t("pub.tanya.jenisMobil")}
        data-jenis-motor={t("pub.tanya.jenisMotor")}
        data-err-umum={t("pub.tanya.err.umum")}
        data-err-kuota-habis={t("pub.tanya.err.kuotaHabis")}
        data-err-terlalu-sering={t("pub.tanya.err.terlaluSering")}
        data-err-belum-siap={t("pub.tanya.err.belumSiap")}
        data-err-kosong={t("pub.tanya.err.kosong")}
        data-err-pendek={t("pub.tanya.err.pendek")}
        data-err-panjang={t("pub.tanya.err.panjang")}
        data-err-sibuk={t("pub.tanya.err.sibuk")}
        data-err-tidak-terhubung={t("pub.tanya.err.tidakTerhubung")}
        data-err-lambat={t("pub.tanya.err.lambat")}
        data-err-ditolak={t("pub.tanya.err.ditolak")}
        data-err-tanpa-jawaban={t("pub.tanya.err.tanpaJawaban")}
        data-err-jawaban-tidak-terbaca={t("pub.tanya.err.jawabanTidakTerbaca")}
        data-err-ai-bermasalah={t("pub.tanya.err.aiBermasalah")}
      >
        <div class="tanya-head">
          <span class="tanya-avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" focusable="false">
              <path fill="currentColor" d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12z" />
            </svg>
            <span class="tanya-dot"></span>
          </span>
          <span class="tanya-head-teks">
            <span class="tanya-title">{t("pub.tanya.title")} <em class="tanya-ai">AI</em></span>
            <span class="tanya-tagline">{t("pub.tanya.tagline")}</span>
          </span>
        </div>
        <form class="tanya-bar" id="tanyaForm" autocomplete="off">
          <input
            id="tanyaInput"
            class="tanya-input"
            type="text"
            maxlength="500"
            autocomplete="off"
            placeholder={t("pub.tanya.ph")}
            aria-label={t("pub.tanya.title")}
          />
          <button class="tanya-kirim" type="submit" id="tanyaKirim" aria-label={t("pub.tanya.kirim")}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M5 12h13m-6-6 6 6-6 6" />
            </svg>
          </button>
        </form>
        {/* Tiga contoh tampil dari server (tetap berfungsi tanpa JS); skrip
            mengacak seluruh `data-tanya-pool` lalu menggilirnya bertiga. */}
        <div class="tanya-chips" id="tanyaChips" data-tanya-pool={JSON.stringify(contohTanya)}>
          {contohTanya.slice(0, 3).map((q) => (
            <button type="button" data-tanya-contoh={q}>{q}</button>
          ))}
        </div>
        <div class="tanya-jawab" id="tanyaJawab" aria-live="polite" hidden></div>
        <p class="tanya-meta">
          <span class="tanya-sisa" id="tanyaSisa" hidden></span>
          <span class="tanya-catatan">{t("pub.tanya.catatan")}</span>
        </p>
      </div>

      {site.heroCtaText || site.heroCtaAltText ? (
        <div class="hero-cta enter">
          {site.heroCtaText ? (
            <a class="btn btn-primary btn-lg" href={safeUrl(site.heroCtaUrl) || "#daftar"}>{site.heroCtaText}</a>
          ) : null}
          {site.heroCtaAltText ? (
            <a class="btn btn-outline btn-lg" href={safeUrl(site.heroCtaAltUrl) || "#tentang"}>{site.heroCtaAltText}</a>
          ) : null}
        </div>
      ) : null}

      {site.showHeroStats ? <div class="hero-stats enter" id="heroStats"></div> : null}
    </div>
  </section>

  {/*
    Pita berita berjalan: tepat di bawah hero, di atas Jelajahi. Isinya
    sepuluh berita teratas yang sama dengan seksi berita — dirender server,
    jadi tanpa JavaScript pun tautannya tetap bisa diklik. Daftarnya digandakan
    dua kali supaya putarannya mulus; salinan kedua disembunyikan dari pembaca
    layar dan keyboard. Animasinya murni CSS: berhenti saat disentuh/difokus,
    dan mati total kalau pengunjung meminta gerak minimal.
  */}
  {beritaList.length ? (
    <div class="ticker" role="region" aria-label={t("pub.beritaTerkini")}>
      <div class="container ticker-inner">
        <span class="ticker-label">
          <span class="ticker-live" aria-hidden="true"></span>
