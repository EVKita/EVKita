          ) : null}
          <p class="vote-err" id="voteErr" hidden></p>
        </section>
      </aside>
    </div>
  </main>

  <!-- Panel bandingkan: kerangka statis, isinya dirender app.js -->
  <div class="compare-dock" id="compareDock" hidden>
    <div class="container compare-dock-inner">
      <div class="compare-dock-items" id="compareItems"></div>
      <div class="compare-dock-actions">
        <button type="button" class="btn btn-ghost btn-sm" id="compareClear">{t("pub.compare.clear")}</button>
        <button type="button" class="btn btn-primary btn-sm" id="compareOpen">{t("pub.card.compare")}</button>
      </div>
    </div>
  </div>

  <div class="compare-modal" id="compareModal" hidden>
    <div class="compare-modal-backdrop" data-compare-close></div>
    <div class="compare-modal-box" role="dialog" aria-modal="true" aria-labelledby="compareTitle">
      <div class="compare-modal-head">
        <h2 id="compareTitle">{t("pub.compare.title")}</h2>
        <div class="compare-modal-head-actions">
          {/* Modal ini tidak punya alamat sendiri; tautan inilah yang memberi
              perbandingan yang sedang dilihat sebuah URL untuk dibagikan.
              app.js yang mengisi href-nya setiap tabel dirender ulang. */}
          <a class="btn btn-ghost btn-sm" id="compareLink" href="/" hidden>{t("pub.compare.asPage")}</a>
          <button type="button" class="compare-close" data-compare-close aria-label={t("pub.compare.closeAria")}>✕</button>
        </div>
      </div>
      <div class="compare-modal-body" id="compareBody"></div>
    </div>
  </div>

  <SiteFooter site={site} />

  <script define:vars={{ carsLite, motorsLite, mediaAltLite }}>
    window.__EV_CARS__ = carsLite;
    window.__EV_MOTORS__ = motorsLite;
    window.__EV_MEDIA_ALT__ = mediaAltLite;
  </script>
  <script define:vars={{ votes }}>
    window.__EV_VOTES__ = votes;
  </script>
  <script src="../scripts/app.js"></script>
</Base>
