---
import { makePubT } from "../lib/i18n/pub.js";

/**
 * Label tombol ditentukan lewat CSS, bukan JavaScript: skrip tema berjalan di
 * <head> saat tombol ini belum ada di DOM, jadi kalau labelnya diatur JS ia
 * akan sempat berkedip salah. Kedua label dirender, CSS memilih yang sesuai
 * dengan `data-theme` di <html>.
 */
const t = makePubT(Astro.locals?.pubLang);
---
<button id="themeToggle" class="theme-toggle" type="button" aria-label={t("pub.theme.aria")}>
  <span class="th-to-dark"><span aria-hidden="true">☾</span> {t("pub.theme.gelap")}</span>
  <span class="th-to-light"><span aria-hidden="true">☀</span> {t("pub.theme.terang")}</span>
</button>
