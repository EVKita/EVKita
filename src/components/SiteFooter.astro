---
/**
 * Footer bersama. Setiap blok hanya muncul kalau datanya terisi — situs ini
 * dipasang sendiri oleh banyak orang dan sebagian besar field bersifat opsional.
 */
import { safeUrl } from "../lib/url.js";

interface Props {
  site: Record<string, any>;
  base?: string;
}

const { site, base = "" } = Astro.props;

const brand = site.brandText || "EVKita";
const suffix = site.brandSuffix || "";
const mark = (site.logoMark || brand.slice(0, 2) || "EV").slice(0, 3);

const quickLinks = [
  { label: "Beranda", href: base || "/" },
  { label: "Katalog", href: `${base}#daftar` },
  site.showSpklu ? { label: "SPKLU", href: `${base}#spklu` } : null,
  site.showBengkel ? { label: "Bengkel", href: `${base}#bengkel` } : null,
  site.showBerita ? { label: "Berita", href: `${base}#berita` } : null,
  site.showAbout ? { label: "Tentang", href: `${base}#tentang` } : null,
].filter(Boolean) as { label: string; href: string }[];

const socials = [
  { key: "socialInstagram", label: "Instagram", icon: "IG" },
  { key: "socialYoutube", label: "YouTube", icon: "YT" },
  { key: "socialTiktok", label: "TikTok", icon: "TT" },
  { key: "socialFacebook", label: "Facebook", icon: "FB" },
  { key: "socialX", label: "X", icon: "X" },
  { key: "socialWhatsapp", label: "WhatsApp", icon: "WA" },
]
  .map((s) => ({ ...s, url: safeUrl(site[s.key]) }))
  .filter((s) => s.url);

const contacts = [
  site.contactEmail ? { label: "Email", value: site.contactEmail, href: `mailto:${site.contactEmail}` } : null,
  site.contactPhone ? { label: "Telepon", value: site.contactPhone, href: `tel:${String(site.contactPhone).replace(/[^\d+]/g, "")}` } : null,
  site.contactAddress ? { label: "Alamat", value: site.contactAddress, href: "" } : null,
].filter(Boolean) as { label: string; value: string; href: string }[];

const year = new Date().getFullYear();
---

<footer class="site-footer" id="sumber">
  <div class="container footer-grid">
    <div class="footer-col footer-col-brand">
      <div class="footer-brand">
        {site.logoImage ? (
          <img class="logo-img" src={safeUrl(site.logoImage)} alt="" width="40" height="40" />
        ) : (
          <span class="logo-mark">{mark}</span>
        )}
        <span class="logo-text">{brand}{suffix ? <em>{suffix}</em> : null}</span>
      </div>
      {site.footerDesc ? <p class="footer-about">{site.footerDesc}</p> : null}
      {socials.length ? (
        <div class="social-row">
          {socials.map((s) => (
            <a class="social-link" href={s.url} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
              <span aria-hidden="true">{s.icon}</span>
            </a>
          ))}
        </div>
      ) : null}
    </div>

    <div class="footer-col">
      <h4>Jelajahi</h4>
      <ul>
        {quickLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    {contacts.length ? (
      <div class="footer-col">
        <h4>Kontak</h4>
        <ul class="footer-contact">
          {contacts.map((c) => (
            <li>
              <span class="footer-contact-label">{c.label}</span>
              {c.href ? (
                <a href={c.href}>{c.value}</a>
              ) : (
                <span class="footer-contact-value">{c.value}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    ) : null}

    {site.footerSourceText || site.footerNote ? (
      <div class="footer-col">
        {site.footerSourceText ? (
          <>
            <h4>Sumber Data</h4>
            <ul>
              <li>
                {site.footerSourceUrl ? (
                  <a href={safeUrl(site.footerSourceUrl)} target="_blank" rel="noopener">{site.footerSourceText}</a>
                ) : (
                  <span class="footer-about">{site.footerSourceText}</span>
                )}
              </li>
            </ul>
          </>
        ) : null}
        {site.footerNote ? <p class="footer-about footer-note">{site.footerNote}</p> : null}
      </div>
    ) : null}
  </div>

  <div class="container copyright">
    <span>© {year} {brand}{site.footerTitle ? ` — ${site.footerTitle}` : ""}.</span>
    <span>Harga &amp; spesifikasi dapat berubah sewaktu-waktu.</span>
  </div>
</footer>

<button class="back-to-top" id="backToTop" type="button" aria-label="Kembali ke atas" hidden>
  <span aria-hidden="true">↑</span>
</button>

<script>
  (function () {
    const btn = document.getElementById("backToTop");
    if (!btn) return;
    const onScroll = () => {
      btn.hidden = window.scrollY < 500;
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    btn.addEventListener("click", () => {
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
    });
  })();
</script>
