---
import { bacaIntegrasi } from "../lib/integrasi-simpan";
import { SESSION_COOKIE, sessionUserId } from "../lib/auth";
import { MEMBER_COOKIE } from "../lib/member.js";
import { makePubT } from "../lib/i18n/pub.js";
import { hostClerk } from "../lib/integrasi.js";

interface Props {
  lang?: string;
}

const { lang = Astro.locals?.pubLang || "id" } = Astro.props;

/**
 * Pintu masuk pengunjung: popup login pada klik kedua.
 *
 * Tidak dirender bila pemilik sedang masuk panel atau pengunjung sudah punya
 * sesi anggota yang sah — keduanya sudah dikenal, tidak perlu ditanya lagi.
 * Markupnya selalu `hidden`: skrip kecil di Base.astro yang menghitung klik
 * dan membukanya. Tanpa JavaScript ia tidak pernah ada.
 *
 * Masuk email + kata sandi dicatat di peramban pengunjung sendiri (belum ada
 * akun anggota di server — belum ada alur pendaftaran). Ini hanya cadangan
 * selama Clerk belum dipasang; login Google lewat Client ID sendiri sudah
 * dibuang, karena Google kini ditangani Clerk.
 *
 * CLERK. Begitu publishable key Clerk terisi di Admin → Integrasi, seluruh
 * jalur di atas digantikan: daftar, masuk, dan Google ditangani Clerk, dan
 * akunnya disimpan di Clerk. Popupnya tidak lagi menunggu klik kedua — ia
 * muncul sendiri ±8 detik setelah pengunjung tiba (lihat `src/scripts/akun.js`),
 * hanya bagi yang belum masuk. Keadaan "sudah masuk" baru diketahui clerk-js di
 * peramban, jadi markupnya selalu dirender dan skrip itulah yang memutuskan.
 */
const admin = !!Astro.cookies.get(SESSION_COOKIE)?.value;
const anggota = !!sessionUserId(Astro.cookies.get(MEMBER_COOKIE)?.value);

const t = makePubT(lang);
const cfg = bacaIntegrasi();
const clerkKey = cfg.clerkKey || "";
const clerkHost = hostClerk(clerkKey);
const pakaiClerk = !!clerkHost;
const tampil = !admin && !anggota && !pakaiClerk;
const tahun = new Date().getFullYear();
---

{pakaiClerk && !admin ? (
  <div
    class="member akun"
    id="akunGate"
    hidden
    data-clerk-key={clerkKey}
    data-clerk-host={clerkHost}
  >
    <div class="member-backdrop" data-akun-nanti aria-hidden="true"></div>
    <div class="member-box akun-box" role="dialog" aria-modal="true" aria-labelledby="akunTitle" aria-describedby="akunSub">
      <button class="member-x" type="button" data-akun-nanti aria-label={t("pub.member.close")}>✕</button>
      <p class="akun-eyebrow">{t("pub.akun.eyebrow")}</p>
      <h2 class="member-title akun-title" id="akunTitle">{t("pub.akun.title")}</h2>
      <p class="akun-sub" id="akunSub">{t("pub.akun.sub")}</p>
      <button class="member-google akun-google" type="button" data-akun-daftar>
        <span class="member-g" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
            <path fill="#4285F4" d="M23.5 12.3c0-.9-.1-1.5-.3-2.3H12v4.5h6.5c-.1 1.1-.8 2.7-2.4 3.8l-.1.3 3.5 2.7.2.1c2.2-2 3.8-5 3.8-9.1z" />
            <path fill="#34A853" d="M12 24c3.2 0 6-1.1 7.9-2.9l-3.8-2.9c-1 .7-2.4 1.2-4.1 1.2-3.2 0-5.9-2.1-6.8-5l-.3.1-2.9 2.2-.1.3C3.9 21.3 7.7 24 12 24z" />
            <path fill="#FBBC05" d="M5.2 14.4c-.2-.7-.4-1.5-.4-2.4s.1-1.7.4-2.4l-.1-.3-2.9-2.2-.3.1C.7 8.9 0 10.4 0 12s.7 3.1 1.9 4.8l3.3-2.4z" />
            <path fill="#EA4335" d="M12 4.7c1.8 0 3 .8 3.7 1.4l3.3-3.2C17.9 1.1 15.2 0 12 0 7.7 0 3.9 2.7 1.9 6.9l3.3 2.6C6.1 6.8 8.8 4.7 12 4.7z" />
          </svg>
        </span>
        <span>{t("pub.akun.daftar")}</span>
      </button>
      <button class="member-login akun-masuk" type="button" data-akun-masuk>{t("pub.akun.masuk")}</button>
      <p class="member-err akun-err" data-akun-err hidden>{t("pub.member.errNet")}</p>
      <button class="akun-nanti" type="button" data-akun-nanti>{t("pub.akun.nanti")}</button>
      <p class="member-foot">{t("pub.member.rights", { year: tahun })}</p>
    </div>
  </div>
) : null}

{tampil ? (
  <div
    class="member"
    id="memberGate"
    hidden
    data-err-email={t("pub.member.badEmail")}
    data-err-pass={t("pub.member.shortPass")}
    data-err-net={t("pub.member.errNet")}
  >
    <div class="member-backdrop" data-member-tutup aria-hidden="true"></div>
    <div class="member-box" role="dialog" aria-modal="true" aria-labelledby="memberTitle">
      <button class="member-x" id="memberX" type="button" aria-label={t("pub.member.close")}>✕</button>
      <h2 class="member-title" id="memberTitle">{t("pub.member.title")}</h2>
      <form class="member-form" id="memberForm" novalidate>
        <label class="member-field">
          <span>{t("pub.member.email")}</span>
          <input type="email" name="email" autocomplete="email" />
        </label>
        <label class="member-field">
          <span>{t("pub.member.password")}</span>
          <input type="password" name="password" autocomplete="current-password" />
        </label>
        <p class="member-err" id="memberErr" hidden></p>
        <label class="member-remember">
          <input type="checkbox" name="remember" />
          <span>{t("pub.member.remember")}</span>
        </label>
        <button class="member-login" type="submit">{t("pub.member.login")}</button>
      </form>
      <p class="member-foot">{t("pub.member.rights", { year: tahun })}</p>
    </div>
  </div>
) : null}

<script>
  import { pasangAkun } from "../scripts/akun.js";
  pasangAkun();
</script>
